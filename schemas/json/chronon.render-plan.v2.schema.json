{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronon3d.dev/schemas/chronon.render-plan.v2.schema.json",
  "title": "Chronon3D Render Plan V2",
  "description": "Primitive execution contract. Callers must lower editorial semantics into concrete assets, geometry, style and animation tracks before invoking Chronon.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "chromaticity_xy": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "easing": {
      "description": "Easing functions accepted by the render-plan compiler. The compiler rejects any other value at plan-compile time, so the schema closes the same set to fail validation early.",
      "enum": [
        "linear", "in_quad", "out_quad", "in_out_quad",
        "in_cubic", "out_cubic", "in_out_cubic",
        "in_expo", "out_expo", "in_out_expo",
        "in_sine", "out_sine", "in_out_sine",
        "in_back", "out_back", "in_out_back",
        "in_elastic", "out_elastic", "in_out_elastic",
        "in_bounce", "out_bounce", "in_out_bounce",
        "smoothstep", "hold", "bezier"
      ]
    },
    "bezier_curve": {
      "description": "Cubic timing curve [x1, y1, x2, y2]. X handles must be monotonic in [0, 1]; Y handles allow bounded overshoot.",
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "number", "minimum": -10, "maximum": 10 }
    },
    "bezier_easing_contract": {
      "allOf": [
        { "if": { "required": ["easing"], "properties": { "easing": { "const": "bezier" } } }, "then": { "required": ["bezier_curve"] } },
        { "if": { "required": ["bezier_curve"] }, "then": { "properties": { "easing": { "const": "bezier" } }, "required": ["easing"] } }
      ]
    },
    "keyframe_list": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["frame", "value"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "value": {
            "oneOf": [
              { "type": "number" },
              { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "number" } }
            ]
          }
        }
      }
    },
    "selector_track": {
      "description": "Keyframe track for a text-selector bound (start/end/offset/amount). The selector's meaning comes from its structural position, so 'property' is inert and optional here: it is decoded for backward compatibility but never influences selector evaluation.",
      "type": "object", "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }],
      "required": ["keyframes"],
      "properties": {
        "property": {
          "type": "string",
          "description": "Accepted for backward compatibility; selector behavior is defined by the field position (start/end/offset/amount), not by this value."
        },
        "easing": { "$ref": "#/$defs/easing" },
        "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
        "keyframes": { "$ref": "#/$defs/keyframe_list" }
      }
    },
    "animator_property_track": {
      "description": "Property applied by a text animator. Numeric properties are animated tracks; fill_color takes exactly one RGBA [0,1] keyframe value and is revealed by the selector amount.",
      "type": "object", "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }],
      "required": ["property", "keyframes"],
      "properties": {
        "property": {
          "enum": ["position", "position_x", "position_y", "scale", "scale_x", "scale_y", "opacity", "blur", "tracking", "fill_color"]
        },
        "easing": { "$ref": "#/$defs/easing" },
        "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
        "keyframes": { "$ref": "#/$defs/keyframe_list" }
      }
    },
    "text_selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "unit": { "enum": ["glyph", "grapheme", "character", "word", "line"] },
        "shape": { "enum": ["square", "ramp_up", "ramp_down", "triangle", "round", "smooth"] },
        "order": { "enum": ["forward", "reverse", "from_center", "to_center", "random"] },
        "combine": { "enum": ["replace", "add", "subtract", "intersect", "min", "max"] },
        "start": { "$ref": "#/$defs/selector_track" },
        "end": { "$ref": "#/$defs/selector_track" },
        "offset": { "$ref": "#/$defs/selector_track" },
        "amount": { "$ref": "#/$defs/selector_track" },
        "exclude_spaces": { "type": "boolean" },
        "randomize_order": { "type": "boolean" },
        "random_seed": { "type": "integer", "minimum": 0 },
        "semantic_id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "text_animator": {
      "type": "object", "additionalProperties": false,
      "required": ["selectors", "properties"],
      "properties": {
        "id": { "type": "string" },
        "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text_selector" } },
        "properties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/animator_property_track" } }
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "enum": ["perspective", "orthographic"] },
        "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "rotation_deg": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "fov_deg": { "type": "number", "minimum": 10, "maximum": 120 },
        "near": { "type": "number", "exclusiveMinimum": 0 },
        "far": { "type": "number", "exclusiveMinimum": 0 },
        "zoom": { "type": "number", "exclusiveMinimum": 0 },
        "dof": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "focus_distance": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000000 },
            "aperture": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_blur": { "type": "number", "minimum": 0, "maximum": 256 }
          }
        }
      }
    },
    "camera_track": {
      "type": "object", "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }],
      "required": ["property", "keyframes"],
      "properties": {
          "property": { "enum": ["camera_position_x", "camera_position_y", "camera_position_z", "camera_rotation_x", "camera_rotation_y", "camera_rotation_z", "camera_fov_deg", "camera_zoom", "camera_focus_distance", "camera_aperture", "camera_max_blur"] },
        "easing": { "$ref": "#/$defs/easing" },
        "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
        "keyframes": { "$ref": "#/$defs/keyframe_list" }
      }
    },
    "camera_animation": {
      "type": "object", "additionalProperties": false,
      "required": ["tracks"],
      "properties": {
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/camera_track" } }
      }
    }
  },
  "required": ["schema", "version", "canvas", "layers", "output"],
  "properties": {
    "schema": { "const": "chronon.render-plan.v2" },
    "version": { "const": 2 },
    "job_id": { "type": "string", "minLength": 1 },
    "color_management": {
      "type": "object", "additionalProperties": false,
      "required": ["ocio_config", "working_space"],
      "properties": {
        "ocio_config": { "type": "string", "minLength": 1 },
        "working_space": { "type": "string", "minLength": 1 },
        "video_input_space": { "type": "string", "minLength": 1 },
        "output_display": { "type": "string", "minLength": 1 },
        "output_view": { "type": "string", "minLength": 1 }
      }
    },
    "camera": { "$ref": "#/$defs/camera" },
    "camera_animation": { "$ref": "#/$defs/camera_animation" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps_num", "fps_den", "duration_frames"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4320 },
        "fps_num": { "type": "integer", "minimum": 1, "maximum": 240000 },
        "fps_den": { "type": "integer", "minimum": 1, "maximum": 1001 },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["image", "video", "text", "color", "particles", "light", "mesh"] },
          "asset": { "type": "string", "minLength": 1 },
          "input_color_space": { "enum": ["srgb", "linearsrgb", "rec709", "displayp3"] },
          "ocio_input_space": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "maxLength": 1048576 },
          "size": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "number" }
          },
          "color": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number" }
          },
          "particle_emitter": {
            "type": "object", "additionalProperties": false,
            "required": ["count", "seed", "emitter_size", "velocity_min", "velocity_max", "lifetime", "size"],
            "properties": {
              "count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "emitter_size": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
              "velocity_min": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "velocity_max": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "lifetime": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
              "size": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
              "blend_mode": { "enum": ["normal", "add", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion", "soft_light", "hard_light", "color_dodge", "color_burn", "subtract", "divide", "vivid_light", "pin_light", "linear_light", "hue", "saturation", "color", "luminosity"] },
              "gravity": { "type": "number" },
              "turbulence": { "type": "number", "minimum": 0 },
              "color_ramp": {
                "type": "array", "minItems": 2, "maxItems": 256,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["position", "color"],
                  "properties": {
                    "position": { "type": "number", "minimum": 0, "maximum": 1 },
                    "color": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
                  }
                }
              }
            }
          },
          "light": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
              "intensity": { "type": "number", "minimum": 0, "maximum": 16 },
              "kind": { "type": "string", "enum": ["radial", "point", "spot", "directional"] },
              "direction": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
              "range": { "type": "number", "minimum": 0, "maximum": 1000000 },
              "decay": { "type": "number", "minimum": 0, "maximum": 8 },
              "angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.141592653589793 },
              "penumbra": { "type": "number", "minimum": 0, "maximum": 1 },
              "cast_shadow": { "type": "boolean" },
              "shadow_radius": { "type": "number", "minimum": 0, "maximum": 512 },
              "shadow_bias": { "type": "number", "minimum": 0, "maximum": 16 }
            }
          },
          "inline_mesh": {
            "type": "object", "additionalProperties": false,
            "required": ["vertices", "indices"],
            "properties": {
              "vertices": {
                "type": "array", "minItems": 3, "maxItems": 250000,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["position"],
                  "properties": {
                    "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 } },
                    "normal": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": -1, "maximum": 1 } },
                    "uv": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -1000000, "maximum": 1000000 } }
                  }
                }
              },
              "indices": { "type": "array", "minItems": 3, "maxItems": 750000, "items": { "type": "integer", "minimum": 0, "maximum": 249999 } }
            }
          },
          "position": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "number" }
          },
          "scale": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "number" }
          },
          "rotation": {
            "description": "Euler angles in degrees in [x, y, z] order. Animation-track rotation values use the same degree unit.",
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": { "type": "number" }
          },
          "enable_3d": { "type": "boolean" },
          "screen_space": { "type": "boolean" },
          "depth_role": { "enum": ["far_background", "background", "midground", "subject", "atmosphere", "foreground", "overlay"] },
          "depth_offset": { "type": "number" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "fit": { "enum": ["cover", "contain", "stretch", "none"] },
          "crop": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "flip_x": { "type": "boolean" },
              "origin": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
              "size": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } }
            }
          },
          "radius": { "type": "number", "minimum": 0 },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "font": { "type": "string", "minLength": 1 },
              "font_size": { "type": "number", "exclusiveMinimum": 0 },
              "fill": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "fit_mode": { "enum": ["none", "shrink_only", "grow_and_shrink"] },
              "min_font_size": { "type": "number", "exclusiveMinimum": 0 },
              "max_font_size": { "type": "number", "exclusiveMinimum": 0 },
              "stroke": {
                "type": "object", "additionalProperties": false,
                "required": ["color", "width"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "width": { "type": "number", "minimum": 0 },
                  "dash_array": { "type": "array", "items": { "type": "number", "minimum": 0 } },
                  "dash_offset": { "type": "number" }
                }
              },
              "shadow": {
                "type": "object", "additionalProperties": false,
                "required": ["color"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "blur": { "type": "number", "minimum": 0 },
                  "offset": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              },
              "shadows": {
                "type": "array", "minItems": 1, "maxItems": 3,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["color", "offset"],
                  "properties": {
                    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                    "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                    "blur": { "type": "number", "minimum": 0 },
                    "offset": { "type": "array", "minItems": 2, "maxItems": 2,
                                "items": { "type": "number" } }
                  }
                }
              },
              "glow": {
                "description": "One Gaussian halo controlled by radius, intensity and color. Deprecated legacy fields are accepted only for V2 compatibility and ignored by the decoder/renderer.",
                "type": "object", "additionalProperties": false,
                "required": ["radius", "intensity"],
                "properties": {
                  "radius": { "type": "number", "minimum": 0 },
                  "intensity": { "type": "number", "minimum": 0 },
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "threshold": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "falloff": { "type": "number", "minimum": 1, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "core_strength": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "aura_strength": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "bloom_strength": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Bloom is a separate effect." },
                  "high_quality": { "type": "boolean", "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; there is no Glow quality selector." }
                }
              },
              "background": {
                "type": "object", "additionalProperties": false,
                "required": ["color"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "radius": { "type": "number", "minimum": 0 },
                  "padding": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              }
            },
            "not": { "required": ["shadow", "shadows"] }
          },
          "animation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tracks"],
            "properties": {
              "tracks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }],
                  "required": ["property", "keyframes"],
                  "properties": {
                    "property": {
                      "description": "Layer rotation components and vectors are specified in degrees.",
                      "enum": [
                        "position", "position_x", "position_y", "position_z",
                        "scale", "scale_x", "scale_y", "scale_z",
                        "rotation", "rotation_x", "rotation_y", "rotation_z",
                        "opacity", "blur", "stroke_dash_offset",
                        "light_intensity", "light_color"
                      ]
                    },
                    "easing": {
                      "enum": [
                        "linear", "in_quad", "out_quad", "in_out_quad",
                        "in_cubic", "out_cubic", "in_out_cubic",
                        "in_expo", "out_expo", "in_out_expo",
                        "in_sine", "out_sine", "in_out_sine",
                        "in_back", "out_back", "in_out_back",
                        "in_elastic", "out_elastic", "in_out_elastic",
                        "in_bounce", "out_bounce", "in_out_bounce",
                        "smoothstep", "hold", "bezier"
                      ]
                    },
                    "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
                    "keyframes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["frame", "value"],
                        "properties": {
                          "frame": { "type": "integer", "minimum": 0 },
                          "value": {
                            "oneOf": [
                              { "type": "number" },
                              {
                                "type": "array", "minItems": 1, "maxItems": 4,
                                "items": { "type": "number" }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "text_animators": {
            "type": "array", "items": { "$ref": "#/$defs/text_animator" }
          },
          "blend_mode": {
            "enum": ["normal", "add", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion", "soft_light", "hard_light", "color_dodge", "color_burn", "subtract", "divide", "vivid_light", "pin_light", "linear_light", "hue", "saturation", "color", "luminosity"]
          },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "loop": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
            "then": {
              "required": ["text", "style"],
              "properties": {
                "style": { "required": ["font", "font_size", "fill"] }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
            "then": { "required": ["asset", "size"] }
          },
          {
            "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
            "then": { "required": ["source"] }
          },
          {
            "if": { "properties": { "type": { "const": "color" } }, "required": ["type"] },
            "then": { "required": ["color"] }
          },
          {
            "if": { "properties": { "type": { "const": "particles" } }, "required": ["type"] },
            "then": { "required": ["particle_emitter"] }
          },          { "if": { "properties": { "type": { "const": "light" } }, "required": ["type"] },
            "then": { "required": ["light"] }
          },
          { "if": { "properties": { "type": { "const": "mesh" } }, "required": ["type"] },
            "then": { "required": ["inline_mesh"], "not": { "anyOf": [{ "required": ["asset"] }, { "required": ["source"] }] } }
          },
          { "if": { "required": ["inline_mesh"] },
            "then": { "properties": { "type": { "const": "mesh" } }, "required": ["type"] }
          }
        ]
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": { "max_temporal_pixels": { "type": "integer", "minimum": 1 } }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "color_space": { "enum": ["srgb", "rec709", "linearsrgb", "pq", "hlg"] },
        "reference_white_nits": {
          "description": "Absolute luminance in nits assigned to linear RGB (1,1,1); scales PQ/HLG encoding and is written as OpenEXR whiteLuminance for EXR output.",
          "type": "number", "exclusiveMinimum": 0, "maximum": 10000
        },
        "hdr_mastering_metadata": {
          "type": "object", "additionalProperties": false,
          "required": ["display_primaries", "white_point", "min_luminance_nits", "max_luminance_nits"],
          "properties": {
            "display_primaries": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": { "$ref": "#/$defs/chromaticity_xy" }
            },
            "white_point": { "$ref": "#/$defs/chromaticity_xy" },
            "min_luminance_nits": { "type": "number", "minimum": 0, "maximum": 10000 },
            "max_luminance_nits": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
            "content_light": {
              "type": "object", "additionalProperties": false,
              "required": ["max_cll_nits", "max_fall_nits"],
              "properties": {
                "max_cll_nits": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "max_fall_nits": { "type": "integer", "minimum": 1, "maximum": 10000 }
              }
            }
          }
        },
        "format": { "enum": ["png", "png_sequence", "gif", "mp4", "mkv", "webm"] },
        "codec": { "enum": ["auto", "h264", "h265", "vp9", "av1"] },
        "profile_id": { "type": "string", "minLength": 1 },
        "rate_control": { "enum": ["crf", "qp", "bitrate"] },
        "bitrate": { "type": "integer", "minimum": 1 },
        "crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "qp": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    }
  }
}
