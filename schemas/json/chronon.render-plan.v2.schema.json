{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronon3d.dev/schemas/chronon.render-plan.v2.schema.json",
  "title": "Chronon3D Render Plan V2",
  "description": "Primitive execution contract. Callers must lower editorial semantics into concrete assets, geometry, style and animation tracks before invoking Chronon.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "easing": {
      "description": "Easing functions accepted by the render-plan compiler. The compiler rejects any other value at plan-compile time, so the schema closes the same set to fail validation early.",
      "enum": [
        "linear", "in_quad", "out_quad", "in_out_quad",
        "in_cubic", "out_cubic", "in_out_cubic",
        "in_expo", "out_expo", "in_out_expo",
        "in_sine", "out_sine", "in_out_sine",
        "in_back", "out_back", "in_out_back",
        "in_elastic", "out_elastic", "in_out_elastic",
        "in_bounce", "out_bounce", "in_out_bounce",
        "smoothstep", "hold"
      ]
    },
    "keyframe_list": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["frame", "value"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "value": {
            "oneOf": [
              { "type": "number" },
              { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "number" } }
            ]
          }
        }
      }
    },
    "selector_track": {
      "description": "Keyframe track for a text-selector bound (start/end/offset/amount). The selector's meaning comes from its structural position, so 'property' is inert and optional here: it is decoded for backward compatibility but never influences selector evaluation.",
      "type": "object", "additionalProperties": false,
      "required": ["keyframes"],
      "properties": {
        "property": {
          "type": "string",
          "description": "Accepted for backward compatibility; selector behavior is defined by the field position (start/end/offset/amount), not by this value."
        },
        "easing": { "$ref": "#/$defs/easing" },
        "keyframes": { "$ref": "#/$defs/keyframe_list" }
      }
    },
    "animator_property_track": {
      "description": "Animated property applied by a text animator. 'property' selects the engine property and must be one the compiler implements; any other value fails plan compilation.",
      "type": "object", "additionalProperties": false,
      "required": ["property", "keyframes"],
      "properties": {
        "property": {
          "enum": ["position", "position_x", "position_y", "scale", "scale_x", "scale_y", "opacity", "blur", "tracking"]
        },
        "easing": { "$ref": "#/$defs/easing" },
        "keyframes": { "$ref": "#/$defs/keyframe_list" }
      }
    },
    "text_selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "unit": { "enum": ["glyph", "grapheme", "character", "word", "line"] },
        "shape": { "enum": ["square", "ramp_up", "ramp_down", "triangle", "round", "smooth"] },
        "order": { "enum": ["forward", "reverse", "from_center", "to_center", "random"] },
        "combine": { "enum": ["replace", "add", "subtract", "intersect", "min", "max"] },
        "start": { "$ref": "#/$defs/selector_track" },
        "end": { "$ref": "#/$defs/selector_track" },
        "offset": { "$ref": "#/$defs/selector_track" },
        "amount": { "$ref": "#/$defs/selector_track" },
        "exclude_spaces": { "type": "boolean" },
        "randomize_order": { "type": "boolean" },
        "random_seed": { "type": "integer", "minimum": 0 }
      }
    },
    "text_animator": {
      "type": "object", "additionalProperties": false,
      "required": ["selectors", "properties"],
      "properties": {
        "id": { "type": "string" },
        "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text_selector" } },
        "properties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/animator_property_track" } }
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "enum": ["perspective", "orthographic"] },
        "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "rotation_deg": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "fov_deg": { "type": "number", "minimum": 10, "maximum": 120 },
        "near": { "type": "number", "exclusiveMinimum": 0 },
        "far": { "type": "number", "exclusiveMinimum": 0 },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "camera_track": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "keyframes"],
      "properties": {
        "property": { "enum": ["camera_position_x", "camera_position_y", "camera_position_z", "camera_rotation_x", "camera_rotation_y", "camera_rotation_z", "camera_fov_deg", "camera_zoom"] },
        "easing": { "$ref": "#/$defs/easing" },
        "keyframes": { "$ref": "#/$defs/keyframe_list" }
      }
    },
    "camera_animation": {
      "type": "object", "additionalProperties": false,
      "required": ["tracks"],
      "properties": {
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/camera_track" } }
      }
    }
  },
  "required": ["schema", "version", "canvas", "layers", "output"],
  "properties": {
    "schema": { "const": "chronon.render-plan.v2" },
    "version": { "const": 2 },
    "job_id": { "type": "string", "minLength": 1 },
    "camera": { "$ref": "#/$defs/camera" },
    "camera_animation": { "$ref": "#/$defs/camera_animation" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps_num", "fps_den", "duration_frames"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4320 },
        "fps_num": { "type": "integer", "minimum": 1, "maximum": 240000 },
        "fps_den": { "type": "integer", "minimum": 1, "maximum": 1001 },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["image", "video", "text", "color"] },
          "asset": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "maxLength": 1048576 },
          "size": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "number" }
          },
          "color": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number" }
          },
          "position": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "number" }
          },
          "scale": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "number" }
          },
          "rotation": {
            "description": "Euler angles in degrees in [x, y, z] order. Animation-track rotation values use the same degree unit.",
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": { "type": "number" }
          },
          "enable_3d": { "type": "boolean" },
          "screen_space": { "type": "boolean" },
          "depth_role": { "enum": ["far_background", "background", "midground", "subject", "atmosphere", "foreground", "overlay"] },
          "depth_offset": { "type": "number" },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "fit": { "enum": ["cover", "contain", "stretch", "none"] },
          "radius": { "type": "number", "minimum": 0 },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "font": { "type": "string", "minLength": 1 },
              "font_size": { "type": "number", "exclusiveMinimum": 0 },
              "fill": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "stroke": {
                "type": "object", "additionalProperties": false,
                "required": ["color", "width"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "width": { "type": "number", "minimum": 0 }
                }
              },
              "shadow": {
                "type": "object", "additionalProperties": false,
                "required": ["color"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "blur": { "type": "number", "minimum": 0 },
                  "offset": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              },
              "glow": {
                "description": "One Gaussian halo controlled by radius, intensity and color. Deprecated legacy fields are accepted only for V2 compatibility and ignored by the decoder/renderer.",
                "type": "object", "additionalProperties": false,
                "required": ["radius", "intensity"],
                "properties": {
                  "radius": { "type": "number", "minimum": 0 },
                  "intensity": { "type": "number", "minimum": 0 },
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "threshold": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "falloff": { "type": "number", "minimum": 1, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "core_strength": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "aura_strength": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Glow only uses radius, intensity and color." },
                  "bloom_strength": { "type": "number", "minimum": 0, "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; Bloom is a separate effect." },
                  "high_quality": { "type": "boolean", "deprecated": true, "description": "Legacy render-plan field. Accepted for V2 compatibility and ignored; there is no Glow quality selector." }
                }
              },
              "background": {
                "type": "object", "additionalProperties": false,
                "required": ["color"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "radius": { "type": "number", "minimum": 0 },
                  "padding": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              }
            }
          },
          "animation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tracks"],
            "properties": {
              "tracks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["property", "keyframes"],
                  "properties": {
                    "property": {
                      "description": "Layer rotation components and vectors are specified in degrees.",
                      "enum": [
                        "position", "position_x", "position_y", "position_z",
                        "scale", "scale_x", "scale_y", "scale_z",
                        "rotation", "rotation_x", "rotation_y", "rotation_z",
                        "opacity", "blur"
                      ]
                    },
                    "easing": {
                      "enum": [
                        "linear", "in_quad", "out_quad", "in_out_quad",
                        "in_cubic", "out_cubic", "in_out_cubic",
                        "in_expo", "out_expo", "in_out_expo",
                        "in_sine", "out_sine", "in_out_sine",
                        "in_back", "out_back", "in_out_back",
                        "in_elastic", "out_elastic", "in_out_elastic",
                        "in_bounce", "out_bounce", "in_out_bounce",
                        "smoothstep", "hold"
                      ]
                    },
                    "keyframes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["frame", "value"],
                        "properties": {
                          "frame": { "type": "integer", "minimum": 0 },
                          "value": {
                            "oneOf": [
                              { "type": "number" },
                              {
                                "type": "array", "minItems": 1, "maxItems": 4,
                                "items": { "type": "number" }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "text_animators": {
            "type": "array", "items": { "$ref": "#/$defs/text_animator" }
          },
          "blend_mode": {
            "enum": ["normal", "add", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion", "soft_light", "hard_light", "color_dodge", "color_burn"]
          },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "loop": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
            "then": {
              "required": ["text", "style"],
              "properties": {
                "style": { "required": ["font", "font_size", "fill"] }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
            "then": { "required": ["asset", "size"] }
          },
          {
            "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
            "then": { "required": ["source"] }
          },
          {
            "if": { "properties": { "type": { "const": "color" } }, "required": ["type"] },
            "then": { "required": ["color"] }
          }
        ]
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": { "max_temporal_pixels": { "type": "integer", "minimum": 1 } }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["png", "mp4", "mkv", "webm"] },
        "codec": { "enum": ["auto", "h264", "h265", "vp9", "av1"] },
        "profile_id": { "type": "string", "minLength": 1 },
        "rate_control": { "enum": ["crf", "qp", "bitrate"] },
        "bitrate": { "type": "integer", "minimum": 1 },
        "crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "qp": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    }
  }
}
