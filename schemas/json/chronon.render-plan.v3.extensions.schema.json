{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronon3d.dev/schemas/chronon.render-plan.v3.extensions.schema.json",
  "title": "Chronon3D Render Plan V3 Shape and Gradient Extensions",
  "description": "Strict V3 extension contract. Existing V2 fields are validated against the unchanged V2 schema after extension fields are projected out.",
  "$defs": {
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "duration_frames"],
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "kind": { "enum": ["none", "crossfade", "slide", "wipe_linear", "smooth_wipe", "circle_iris", "flash", "procedural_remotion", "remotion"] },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "delay_frames": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "easing": { "$ref": "#/$defs/easing" },
        "direction": { "enum": ["left", "right", "up", "down", "in", "out"] },
        "params": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "distance": { "type": "number", "minimum": 0, "maximum": 4 },
            "feather": { "type": "number", "minimum": 0, "maximum": 1 },
            "center": { "$ref": "#/$defs/point" },
            "color": { "$ref": "#/$defs/rgba" },
            "seed": { "type": "number" },
            "inner_color": { "$ref": "#/$defs/rgba" },
            "mid_color": { "$ref": "#/$defs/rgba" },
            "outer_color": { "$ref": "#/$defs/rgba" },
            "speed": { "type": "number", "exclusiveMinimum": 0 },
            "remotion_direction": { "type": "number" },
            "angle": { "type": "number" }
          }
        }
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["clips"],
      "properties": {
        "master_gain_db": {"type": "number"},
        "duck_amount_db": {"type": "number"},
        "duck_attack_ms": {"type": "number", "minimum": 0},
        "duck_release_ms": {"type": "number", "minimum": 0},
        "clips": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "asset"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 256},
              "asset": {"type": "string", "minLength": 1, "maxLength": 4096},
              "clip_in": {"type": "integer", "minimum": 0, "maximum": 1000000},
              "clip_out": {"type": "integer", "minimum": 0, "maximum": 1000000},
              "start": {"type": "integer", "minimum": 0, "maximum": 1000000},
              "gain_db": {"type": "number"},
              "muted": {"type": "boolean"},
              "role": {"enum": ["music", "voice", "sfx"]},
              "gain": {
                "type": "object", "additionalProperties": false,
                "required": ["keyframes"],
                "properties": {
                  "property": {"const": "gain_db"},
                  "easing": {"$ref": "#/$defs/easing"},
                  "bezier_curve": {"$ref": "#/$defs/bezier_curve"},
                  "keyframes": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["frame", "value"],
                      "properties": {
                        "frame": {"type": "integer", "minimum": 0, "maximum": 1000000},
                        "value": {"type": "number"},
                        "interpolation": { "enum": ["linear", "hold", "bezier"] },
                        "easing": { "$ref": "#/$defs/easing" },
                        "bezier_curve": { "$ref": "#/$defs/bezier_curve" }
                      }
                    }
                  }
                },
                "allOf": [{"$ref": "#/$defs/bezier_easing_contract"}]
              }
            }
          }
        }
      }
    },
    "effect_time": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "posterize_fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "curve": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["frame", "value"], "properties": { "frame": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "value": { "type": "number", "minimum": 0, "maximum": 1 }, "interpolation": { "enum": ["linear", "hold", "bezier"] }, "easing": { "$ref": "#/$defs/easing" }, "bezier_curve": { "$ref": "#/$defs/bezier_curve" } } } },
        "easing": { "$ref": "#/$defs/easing" },
        "bezier_curve": { "$ref": "#/$defs/bezier_curve" }
      },
      "anyOf": [{ "required": ["posterize_fps"] }, { "required": ["curve"] }],
      "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }]
    },
    "bezier_curve": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "number", "minimum": -10, "maximum": 10 }
    },
    "bezier_easing_contract": {
      "allOf": [
        { "if": { "required": ["easing"], "properties": { "easing": { "const": "bezier" } } }, "then": { "required": ["bezier_curve"] } },
        { "if": { "required": ["bezier_curve"] }, "then": { "properties": { "easing": { "const": "bezier" } }, "required": ["easing"] } }
      ]
    },
    "easing": {
      "enum": [
        "linear", "in_quad", "out_quad", "in_out_quad",
        "in_cubic", "out_cubic", "in_out_cubic",
        "in_expo", "out_expo", "in_out_expo",
        "in_sine", "out_sine", "in_out_sine",
        "in_back", "out_back", "in_out_back",
        "in_elastic", "out_elastic", "in_out_elastic",
        "in_bounce", "out_bounce", "in_out_bounce",
        "smoothstep", "hold", "bezier"
      ]
    },
    "animator_property_track": {
      "description": "V3 override of the V2 animator property track. The property vocabulary is the V2 set plus the per-glyph 'rotation' and 'fill_color' tracks; V2 plans keep the frozen V2 enum and cannot use them.",
      "type": "object", "additionalProperties": false,
      "required": ["property", "keyframes"],
      "properties": {
        "property": {
          "enum": ["position", "position_x", "position_y", "scale", "scale_x", "scale_y", "opacity", "blur", "tracking", "rotation", "fill_color"]
        },
        "easing": { "$ref": "#/$defs/easing" },
        "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
        "keyframes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["frame", "value"],
            "properties": {
              "frame": { "type": "integer", "minimum": 0 },
              "value": {
                "oneOf": [
                  { "type": "number" },
                  { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "number" } }
                ]
              },
              "interpolation": { "enum": ["linear", "hold", "bezier"] },
              "easing": { "$ref": "#/$defs/easing" },
              "bezier_curve": { "$ref": "#/$defs/bezier_curve" }
            }
          }
        }
      },
      "allOf": [
        { "$ref": "#/$defs/bezier_easing_contract" },
        {
          "if": { "properties": { "property": { "const": "fill_color" } }, "required": ["property"] },
          "then": {
            "properties": {
              "keyframes": {
                "items": {
                  "properties": {
                    "value": { "type": "array", "minItems": 4, "maxItems": 4,
                               "items": { "type": "number", "minimum": 0, "maximum": 1 } }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "property": { "const": "rotation" } }, "required": ["property"] },
          "then": {
            "properties": {
              "keyframes": {
                "items": {
                  "properties": {
                    "value": {
                      "oneOf": [
                        { "type": "number" },
                        { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "selector_track": {
      "type": "object", "additionalProperties": false,
      "required": ["keyframes"],
      "properties": {
        "property": { "type": "string" },
        "easing": { "$ref": "#/$defs/easing" },
        "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
        "keyframes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["frame", "value"],
            "properties": {
              "frame": { "type": "integer", "minimum": 0 },
              "value": {
                "oneOf": [
                  { "type": "number" },
                  { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "number" } }
                ]
              },
              "interpolation": { "enum": ["linear", "hold", "bezier"] },
              "easing": { "$ref": "#/$defs/easing" },
              "bezier_curve": { "$ref": "#/$defs/bezier_curve" }
            }
          }
        }
      },
      "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }]
    },
    "text_selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "semantic_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "unit": { "enum": ["glyph", "grapheme", "character", "word", "line"] },
        "shape": { "enum": ["square", "ramp_up", "ramp_down", "triangle", "round", "smooth", "wiggly"] },
        "wiggly_frequency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "wiggly_amplitude": { "type": "number", "minimum": 0, "maximum": 1 },
        "wiggly_seed": { "type": "integer", "minimum": 0 },
        "order": { "enum": ["forward", "reverse", "from_center", "to_center", "random"] },
        "combine": { "enum": ["replace", "add", "subtract", "intersect", "min", "max"] },
        "start": { "$ref": "#/$defs/selector_track" },
        "end": { "$ref": "#/$defs/selector_track" },
        "offset": { "$ref": "#/$defs/selector_track" },
        "amount": { "$ref": "#/$defs/selector_track" },
        "exclude_spaces": { "type": "boolean" },
        "randomize_order": { "type": "boolean" },
        "random_seed": { "type": "integer", "minimum": 0 }
      },
      "allOf": [{
        "if": { "properties": { "shape": { "const": "wiggly" } }, "required": ["shape"] },
        "then": {},
        "else": { "not": { "anyOf": [
          { "required": ["wiggly_frequency"] },
          { "required": ["wiggly_amplitude"] },
          { "required": ["wiggly_seed"] }
        ] } }
      }]
    },
    "text_animator": {
      "type": "object", "additionalProperties": false,
      "required": ["selectors", "properties"],
      "properties": {
        "id": { "type": "string" },
        "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text_selector" } },
        "properties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/animator_property_track" } }
      }
    },
    "rgba": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "color_stop": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "color"],
      "properties": {
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "$ref": "#/$defs/rgba" }
      }
    },
    "opacity_stop": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "opacity"],
      "properties": {
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "gradient": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "color_stops"],
      "properties": {
        "type": { "enum": ["linear", "radial", "conic"] },
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" },
        "center": { "$ref": "#/$defs/point" },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "angle": { "type": "number" },
        "spread": { "enum": ["pad", "repeat", "reflect"] },
        "color_stops": { "type": "array", "minItems": 2, "maxItems": 256, "items": { "$ref": "#/$defs/color_stop" } },
        "opacity_stops": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/opacity_stop" } }
      }
    },
    "path_command": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["move_to", "line_to", "quadratic_to", "cubic_to", "close"] },
        "point": { "$ref": "#/$defs/point" },
        "control1": { "$ref": "#/$defs/point" },
        "control2": { "$ref": "#/$defs/point" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["move_to", "line_to", "quadratic_to", "cubic_to"] } }, "required": ["type"] }, "then": { "required": ["point"] } },
        { "if": { "properties": { "type": { "enum": ["move_to", "line_to"] } }, "required": ["type"] }, "then": { "not": { "anyOf": [{ "required": ["control1"] }, { "required": ["control2"] }] } } },
        { "if": { "properties": { "type": { "const": "cubic_to" } }, "required": ["type"] }, "then": { "required": ["control1", "control2"] } },
        { "if": { "properties": { "type": { "const": "quadratic_to" } }, "required": ["type"] }, "then": { "required": ["control1"], "not": { "required": ["control2"] } } },
        { "if": { "properties": { "type": { "const": "close" } }, "required": ["type"] }, "then": { "not": { "anyOf": [{ "required": ["point"] }, { "required": ["control1"] }, { "required": ["control2"] }] } } }
      ]
    },
    "stroke": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "color": { "oneOf": [{ "$ref": "#/$defs/rgba" }, { "$ref": "#/$defs/gradient" }, { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }] },
        "width": { "type": "number", "minimum": 0 },
        "trim_start": { "type": "number", "minimum": 0, "maximum": 1 },
        "trim_end": { "type": "number", "minimum": 0, "maximum": 1 },
        "dash_array": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "dash_offset": { "type": "number" },
        "gradient": { "$ref": "#/$defs/gradient" }
      },
      "not": { "required": ["color", "gradient"] }
    },
    "shadow": {
      "type": "object", "additionalProperties": false,
      "required": ["color", "offset"],
      "properties": {
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "offset": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blur": { "type": "number", "minimum": 0 }
      }
    },
    "shape": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "not": { "required": ["radius", "corner_radius"] },
      "properties": {
        "type": { "enum": ["rect", "rounded_rect", "ellipse", "line", "path"] },
        "asset": { "type": "string", "minLength": 1, "pattern": "\\.svg$" },
        "lottie": { "type": "string", "minLength": 1, "pattern": "\\.json$" },
        "radius": { "type": "number", "minimum": 0 },
        "corner_radius": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 } },
        "fill": { "oneOf": [{ "$ref": "#/$defs/rgba" }, { "$ref": "#/$defs/gradient" }] },
        "stroke": { "$ref": "#/$defs/stroke" },
        "path": { "type": "array", "minItems": 1, "maxItems": 65536, "items": { "$ref": "#/$defs/path_command" } },
        "operators": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "params"],
            "properties": {
              "kind": { "enum": ["repeater", "round_corners", "zig_zag", "offset_path", "pucker_bloat", "twist", "wiggle_path", "merge", "trim", "morph"] },
              "params": {
                "oneOf": [
                  {
                "type": "object", "additionalProperties": false,
                "required": ["copies"],
                "properties": {
                  "copies": { "type": "integer", "minimum": 1, "maximum": 10000 },
                  "position": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                  "scale": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                  "anchor": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                  "rotation_degrees": { "type": "number" },
                  "opacity_decay": { "type": "number", "minimum": 0, "maximum": 1 }
                }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["radius"],
                    "properties": { "radius": { "type": "number", "minimum": 0 } }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["size"],
                    "properties": {
                      "size": { "type": "number", "minimum": 0 },
                      "points_per_unit": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                      "smooth": { "type": "boolean" }
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["amount"],
                    "properties": {
                      "amount": { "type": "number" },
                      "miter_limit": { "type": "number", "minimum": 1, "maximum": 1000 }
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["amount"],
                    "properties": {
                      "amount": { "type": "number", "minimum": -1, "maximum": 1 },
                      "anchor": { "type": "array", "minItems": 2, "maxItems": 2,
                                  "items": { "type": "number" } }
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["degrees"],
                    "properties": {
                      "degrees": { "type": "number" },
                      "center": { "type": "array", "minItems": 2, "maxItems": 2,
                                  "items": { "type": "number" } }
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["amount"],
                    "properties": {
                      "amount": { "type": "number", "minimum": 0 },
                      "frequency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                      "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["paths"],
                    "properties": {
                      "paths": {
                        "type": "array", "maxItems": 1024,
                        "items": { "type": "array", "minItems": 1, "maxItems": 65536,
                                    "items": { "$ref": "#/$defs/path_command" } }
                      }
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "properties": {
                      "start": { "type": "number", "minimum": 0, "maximum": 1 },
                      "end": { "type": "number", "minimum": 0, "maximum": 1 },
                      "offset": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false,
                    "required": ["target"],
                    "properties": {
                      "target": { "type": "array", "minItems": 1, "maxItems": 65536,
                                    "items": { "$ref": "#/$defs/path_command" } },
                      "progress": { "type": "number", "minimum": 0, "maximum": 1 },
                      "animation": {
                        "type": "object", "additionalProperties": false,
                        "required": ["keyframes"],
                        "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }],
                        "properties": {
                          "easing": { "$ref": "#/$defs/easing" },
                          "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
                          "keyframes": {
                            "type": "array", "minItems": 1, "maxItems": 65536,
                            "items": {
                              "type": "object", "additionalProperties": false,
                              "required": ["frame", "value"],
                              "properties": {
                                "frame": { "type": "integer", "minimum": 0, "maximum": 1000000 },
                                "value": { "type": "number", "minimum": 0, "maximum": 1 },
                                "interpolation": { "enum": ["linear", "hold", "bezier"] },
                                "easing": { "$ref": "#/$defs/easing" },
                                "bezier_curve": { "$ref": "#/$defs/bezier_curve" }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "path" } }, "required": ["type"] }, "then": { "oneOf": [{"required":["path"],"not":{"anyOf":[{"required":["asset"]},{"required":["lottie"]}]}},{"required":["asset"],"not":{"anyOf":[{"required":["path"]},{"required":["lottie"]}]}},{"required":["lottie"],"not":{"anyOf":[{"required":["path"]},{"required":["asset"]}]}}] } },
        { "if": { "properties": { "type": { "const": "line" } }, "required": ["type"] }, "then": { "required": ["path", "stroke"] } },
        { "if": { "properties": { "type": { "enum": ["rect", "rounded_rect", "ellipse"] } }, "required": ["type"] }, "then": { "not": { "required": ["path"] } } }
      ]
    }
  },
  "type": "object",
  "required": ["schema", "version", "layers"],
  "properties": {
    "schema": { "const": "chronon.render-plan.v3" },
    "version": { "const": 3 },
    "variables": {
      "type": "object", "maxProperties": 1024,
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number"] }
    },
    "temporal_motion_blur": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "shutter_angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
        "samples": { "type": "integer", "minimum": 2, "maximum": 64 }
      }
    },
    "audio": {"$ref": "#/$defs/audio"},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "enum": ["image", "video", "text", "color", "shape", "particles", "light", "adjustment"] },
          "light": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
              "intensity": { "type": "number", "minimum": 0, "maximum": 16 }
            }
          },
          "safe_insets": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "top": { "type": "number", "minimum": 0, "maximum": 1000000 },
              "right": { "type": "number", "minimum": 0, "maximum": 1000000 },
              "bottom": { "type": "number", "minimum": 0, "maximum": 1000000 },
              "left": { "type": "number", "minimum": 0, "maximum": 1000000 }
            }
          },
          "particle_emitter": {
            "type": "object", "additionalProperties": false,
            "required": ["count", "seed", "emitter_size", "velocity_min", "velocity_max", "lifetime", "size"],
            "properties": {
              "count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "emitter_size": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
              "velocity_min": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "velocity_max": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "lifetime": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } },
              "size": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
              "gravity": { "type": "number" },
              "turbulence": { "type": "number", "minimum": 0 },
              "shape": { "enum": ["box", "ellipse", "edge", "path"] },
              "path_id": { "type": "string" },
              "path_points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
              "sprite_asset": { "type": "string" },
              "blend_mode": { "enum": ["normal", "add", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion", "soft_light", "hard_light", "color_dodge", "color_burn", "subtract", "divide", "vivid_light", "pin_light", "linear_light", "hue", "saturation", "color", "luminosity"] },
              "sprite_scale": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
              "rotation": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "angular_velocity": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "color_ramp": {
                "type": "array", "minItems": 2, "maxItems": 256,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["position", "color"],
                  "properties": {
                    "position": { "type": "number", "minimum": 0, "maximum": 1 },
                    "color": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
                  }
                }
              }
            }
          },
          "spans": {
            "type": "array", "maxItems": 65536,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["start", "end", "style"],
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 1 },
                "semantic_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                "style": {
                  "type": "object", "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
                    "font_size_mult": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
                    "tracking": { "type": "number", "minimum": -1000, "maximum": 1000 },
                    "stroke": {
                      "type": "object", "additionalProperties": false,
                      "properties": {
                        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
                        "width_em": { "type": "number", "minimum": 0, "maximum": 100 }
                      },
                      "minProperties": 1
                    },
                    "highlight": {
                      "type": "object", "additionalProperties": false,
                      "properties": {
                        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
                        "padding_em": { "type": "number", "minimum": 0, "maximum": 100 },
                        "radius_em": { "type": "number", "minimum": 0, "maximum": 100 }
                      }
                    }
                  }
                }
              }
            }
          },
          "motion_blur": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "shutter_angle": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
              "samples": { "type": "integer", "minimum": 1, "maximum": 64 }
            }
          },
          "transition_in": { "$ref": "#/$defs/transition" },
          "transition_out": { "$ref": "#/$defs/transition" },
          "parent": { "type": "string", "minLength": 1, "maxLength": 256 },
          "track_matte": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "type"],
            "properties": {
              "source": { "type": "string", "minLength": 1, "maxLength": 256 },
              "type": { "enum": ["alpha", "alpha_inverted", "luma", "luma_inverted"] }
            }
          },
          "time_remap": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "speed": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
              "reverse": { "type": "boolean" },
              "freeze_frame": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "animation": {
                "type": "object", "additionalProperties": false,
                "required": ["keyframes"],
                "allOf": [{ "$ref": "#/$defs/bezier_easing_contract" }],
                "properties": {
                  "easing": {
                    "enum": ["linear", "in_quad", "out_quad", "in_out_quad",
                      "in_cubic", "out_cubic", "in_out_cubic", "in_expo", "out_expo",
                      "in_out_expo", "in_sine", "out_sine", "in_out_sine", "in_back",
                      "out_back", "in_out_back", "in_elastic", "out_elastic",
                      "in_out_elastic", "in_bounce", "out_bounce", "in_out_bounce",
                      "smoothstep", "hold", "bezier"]
                  },
                  "bezier_curve": { "$ref": "#/$defs/bezier_curve" },
                  "keyframes": {
                    "type": "array", "minItems": 1, "maxItems": 65536,
                    "items": {
                      "type": "object", "additionalProperties": false,
                      "required": ["frame", "value"],
                      "properties": {
                        "frame": { "type": "integer", "minimum": 0, "maximum": 1000000 },
                        "value": { "type": "number", "minimum": 0, "maximum": 1000000 }
                      ,
                "interpolation": { "enum": ["linear", "hold", "bezier"] },
                "easing": { "$ref": "#/$defs/easing" },
                "bezier_curve": { "$ref": "#/$defs/bezier_curve" }
              }
                    }
                  }
                }
              }
            },
            "not": { "required": ["freeze_frame", "animation"] }
          },
          "shape": { "$ref": "#/$defs/shape" },
          "text_animators": {
            "type": "array", "items": { "$ref": "#/$defs/text_animator" }
          },
          "mask": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "const": "path" },
              "path": { "type": "array", "minItems": 1, "maxItems": 65536,
                        "items": { "$ref": "#/$defs/path_command" } },
              "feather": { "type": "number", "minimum": 0, "maximum": 1000000 },
              "expansion": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
              "inverted": { "type": "boolean" }
            }
          },
          "effects": {
            "type": "array", "maxItems": 64,
            "items": { "oneOf": [
              { "type": "object", "additionalProperties": false,
                "required": ["type", "asset"],
                "properties": {
                  "type": { "const": "lut_3d" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "asset": { "type": "string", "minLength": 1, "maxLength": 4096 },
                  "amount": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "echo" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "echoes": { "type": "integer", "minimum": 1, "maximum": 8 },
                  "decay": { "type": "number", "minimum": 0, "maximum": 1 },
                  "time_offset_frames": { "type": "integer", "minimum": 1, "maximum": 120 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "keying" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "mode": { "enum": ["luma", "chroma"] },
                  "key_color": { "type": "array", "minItems": 3, "maxItems": 4,
                                 "items": { "type": "number", "minimum": 0, "maximum": 1 } },
                  "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
                  "softness": { "type": "number", "minimum": 0, "maximum": 1 },
                  "spill": { "type": "number", "minimum": 0, "maximum": 1 },
                  "clip_black": { "type": "number", "minimum": 0, "maximum": 1 },
                  "clip_white": { "type": "number", "minimum": 0, "maximum": 1 },
                  "choke": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
                  "garbage_rect": { "type": "array", "minItems": 4, "maxItems": 4,
                                    "items": { "type": "number", "minimum": 0, "maximum": 1 } },
                  "garbage_feather": { "type": "number", "minimum": 0, "maximum": 0.5 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "threshold" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
                  "softness": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "mosaic" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "block_size": { "type": "integer", "minimum": 1, "maximum": 512 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "gaussian_blur" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "radius": { "type": "number", "minimum": 0, "maximum": 256 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "drop_shadow" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "radius": { "type": "number", "minimum": 0, "maximum": 256 },
                  "offset": { "type": "array", "minItems": 2, "maxItems": 2,
                              "items": { "type": "number", "minimum": -10000, "maximum": 10000 } },
                  "color": { "type": "array", "minItems": 4, "maxItems": 4,
                             "items": { "type": "number", "minimum": 0, "maximum": 1 } }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "bloom" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
                  "radius": { "type": "number", "minimum": 0, "maximum": 256 },
                  "intensity": { "type": "number", "minimum": 0, "maximum": 4 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "glow" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "radius": { "type": "number", "minimum": 0, "maximum": 256 },
                  "intensity": { "type": "number", "minimum": 0, "maximum": 4 },
                  "color": { "type": "array", "minItems": 4, "maxItems": 4,
                             "items": { "type": "number", "minimum": 0, "maximum": 1 } }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "noise" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "amount": { "type": "number", "minimum": 0, "maximum": 1 },
                  "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                  "animated": { "type": "boolean" },
                  "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
                  "shadow_response": { "type": "number", "minimum": 0, "maximum": 4 },
                  "midtone_response": { "type": "number", "minimum": 0, "maximum": 4 },
                  "highlight_response": { "type": "number", "minimum": 0, "maximum": 4 },
                  "color_mode": { "enum": ["monochrome", "rgb"] }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "corner_pin" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "top_left": { "type": "array", "minItems": 2, "maxItems": 2,
                                "items": { "type": "number", "minimum": -4, "maximum": 4 } },
                  "top_right": { "type": "array", "minItems": 2, "maxItems": 2,
                                 "items": { "type": "number", "minimum": -4, "maximum": 4 } },
                  "bottom_right": { "type": "array", "minItems": 2, "maxItems": 2,
                                    "items": { "type": "number", "minimum": -4, "maximum": 4 } },
                  "bottom_left": { "type": "array", "minItems": 2, "maxItems": 2,
                                   "items": { "type": "number", "minimum": -4, "maximum": 4 } }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "fractal_noise" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                  "octaves": { "type": "integer", "minimum": 1, "maximum": 16 },
                  "frequency": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
                  "amplitude": { "type": "number", "minimum": 0, "maximum": 4 },
                  "evolution": { "type": "number", "minimum": -10000, "maximum": 10000 },
                  "contrast": { "type": "number", "minimum": 0, "maximum": 16 },
                  "brightness": { "type": "number", "minimum": -16, "maximum": 16 },
                  "color_mode": { "enum": ["monochrome", "rgb"] }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "twirl" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "center": { "type": "array", "minItems": 2, "maxItems": 2,
                              "items": { "type": "number" } },
                  "angle_degrees": { "type": "number", "minimum": -3600, "maximum": 3600 },
                  "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
                  "falloff": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "bulge" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "center": { "type": "array", "minItems": 2, "maxItems": 2,
                              "items": { "type": "number" } },
                  "amount": { "type": "number", "minimum": -1, "maximum": 1 },
                  "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type", "offsets"],
                "properties": {
                  "type": { "const": "mesh_warp" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "cols": { "type": "integer", "minimum": 2, "maximum": 32 },
                  "rows": { "type": "integer", "minimum": 2, "maximum": 32 },
                  "smoothness": { "type": "number", "minimum": 0, "maximum": 1 },
                  "offsets": { "type": "array", "minItems": 8, "maxItems": 2048,
                               "items": { "type": "number", "minimum": -4, "maximum": 4 } }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "sharpen" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "amount": { "type": "number", "minimum": -4, "maximum": 4 },
                  "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 64 },
                  "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "turbulent_displace" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "amount": { "type": "number", "minimum": 0, "maximum": 1 },
                  "size": { "type": "number", "exclusiveMinimum": 0 },
                  "evolution": { "type": "number" }, "evolution_speed": { "type": "number" },
                  "complexity": { "type": "integer", "minimum": 1, "maximum": 16 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "wave_warp" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "wave_type": { "enum": ["sine", "triangle", "square", "saw"] },
                  "direction": { "$ref": "#/$defs/point" }, "amplitude": { "type": "number" },
                  "wavelength": { "type": "number", "exclusiveMinimum": 0 },
                  "speed": { "type": "number" }, "phase": { "type": "number" }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "ripple" },
                  "time": { "$ref": "#/$defs/effect_time" }, "center": { "$ref": "#/$defs/point" },
                  "radius": { "type": "number", "exclusiveMinimum": 0 }, "wave_speed": { "type": "number" },
                  "width": { "type": "number", "exclusiveMinimum": 0 }, "wave_height": { "type": "number" },
                  "damping": { "type": "number", "minimum": 0 }
                }
              },
              { "type": "object", "additionalProperties": false,
                "required": ["type", "map_layer"],
                "properties": {
                  "type": { "const": "displacement_map" },
                  "time": { "$ref": "#/$defs/effect_time" },
                  "map_layer": { "type": "string", "minLength": 1 },
                  "intensity_x": { "type": "number", "minimum": -4, "maximum": 4 },
                  "intensity_y": { "type": "number", "minimum": -4, "maximum": 4 },
                  "map_channel": { "enum": ["luma", "red", "green", "blue", "alpha"] }
                }
              }
            ] }
          },
          "style": {
            "type": "object",
            "properties": {
              "gradient": { "$ref": "#/$defs/gradient" },
              "shadow": { "$ref": "#/$defs/shadow" },
              "shadows": { "type": "array", "minItems": 1, "maxItems": 3,
                           "items": { "$ref": "#/$defs/shadow" } },
              "backdrop": {
                "type": "object", "additionalProperties": false,
                "required": ["blur"],
                "properties": {
                  "blur": { "type": "number", "minimum": 0, "maximum": 64 },
                  "brightness": { "type": "number", "minimum": 0, "maximum": 4 },
                  "saturation": { "type": "number", "minimum": 0, "maximum": 4 }
                }
              },
              "stroke": {
                "type": "object",
                "properties": { "gradient": { "$ref": "#/$defs/gradient" } },
                "required": ["gradient"]
              }
            },
            "not": { "required": ["shadow", "shadows"] }
          }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "shape" } }, "required": ["type"] }, "then": { "required": ["shape", "size"] } },
          { "if": { "properties": { "type": { "const": "particles" } }, "required": ["type"] }, "then": { "required": ["particle_emitter"] } },
          { "if": { "properties": { "type": { "const": "light" } }, "required": ["type"] }, "then": { "required": ["light"] } },
          { "if": { "properties": { "type": { "const": "adjustment" } }, "required": ["type"] }, "then": { "required": ["effects"], "properties": { "effects": { "minItems": 1 } } } },
          { "if": { "required": ["time_remap"] }, "then": { "properties": { "type": { "const": "video" } } } }
        ]
      }
    }
  }
}
