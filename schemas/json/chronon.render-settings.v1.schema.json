{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronon3d.dev/schemas/chronon.render-settings.v1.schema.json",
  "title": "Chronon3D Render Settings V1",
  "description": "Neutral render settings contract. Backend-specific software, GPU and encoder knobs are intentionally outside this IPC boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version"],
  "properties": {
    "schema": {
      "const": "chronon.render-settings"
    },
    "version": {
      "const": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7680
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4320
    },
    "antialiasing_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "MSAA sample count. A value of 1 disables MSAA."
    },
    "motion_blur": {
      "type": "boolean"
    },
    "dirty_rects": {
      "type": "boolean"
    },
    "deterministic": {
      "type": "boolean"
    }
  }
}
