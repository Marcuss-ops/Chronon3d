{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronon3d.dev/schemas/chronon.render-plan.v2.schema.json",
  "title": "Chronon3D Render Plan V2",
  "description": "Primitive execution contract. Callers must lower editorial semantics into concrete assets, geometry, style and animation tracks before invoking Chronon.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "text_track": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "keyframes"],
      "properties": {
        "property": { "type": "string" },
        "easing": { "type": "string" },
        "keyframes": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["frame", "value"],
            "properties": {
              "frame": { "type": "integer", "minimum": 0 },
              "value": {
                "oneOf": [
                  { "type": "number" },
                  { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "number" } }
                ]
              }
            }
          }
        }
      }
    },
    "text_selector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "unit": { "enum": ["glyph", "grapheme", "character", "word", "line"] },
        "shape": { "enum": ["square", "ramp_up", "ramp_down", "triangle", "round", "smooth"] },
        "order": { "enum": ["forward", "reverse", "from_center", "to_center", "random"] },
        "combine": { "enum": ["replace", "add", "subtract", "intersect", "min", "max"] },
        "start": { "$ref": "#/$defs/text_track" },
        "end": { "$ref": "#/$defs/text_track" },
        "offset": { "$ref": "#/$defs/text_track" },
        "amount": { "$ref": "#/$defs/text_track" },
        "exclude_spaces": { "type": "boolean" },
        "randomize_order": { "type": "boolean" },
        "random_seed": { "type": "integer", "minimum": 0 }
      }
    },
    "text_animator": {
      "type": "object", "additionalProperties": false,
      "required": ["selectors", "properties"],
      "properties": {
        "id": { "type": "string" },
        "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text_selector" } },
        "properties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text_track" } }
      }
    }
  },
  "required": ["schema", "version", "canvas", "layers", "output"],
  "properties": {
    "schema": { "const": "chronon.render-plan.v2" },
    "version": { "const": 2 },
    "job_id": { "type": "string", "minLength": 1 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps_num", "fps_den", "duration_frames"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4320 },
        "fps_num": { "type": "integer", "minimum": 1, "maximum": 240000 },
        "fps_den": { "type": "integer", "minimum": 1, "maximum": 1001 },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["image", "video", "text", "color"] },
          "asset": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "maxLength": 1048576 },
          "size": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "number" }
          },
          "color": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number" }
          },
          "position": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "number" }
          },
          "scale": {
            "type": "array", "minItems": 2, "maxItems": 3,
            "items": { "type": "number" }
          },
          "rotation": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": { "type": "number" }
          },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "fit": { "enum": ["cover", "contain", "stretch", "none"] },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "font": { "type": "string", "minLength": 1 },
              "font_size": { "type": "number", "exclusiveMinimum": 0 },
              "fill": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "stroke": {
                "type": "object", "additionalProperties": false,
                "required": ["color", "width"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "width": { "type": "number", "minimum": 0 }
                }
              },
              "shadow": {
                "type": "object", "additionalProperties": false,
                "required": ["color"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "blur": { "type": "number", "minimum": 0 },
                  "offset": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              },
              "background": {
                "type": "object", "additionalProperties": false,
                "required": ["color"],
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "radius": { "type": "number", "minimum": 0 },
                  "padding": {
                    "type": "array", "minItems": 2, "maxItems": 2,
                    "items": { "type": "number" }
                  }
                }
              }
            }
          },
          "animation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tracks"],
            "properties": {
              "tracks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["property", "keyframes"],
                  "properties": {
                    "property": {
                      "enum": [
                        "position", "position_x", "position_y", "position_z",
                        "scale", "scale_x", "scale_y", "scale_z",
                        "rotation", "rotation_x", "rotation_y", "rotation_z",
                        "opacity"
                      ]
                    },
                    "easing": {
                      "enum": [
                        "linear", "in_quad", "out_quad", "in_out_quad",
                        "in_cubic", "out_cubic", "in_out_cubic",
                        "in_expo", "out_expo", "in_out_expo",
                        "in_sine", "out_sine", "in_out_sine",
                        "in_back", "out_back", "in_out_back",
                        "in_elastic", "out_elastic", "in_out_elastic",
                        "in_bounce", "out_bounce", "in_out_bounce",
                        "smoothstep", "hold"
                      ]
                    },
                    "keyframes": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["frame", "value"],
                        "properties": {
                          "frame": { "type": "integer", "minimum": 0 },
                          "value": {
                            "oneOf": [
                              { "type": "number" },
                              {
                                "type": "array", "minItems": 1, "maxItems": 4,
                                "items": { "type": "number" }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "text_animators": {
            "type": "array", "items": { "$ref": "#/$defs/text_animator" }
          },
          "blend_mode": {
            "enum": ["normal", "add", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion", "soft_light", "hard_light", "color_dodge", "color_burn"]
          },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "loop": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
            "then": {
              "required": ["text", "style"],
              "properties": {
                "style": { "required": ["font", "font_size", "fill"] }
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
            "then": { "required": ["asset", "size"] }
          },
          {
            "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
            "then": { "required": ["source"] }
          },
          {
            "if": { "properties": { "type": { "const": "color" } }, "required": ["type"] },
            "then": { "required": ["color"] }
          }
        ]
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": { "max_temporal_pixels": { "type": "integer", "minimum": 1 } }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["png", "mp4", "mkv", "webm"] },
        "codec": { "enum": ["auto", "h264", "h265", "vp9", "av1"] },
        "profile_id": { "type": "string", "minLength": 1 },
        "rate_control": { "enum": ["crf", "qp", "bitrate"] },
        "bitrate": { "type": "integer", "minimum": 1 },
        "crf": { "type": "integer", "minimum": 0, "maximum": 51 },
        "qp": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    }
  }
}
