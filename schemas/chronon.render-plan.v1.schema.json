{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronon3d.dev/schemas/chronon.render-plan.v1.schema.json",
  "title": "Chronon3D Render Plan V1",
  "description": "Canonical structural contract for render-plan JSON submitted to the daemon or SDK boundary. Runtime asset, preset, budget and backend checks remain semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "canvas", "layers", "output"],
  "properties": {
    "schema": { "const": "chronon.render-plan" },
    "version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "style_profile": { "enum": ["discovery", "young", "crime"] },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps_num", "fps_den", "duration_frames"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4320 },
        "fps_num": { "type": "integer", "minimum": 1, "maximum": 240000 },
        "fps_den": { "type": "integer", "minimum": 1, "maximum": 1001 },
        "duration_frames": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["image", "video", "text", "color", "subtitle_track"] },
          "asset": { "type": "string" },
          "source": { "type": "string" },
          "text": { "type": "string", "maxLength": 1048576 },
          "font": { "type": "string" },
          "font_asset": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "asset": { "type": "string", "minLength": 1 },
              "family": { "type": "string" },
              "weight": { "type": "integer", "minimum": 1 }
            }
          },
          "font_size": { "type": "number", "exclusiveMinimum": 0 },
          "box_width": { "type": "number", "exclusiveMinimum": 0 },
          "box_height": { "type": "number", "exclusiveMinimum": 0 },
          "color": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
          "position": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } },
          "offset": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "fit": { "enum": ["cover", "contain", "stretch", "none"] },
          "format": { "enum": ["srt", "vtt", "json"] },
          "preset": { "type": "string" },
          "semantic_role": { "type": "string" },
          "anchor": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "type": { "enum": ["center", "safe_area", "lower_third", "lower_left", "lower_right", "top_left", "top_right", "bottom_left", "bottom_right", "image_left", "image_right"] },
              "safe_margin": { "type": "number", "minimum": 0, "maximum": 0.5 },
              "alignment": { "enum": ["left", "center", "right"] }
            }
          },
          "style": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "font_family": { "type": "string" },
              "font_weight": { "type": "integer", "minimum": 1 },
              "font_size": { "type": "number", "exclusiveMinimum": 0 },
              "fill": { "type": "string" },
              "stroke": {
                "type": "object", "additionalProperties": false,
                "properties": { "color": { "type": "string" }, "width": { "type": "number", "exclusiveMinimum": 0 } }
              },
              "shadow": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "color": { "type": "string" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "blur": { "type": "number", "minimum": 0 },
                  "offset": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
                }
              },
              "background": {
                "type": "object", "additionalProperties": false,
                "properties": {
                  "color": { "type": "string" },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "radius": { "type": "number", "minimum": 0 },
                  "padding": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
                }
              }
            }
          },
          "background": {
            "type": "object", "additionalProperties": false, "required": ["asset"],
            "properties": {
              "asset": { "type": "string", "minLength": 1 },
              "fit": { "enum": ["cover", "contain", "stretch", "none"] },
              "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "animation": {
            "type": "object", "additionalProperties": false, "required": ["preset"],
            "properties": {
              "preset": { "type": "string", "minLength": 1 },
              "start_frame": { "type": "integer", "minimum": 0 },
              "duration_frames": { "type": "integer", "minimum": 1 },
              "unit": { "enum": ["word", "glyph", "line"] },
              "enter": { "type": "object", "additionalProperties": false, "properties": { "duration_frames": { "type": "integer", "minimum": 1 } } },
              "exit": { "type": "object", "additionalProperties": false, "properties": { "duration_frames": { "type": "integer", "minimum": 1 } } }
            }
          },
          "blend_mode": { "enum": ["normal", "add", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion", "soft_light", "hard_light", "color_dodge", "color_burn"] },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "loop": { "type": "boolean" }
        }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": { "max_temporal_pixels": { "type": "integer", "minimum": 1 } }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["png", "mp4", "mkv", "webm"] },
        "codec": { "enum": ["auto", "h264", "h265", "vp9", "av1"] },
        "profile_id": { "type": "string", "minLength": 1 },
        "bitrate": { "type": "integer", "minimum": 0 },
        "crf": { "type": "integer", "minimum": 0, "maximum": 63 }
      }
    }
  }
}
