{
  "schema": "chronon.render-plan.v2",
  "version": 2,
  "job_id": "direct-yuv-text-shadow-cert",
  "canvas": {
    "width": 1280,
    "height": 720,
    "fps_num": 30,
    "fps_den": 1,
    "duration_frames": 16
