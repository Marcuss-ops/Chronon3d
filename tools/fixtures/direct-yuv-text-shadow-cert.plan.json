      "fit": "stretch",
      "start_frame": 0,
      "duration_frames": 16
    },
    {
      "id": "shadowed_phrase",
      "type": "text",
      "text": "THIS CHANGES EVERYTHING",
      "position": [0, -170],
      "style": {
        "font": "assets/fonts/Poppins-Bold.ttf",
        "font_size": 64,
        "fill": "#FFFFFF",
        "stroke": { "color": "#111827", "width": 3.5 },
        "shadow": { "color": "#000000", "opacity": 0.72, "blur": 12, "offset": [0, 4] }
