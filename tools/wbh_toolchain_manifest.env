WBH_GPU_VENDOR=NVIDIA
WBH_GPU_MIN_VRAM_GB=8
WBH_CUDA_VULKAN_UUID_MATCH_REQUIRED=1
WBH_CCACHE_RECOMMENDED=1
WBH_MOLD_RECOMMENDED=1
WBH_PERSISTENT_BUILD_DIR_REQUIRED=1
WBH_PERSISTENT_VCPKG_CACHE_REQUIRED=1
WBH_PERSISTENT_CCACHE_REQUIRED=1
