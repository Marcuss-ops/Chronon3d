# Chronon3D Working Build Host toolchain contract
# This file is declarative; it does not install or modify host packages.
# Update only through an explicit certification cycle.

WBH_OS_FAMILY=Linux
WBH_GENERATOR=Ninja
WBH_NINJA_MIN_VERSION=1.14.0
WBH_CMAKE_MIN_VERSION=3.27.0
WBH_COMPILER_FAMILY=GNU-or-Clang
WBH_CUDA_REQUIRED=1
WBH_NVCC_REQUIRED=1
WBH_VULKAN_REQUIRED=1
WBH_NVENC_REQUIRED=1
