# Versioned WBH toolchain contract for the Linux video certification profile.
# Values are constraints, not a dump of one developer's absolute paths.
SCHEMA_VERSION=1
PROFILE=linux-video-test
OS=Linux
ARCH=x86_64
MIN_CMAKE=3.25
MIN_NINJA=1.10
MIN_GNU_CXX=13
MIN_PYTHON=3.11
REQUIRE_GLSLANG=1
BUILD_TYPE=Debug
GENERATOR=Ninja
COMPILER_FAMILY=GNU
REQUIRED_CMAKE_OPTIONS=CHRONON3D_ENABLE_TEXT,CHRONON3D_ENABLE_VIDEO,CHRONON3D_ENABLE_VULKAN,CHRONON3D_ENABLE_VERIFICATION
