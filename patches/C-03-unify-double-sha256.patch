From: Codebuff <noreply@codebuff.com>
Date: 2026-05-11
Subject: [PATCH] C-03: unify double sha256_file in ResourcePreparation (FIXING.md)
Risk: Medium — requires build + tests (image digest path). Do NOT apply without CI.
Refs: FIXING.md C-03 (src/runtime/resource_preparation.cpp:191/346)

Problem:
  decode_image() does sha256_file(*resolved) and the caller in
  ResourcePreparation::prepare() Phase 2 does a second sha256_file(*resolved)
  for the same image. That's 2× synchronous file read + hash per image
  during the preparation barrier (already sync on main thread). 50 images →
  100 full file reads before frame 0.

Fix:
  Make decode_image() the single SHA source. Its Result<PreparedImage>
  already carries content_digest. The caller reuses it instead of
  re-hashing. The fallback re-resolve + second hash is removed.

diff --git a/src/runtime/resource_preparation.cpp b/src/runtime/resource_preparation.cpp
--- a/src/runtime/resource_preparation.cpp
+++ b/src/runtime/resource_preparation.cpp
@@ -130,30 +130,24 @@
         // Phase 2 — image-decode
         if (options.prepare_images) {
             for (const auto& ref : manifest.filter(assets::AssetKind::Image)) {
-                const bool prepared_ok = run_phase(Policy::AppendWarning, options.failure_mode, ref, "image",
-                          [&](const assets::InternalAssetRef& r) {
-                              return decode_image(r, resolver);
-                          }, &prepared.diagnostics, &prepared.diagnostics.warnings);
-                if (!prepared_ok) continue;  // WarnAndSkip: missing asset — skip keyed map
-                const auto resolved = resolver.resolve(ref.path);
-                if (!resolved) continue;
-                const auto digest = assets::sha256_file(*resolved);
-                if (!digest) {
-                    if (options.failure_mode == PreparationOptions::FailureMode::FailLoud) {
-                        throw PreparationError{
-                            .code = PreparationError::Code::CorruptedAsset,
-                            .message = "image content digest failed: " + ref.path,
-                            .path = ref.path,
-                            .owner = ref.owner,
-                            .phase = "image",
-                        };
-                    }
-                    continue;
-                }
-                const auto [it, inserted] = prepared.images.emplace(ref.owner, PreparedImage{
-                    .path   = ref.path,
-                    .owner  = ref.owner,
-                    .width  = 0,
-                    .height = 0,
-                    .content_digest = *digest
-                });
+                // FIXING.md C-03 — single sha256_file via decode_image().
+                // Previously decode_image() hashed and then the caller hashed
+                // again (double I/O). Now we consume the PreparedImage's
+                // content_digest directly.
+                auto image_result = decode_image(ref, resolver);
+                if (!image_result.has_value()) {
+                    if (options.failure_mode == PreparationOptions::FailureMode::FailLoud) {
+                        throw image_result.error();
+                    }
+                    prepared.diagnostics.warnings.push_back({
+                        image_result.error().code,
+                        image_result.error().message,
+                        "image"
+                    });
+                    continue;
+                }
+                const auto [it, inserted] = prepared.images.emplace(
+                    ref.owner, std::move(image_result.value()));
                 if (inserted) ++prepared.diagnostics.images_decoded;
             }
         }
