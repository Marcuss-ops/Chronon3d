    "Light Sweep", EffectCategory::Light, EffectStage::LayerPostTransform,
    EffectDomain::Spatial, AlphaPolicy::Preserve, DirtyPolicy::Preserve,
    BoundsPolicy::Preserve, false, false)

// CC-style 2D layer wraps. Both produce a visible-front curved surface and
// keep the source layer's alpha footprint; the 3D mesh primitives remain a
