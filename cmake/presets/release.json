{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "__release-base",
      "hidden": true,
      "inherits": "base-linux",
      "displayName": "V0.1 release-only base (hidden helper)",
      "description": "Release validation base for the external-content architecture. Keeps the core dependency surface lean while enabling tests and IPC explicitly for release verification.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONON3D_ENABLE_TELEMETRY": "OFF",
        "CHRONON3D_ENABLE_TRACING": "OFF",
        "CHRONON3D_BUILD_BENCHMARKS": "OFF",
        "CHRONON3D_ENABLE_MESH": "OFF",
        "CHRONON3D_ENABLE_SVG": "OFF",
        "CHRONON3D_ENABLE_EXR": "OFF",
        "CHRONON3D_ENABLE_IPC": "ON",
        "CHRONON3D_BUILD_DAEMON": "OFF",
        "CHRONON3D_BUILD_C_API": "OFF",
        "CHRONON3D_ENABLE_VERIFICATION": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;ipc"
      }
    },
    {
      "name": "linux-release-validation",
      "inherits": "__release-base",
      "displayName": "Linux Release Validation (V0.1)",
      "description": "Release validation of the engine core: CLI + text + Blend2D + software renderer + IPC + install consumer + required tests. Bundled compositions are intentionally external.",
      "cacheVariables": {
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_INSTALL_CONSUMER_TEST": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-release-validation",
      "configurePreset": "linux-release-validation",
      "targets": [
        "chronon3d_cli",
        "chronon3d_tests",
        "chronon3d_sdk_impl"
      ],
      "jobs": 16
    }
  ],
  "testPresets": [
    {
      "name": "linux-release-validation-test",
      "configurePreset": "linux-release-validation",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
