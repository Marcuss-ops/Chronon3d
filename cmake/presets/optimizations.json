{
  "version": 6,
  "include": [
    "release.json"
  ],
  "configurePresets": [
    {
      "name": "__release-pgo-base",
      "hidden": true,
      "inherits": "__release-base",
      "displayName": "V0.1 release-optimization base (hidden helper for PGO/ThinLTO/BOLT)",
      "description": "Shared hidden base for PGO, ThinLTO and BOLT release optimization. Floating-point contraction remains controlled by the root deterministic-build policy.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONON3D_ENABLE_TELEMETRY": "OFF",
        "CHRONON3D_ENABLE_TRACING": "OFF",
        "CHRONON3D_BUILD_BENCHMARKS": "OFF",
        "CHRONON3D_PROFILE_DATA_PATH": "${sourceDir}/build/chronon/${presetName}/merged.profdata",
        "CHRONON3D_BOLT_DATA_PATH": "${sourceDir}/build/chronon/${presetName}/perf.fdata",
        "CHRONON3D_PGO_TRAINING_CORPUS": "${sourceDir}/examples/bench_corpus/corpus_v1.json",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "release-pgo",
      "inherits": "__release-pgo-base",
      "displayName": "Linux Release PGO (uses pre-collected .profdata)",
      "description": "PGO profile-use build using a pre-collected merged.profdata from the real Chronon training corpus.",
      "cacheVariables": {
        "CMAKE_PROFILE_GENERATE": "OFF",
        "CMAKE_PROFILE_USE": "${sourceDir}/build/chronon/release-pgo/merged.profdata",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_INSTALL_CONSUMER_TEST": "ON"
      }
    },
    {
      "name": "release-thinlto",
      "inherits": "__release-pgo-base",
      "displayName": "Linux Release ThinLTO (no profile)",
      "description": "ThinLTO release build without profile collection.",
      "cacheVariables": {
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE_ARGS": "-flto=thin",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_INSTALL_CONSUMER_TEST": "ON"
      }
    },
    {
      "name": "release-pgo-thinlto",
      "inherits": "__release-pgo-base",
      "displayName": "Linux Release PGO + ThinLTO (combined)",
      "description": "Combined PGO profile-use and ThinLTO release build using a pre-collected merged.profdata.",
      "cacheVariables": {
        "CMAKE_PROFILE_GENERATE": "OFF",
        "CMAKE_PROFILE_USE": "${sourceDir}/build/chronon/release-pgo-thinlto/merged.profdata",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE_ARGS": "-flto=thin",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_INSTALL_CONSUMER_TEST": "ON"
      }
    },
    {
      "name": "release-pgo-thinlto-bolt",
      "inherits": "__release-pgo-base",
      "displayName": "Linux Release PGO + ThinLTO + BOLT (max optimization)",
      "description": "Combined PGO, ThinLTO and BOLT release build. Requires merged.profdata plus BOLT perf.fdata.",
      "cacheVariables": {
        "CMAKE_PROFILE_GENERATE": "OFF",
        "CMAKE_PROFILE_USE": "${sourceDir}/build/chronon/release-pgo-thinlto-bolt/merged.profdata",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE_ARGS": "-flto=thin",
        "CHRONON3D_BOLT_POSTPROCESS": "ON",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_INSTALL_CONSUMER_TEST": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-pgo-build",
      "configurePreset": "release-pgo",
      "targets": [
        "chronon3d_cli",
        "chronon3d_tests",
        "chronon3d_sdk_impl"
      ],
      "jobs": 16
    },
    {
      "name": "release-thinlto-build",
      "configurePreset": "release-thinlto",
      "targets": [
        "chronon3d_cli",
        "chronon3d_tests",
        "chronon3d_sdk_impl"
      ],
      "jobs": 16
    },
    {
      "name": "release-pgo-thinlto-build",
      "configurePreset": "release-pgo-thinlto",
      "targets": [
        "chronon3d_cli",
        "chronon3d_tests",
        "chronon3d_sdk_impl"
      ],
      "jobs": 16
    },
    {
      "name": "release-pgo-thinlto-bolt-build",
      "configurePreset": "release-pgo-thinlto-bolt",
      "targets": [
        "chronon3d_cli",
        "chronon3d_tests",
        "chronon3d_sdk_impl",
        "bolt-postprocess"
      ],
      "jobs": 16
    }
  ],
  "testPresets": [
    {
      "name": "release-pgo-test",
      "configurePreset": "release-pgo",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-thinlto-test",
      "configurePreset": "release-thinlto",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-pgo-thinlto-test",
      "configurePreset": "release-pgo-thinlto",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-pgo-thinlto-bolt-test",
      "configurePreset": "release-pgo-thinlto-bolt",
      "output": { "outputOnFailure": true }
    }
  ]
}
