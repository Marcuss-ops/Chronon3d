{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "linux-ci-core-gate",
      "hidden": false,
      "inherits": "base-linux",
      "displayName": "Linux CI Core Gate",
      "description": "Pre-merge core gate: tests enabled with CLI, text, video and optional rendering features disabled. Diagnostics and verification follow the canonical test policy.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_BUILD_CLI": "OFF",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_BENCHMARKS": "OFF",
        "CHRONON3D_ENABLE_TEXT": "OFF",
        "CHRONON3D_USE_BLEND2D": "OFF",
        "CHRONON3D_ENABLE_EXR": "OFF",
        "CHRONON3D_ENABLE_VIDEO": "OFF",
        "CHRONON3D_ENABLE_MESH": "OFF",
        "CHRONON3D_ENABLE_NATIVE_FFMPEG": "OFF",
        "CHRONON3D_ENABLE_TELEMETRY": "OFF",
        "CHRONON3D_ENABLE_TRACING": "OFF",
        "CHRONON3D_ENABLE_IPC": "OFF",
        "CHRONON3D_BUILD_DAEMON": "OFF",
        "CHRONON3D_UNITY_BUILD": "ON",
        "CMAKE_UNITY_BUILD_BATCH_SIZE": "16",
        "VCPKG_MANIFEST_FEATURES": "tests;ipc"
      }
    },
    {
      "name": "linux-ci-lean-gate",
      "hidden": false,
      "inherits": "base-linux",
      "displayName": "Linux CI Lean Gate",
      "description": "Pre-merge lean gate: CLI + text + Blend2D + tests, with video and benchmarks disabled. Diagnostics and verification follow the canonical test policy.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_BENCHMARKS": "OFF",
        "CHRONON3D_ENABLE_TEXT": "ON",
        "CHRONON3D_USE_BLEND2D": "ON",
        "CHRONON3D_ENABLE_EXR": "OFF",
        "CHRONON3D_ENABLE_VIDEO": "OFF",
        "CHRONON3D_ENABLE_MESH": "OFF",
        "CHRONON3D_ENABLE_NATIVE_FFMPEG": "OFF",
        "CHRONON3D_ENABLE_TELEMETRY": "OFF",
        "CHRONON3D_ENABLE_TRACING": "OFF",
        "CHRONON3D_UNITY_BUILD": "ON",
        "CMAKE_UNITY_BUILD_BATCH_SIZE": "16",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;tests;ipc"
      }
    },
    {
      "name": "linux-asan",
      "inherits": "base-linux",
      "displayName": "Linux ASan + UBSan",
      "description": "AddressSanitizer + UndefinedBehaviorSanitizer debug preset with tests, CLI, text and Blend2D enabled. Diagnostics are enabled by the canonical test policy.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_UNITY_BUILD": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_CLI_DEV": "ON",
        "CHRONON3D_ENABLE_TEXT": "ON",
        "CHRONON3D_USE_BLEND2D": "ON",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;tests;ipc"
      }
    },
    {
      "name": "linux-asan-native",
      "inherits": "base-linux",
      "displayName": "Linux ASan + UBSan (native FFmpeg decoder teardown gate)",
      "description": "AddressSanitizer + UndefinedBehaviorSanitizer preset for the native FFmpeg decoder teardown stress suite.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_UNITY_BUILD": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -O1 -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_ENABLE_VIDEO": "ON",
        "CHRONON3D_ENABLE_NATIVE_FFMPEG": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;tests;ipc"
      }
    },
    {
      "name": "linux-tsan",
      "inherits": "base-linux",
      "displayName": "Linux TSan",
      "description": "ThreadSanitizer debug preset with tests, CLI, text and Blend2D enabled. Unity build is disabled; diagnostics follow the canonical test policy.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_UNITY_BUILD": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_CLI_DEV": "ON",
        "CHRONON3D_ENABLE_TEXT": "ON",
        "CHRONON3D_USE_BLEND2D": "ON",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;tests;ipc"
      }
    },
    {
      "name": "linux-dev",
      "inherits": "base-linux",
      "displayName": "Linux Dev (daily inner loop)",
      "description": "Daily developer preset: CLI + telemetry + tests, Debug build, unity enabled. Bundled compositions are external.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_BENCHMARKS": "OFF",
        "CHRONON3D_ENABLE_EXR": "OFF",
        "CHRONON3D_ENABLE_VIDEO": "OFF",
        "CHRONON3D_ENABLE_MESH": "OFF",
        "CHRONON3D_ENABLE_NATIVE_FFMPEG": "OFF",
        "CHRONON3D_ENABLE_TELEMETRY": "ON",
        "CHRONON3D_ENABLE_TRACING": "OFF",
        "CHRONON3D_UNITY_BUILD": "ON",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;telemetry;tests;ipc"
      }
    },
    {
      "name": "linux-content-dev",
      "inherits": "base-linux",
      "displayName": "Linux Video Dev (legacy preset name)",
      "description": "Video development preset retained under the historical linux-content-dev name for compatibility. Bundled compositions are external.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_BUILD_BENCHMARKS": "OFF",
        "CHRONON3D_ENABLE_EXR": "OFF",
        "CHRONON3D_ENABLE_VIDEO": "ON",
        "CHRONON3D_ENABLE_MESH": "OFF",
        "CHRONON3D_ENABLE_NATIVE_FFMPEG": "OFF",
        "CHRONON3D_ENABLE_TELEMETRY": "OFF",
        "CHRONON3D_ENABLE_TRACING": "OFF",
        "CHRONON3D_UNITY_BUILD": "ON",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;tests;video;ipc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-ci-core-gate",
      "configurePreset": "linux-ci-core-gate",
      "targets": ["chronon3d_tests_fast"],
      "jobs": 16
    },
    {
      "name": "linux-ci-lean-gate",
      "configurePreset": "linux-ci-lean-gate",
      "targets": ["chronon3d_cli", "chronon3d_tests_fast"],
      "jobs": 16
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "targets": ["chronon3d_cli", "chronon3d_tests"],
      "jobs": 16
    },
    {
      "name": "linux-asan-native",
      "configurePreset": "linux-asan-native",
      "targets": ["chronon3d_native_decoder_teardown_tests"],
      "jobs": 20
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "targets": ["chronon3d_cli", "chronon3d_tests"],
      "jobs": 16
    },
    {
      "name": "linux-content-dev",
      "configurePreset": "linux-content-dev",
      "targets": ["chronon3d_cli"],
      "jobs": 16
    }
  ],
  "testPresets": [
    {
      "name": "linux-ci-core-gate-test",
      "configurePreset": "linux-ci-core-gate",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "linux-ci-lean-gate-test",
      "configurePreset": "linux-ci-lean-gate",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "linux-asan-test",
      "configurePreset": "linux-asan",
      "output": {"outputOnFailure": true},
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=1:detect_leaks=1:print_summary=1:print_stacktrace=1:fast_unwind_on_fatal=0:check_initialization_order=1:strict_init_order=1:strict_string_checks=1:detect_stack_use_after_return=1:detect_odr_violation=2:malloc_context_size=20",
        "UBSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:print_stacktrace=1:print_summary=1:report_error_type=1"
      }
    },
    {
      "name": "linux-asan-native-test",
      "configurePreset": "linux-asan-native",
      "output": {"outputOnFailure": true},
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=1:detect_leaks=1:print_summary=1:print_stacktrace=1:fast_unwind_on_fatal=0:check_initialization_order=1:strict_init_order=1:strict_string_checks=1:detect_stack_use_after_return=1:detect_odr_violation=2:malloc_context_size=20",
        "UBSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:print_stacktrace=1:print_summary=1:report_error_type=1"
      }
    },
    {
      "name": "linux-tsan-test",
      "configurePreset": "linux-tsan",
      "output": {"outputOnFailure": true},
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:abort_on_error=1:second_deadlock_stack=1:print_stacktrace=1:history_size=7:symbolize=1"
      }
    }
  ]
}
