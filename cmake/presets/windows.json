{
  "version": 6,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "win-release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "displayName": "Windows Release CI",
      "description": "Windows release CI preset matching the win/win-test aliases consumed by .github/workflows/ci.yml. IPC is off because the only transport implementation is the Linux memfd backend.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_ENABLE_IPC": "OFF",
        "CHRONON3D_ENABLE_VERIFICATION": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "win-gpu-release",
      "inherits": "win-release",
      "displayName": "Windows Release with Vulkan and CUDA",
      "description": "Windows Release build with Vulkan, CUDA interop prerequisites, native FFmpeg and the test suite enabled.",
      "binaryDir": "${sourceDir}/build/chronon/${presetName}",
      "cacheVariables": {
        "CHRONON3D_ENABLE_VULKAN": "ON",
        "CHRONON3D_ENABLE_CUDA_INTEROP": "ON",
        "CHRONON3D_ENABLE_VIDEO": "ON",
        "CHRONON3D_ENABLE_NATIVE_FFMPEG": "ON",
        "CHRONON3D_BUILD_C_API": "ON",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;vulkan;tests;native-ffmpeg"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win",
      "configurePreset": "win-release",
      "jobs": 4
    },
    {
      "name": "win-gpu",
      "configurePreset": "win-gpu-release",
      "jobs": 14
    }
  ],
  "testPresets": [
    {
      "name": "win-test",
      "configurePreset": "win-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-gpu-test",
      "configurePreset": "win-gpu-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
