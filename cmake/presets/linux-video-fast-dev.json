{
  "version": 6,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "linux-video-fast-dev",
      "inherits": "base-linux",
      "displayName": "Linux Video Fast Dev",
      "description": "GPU/video inner loop: Vulkan, CUDA interop, native FFmpeg, text and CLI; tests and benchmarks disabled.",
      "binaryDir": "${sourceDir}/build/chronon/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONON3D_BUILD_CLI": "ON",
        "CHRONON3D_BUILD_TESTS": "OFF",
        "CHRONON3D_BUILD_BENCHMARKS": "OFF",
        "CHRONON3D_ENABLE_VERIFICATION": "ON",
        "CHRONON3D_ENABLE_TEXT": "ON",
        "CHRONON3D_USE_BLEND2D": "ON",
        "CHRONON3D_ENABLE_EXR": "OFF",
        "CHRONON3D_ENABLE_SVG": "OFF",
        "CHRONON3D_ENABLE_VIDEO": "ON",
        "CHRONON3D_ENABLE_NATIVE_FFMPEG": "ON",
        "CHRONON3D_ENABLE_VULKAN": "ON",
        "CHRONON3D_ENABLE_CUDA_INTEROP": "ON",
        "CHRONON3D_ENABLE_MESH": "OFF",
        "CHRONON3D_ENABLE_TRACING": "OFF",
        "CHRONON3D_ENABLE_TELEMETRY": "OFF",
        "CHRONON3D_UNITY_BUILD": "ON",
        "CMAKE_UNITY_BUILD_BATCH_SIZE": "16",
        "CHRONON3D_DEV_SPLIT_DWARF": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;vulkan;ipc"
      }
    },
    {
      "name": "linux-video-test",
      "inherits": "linux-video-fast-dev",
      "displayName": "Linux Video GPU Tests",
      "description": "GPU/video test build using the canonical aggregate test targets.",
      "binaryDir": "${sourceDir}/build/chronon/${presetName}",
      "cacheVariables": {
        "CHRONON3D_BUILD_TESTS": "ON",
        "CHRONON3D_UNITY_BUILD": "OFF",
        "VCPKG_MANIFEST_FEATURES": "cli;blend2d;text;vulkan;tests"
      }
    },
    {
      "name": "linux-video-release",
      "inherits": "linux-video-fast-dev",
      "displayName": "Linux Video GPU Release",
      "description": "Optimized Vulkan/CUDA/native-FFmpeg worker runtime.",
      "binaryDir": "${sourceDir}/build/chronon/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONON3D_UNITY_BUILD": "ON",
        "CMAKE_UNITY_BUILD_BATCH_SIZE": "32",
        "CHRONON3D_DEV_SPLIT_DWARF": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-video-fast-dev",
      "configurePreset": "linux-video-fast-dev",
      "targets": ["chronon3d_cli"],
      "jobs": 20
    },
    {
      "name": "linux-video-test",
      "configurePreset": "linux-video-test",
      "targets": ["chronon3d_cli", "chronon3d_tests_video", "chronon3d_tests"],
      "jobs": 20
    },
    {
      "name": "linux-video-release",
      "configurePreset": "linux-video-release",
      "targets": ["chronon3d_cli"],
      "jobs": 20
    }
  ]
}
