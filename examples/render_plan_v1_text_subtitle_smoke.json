{
  "schema": "chronon.render-plan",
  "version": 1,
  "job_id": "render-plan-text-subtitle-smoke",
  "canvas": {
    "width": 640,
    "height": 360,
    "fps": 30,
    "duration_frames": 30
  },
  "layers": [
    {
      "id": "background",
      "type": "color",
      "color": [0.03, 0.03, 0.03, 1.0]
    },
    {
      "id": "title",
      "type": "text",
      "text": "Nome speciale",
      "font": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
      "font_size": 48,
      "position": [320, 120],
      "animation": {"preset": "fade_in"}
    },
    {
      "id": "subtitles",
      "type": "subtitle_track",
      "source": "examples/smoke.srt",
      "format": "srt",
      "preset": "minimal_white",
      "font": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
      "font_size": 28
    }
  ],
  "output": {
    "path": "/tmp/chronon-text-subtitle-smoke.mp4",
    "format": "mp4",
    "codec": "h264"
  }
}
