{
  "schema": "chronon.render-plan",
  "version": 1,
  "job_id": "first_script_overlay",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration_frames": 300
  },
  "layers": [
    {
      "id": "background",
      "type": "image",
      "asset": "assets/images/camera_reference.jpg",
      "box_width": 1920,
      "box_height": 1080,
      "fit": "cover",
      "start_frame": 0,
      "duration_frames": 300
    },
    {
      "id": "important_phrase_01",
      "type": "text",
      "text": "UNA NUOVA RIVOLUZIONE",
      "preset": "title_centered",
      "start_frame": 30,
      "duration_frames": 60,
      "animation": {
        "start_frame": 30,
        "duration_frames": 60,
        "preset": "fade_in"
      }
    },
    {
      "id": "vision_image",
      "type": "image",
      "asset": "assets/images/checker.png",
      "box_width": 700,
      "box_height": 600,
      "position": [430, 0],
      "fit": "contain",
      "start_frame": 120,
      "duration_frames": 90
    },
    {
      "id": "important_word_01",
      "type": "text",
      "text": "VISION PRO",
      "preset": "kinetic_word",
      "position": [-450, 250],
      "start_frame": 120,
      "duration_frames": 60
    }
  ],
  "output": {
    "path": "/tmp/chronon-script-overlay.mp4",
    "format": "mp4",
    "codec": "h264",
    "crf": 18
  }
}
