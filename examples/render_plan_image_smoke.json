{
  "schema": "chronon.render-plan",
  "version": 1,
  "job_id": "render-plan-image-smoke",
  "canvas": { "width": 1280, "height": 720, "fps": 30, "duration_frames": 90 },
  "layers": [
    {
      "id": "background",
      "type": "image",
      "asset": "assets/background.jpg",
      "box_width": 1280,
      "box_height": 720,
      "fit": "cover",
      "start_frame": 0,
      "duration_frames": 90
    },
    {
      "id": "image_overlay",
      "type": "image",
      "asset": "assets/apple.png",
      "box_width": 260,
      "box_height": 260,
      "fit": "contain",
      "position": [380, 0],
      "start_frame": 30,
      "duration_frames": 45
    }
  ],
  "output": { "path": "result.mp4", "format": "mp4", "codec": "h264" }
}
