#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Destination surfaces are canonical RGBA32F Linear Premultiplied storage
// images (see scene.cpp SurfaceDesc::make with PixelFormat::Rgba32Float);
// the glyph atlas is Rgba8Unorm (B8G8R8A8_UNORM / R8G8B8A8_UNORM), whose
// storage-image compatibility class is rgba8.
layout(set = 0, binding = 0, rgba32f) uniform image2D dst_image;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D atlas_image;

struct GpuGlyphStatic {
    uint run_index;
    uint atlas_page_and_flags;
    uint atlas_pos;
    uint atlas_size;
    float plane_left;
    float plane_top;
    float plane_right;
    float plane_bottom;
    uint draw_order;
    uint pad0;
    float origin_x;
    float origin_y;
};

struct GpuGlyphDynamic {
    float tracking_prefix;
    float selector_weight;
};

struct GpuTextRunDynamic {
    float tx;
    float ty;
    float sx;
    float sy;
    float opacity;
    uint color;
    uint visible_glyph_count;
    uint flags;
    uint stroke_color;
    uint shadow_color;
    uint effect_flags;
    uint distance_range_bits;
    float stroke_width;
    float shadow_dx;
    float shadow_dy;
    float shadow_blur;
    float selector_start;
    float selector_end;
    float selector_amount;
    float animator_tracking;
    float animator_position_x;
    float animator_position_y;
    float animator_blur;
    uint selector_unit_count;
    float animator_opacity;
    float animator_scale_x;
    float animator_scale_y;
    float animator_rotation_z;
    uint animator_fill_color;
    float animator_shear_x;
    float animator_shear_y;
    uint animator_reserved5;
};

layout(std430, set = 0, binding = 2) readonly buffer GlyphBuffer {
    GpuGlyphStatic glyphs[];
};

layout(std430, set = 0, binding = 3) readonly buffer RunBuffer {
    GpuTextRunDynamic runs[];
};

layout(std430, set = 0, binding = 4) readonly buffer TileCounters {
    uint tile_glyph_counts[];
};

layout(std430, set = 0, binding = 5) readonly buffer TileGlyphIndices {
    uint tile_glyph_indices[];
};

layout(std430, set = 0, binding = 6) readonly buffer GlyphDynamicBuffer {
    GpuGlyphDynamic glyph_dynamic[];
};

layout(push_constant) uniform PushConstants {
    uint tiles_x;
    uint tiles_y;
    uint max_glyphs_per_tile;
    uint dst_width;
    uint dst_height;
    float atlas_inv_w;
    float atlas_inv_h;
} params;

shared uint s_glyph_indices[256];
shared uint s_draw_orders[256];
shared uint s_count;
shared uint s_has_gel;
const int kGelTileSize = 16;
const int kGelHalo = 2;
const int kGelFieldSize = kGelTileSize + 2 * kGelHalo;
shared float s_gel_dist[kGelFieldSize][kGelFieldSize];
shared uint s_gel_owner[kGelFieldSize][kGelFieldSize];
shared float s_gel_v_coord[kGelFieldSize][kGelFieldSize];

// Fractional (bilinear) atlas tap for the prepared-glyph path.
//
// The sample coordinate `texel` is in texel-centre space (integer == the
// centre of that texel), derived from the glyph-local uv.  The tap is clamped
// to the glyph's OWN atlas rect with half-texel discipline: the second tap is
// pinned to the last in-rect texel and the coordinate itself is clamped to
// [0, size-1], so a filter kernel can never read the neighbouring glyph that
// shares the page, and never samples outside the rect's first/last centre.
// The atlas holds an MTSDF (or premultiplied RGBA) payload whose padding
// already covers the rect interior; the clamp is what makes the fractional
// read safe, not an assumption about the neighbour.
vec4 atlas_tap_bilinear(ivec2 rect_origin, int rect_w, int rect_h, vec2 texel) {
    const vec2 max_texel = vec2(float(rect_w) - 1.0, float(rect_h) - 1.0);
    texel = clamp(texel, vec2(0.0), max_texel);
    const ivec2 i0 = ivec2(floor(texel));
    const ivec2 i1 = min(i0 + ivec2(1), ivec2(rect_w - 1, rect_h - 1));
    const vec2 f = texel - vec2(i0);
    const vec4 c00 = imageLoad(atlas_image, rect_origin + ivec2(i0.x, i0.y));
    const vec4 c10 = imageLoad(atlas_image, rect_origin + ivec2(i1.x, i0.y));
    const vec4 c01 = imageLoad(atlas_image, rect_origin + ivec2(i0.x, i1.y));
    const vec4 c11 = imageLoad(atlas_image, rect_origin + ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec4 unpack_color(uint c) {
    float a = float((c >> 24) & 0xFFu) / 255.0;
    float b = float((c >> 16) & 0xFFu) / 255.0;
    float g = float((c >> 8)  & 0xFFu) / 255.0;
    float r = float( c        & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

// Per-glyph animator fill: lerps the run fill towards animator_fill_color by
// the selector weight when flag bit 10 (kTextRunFlagAnimatorFill) is set;
// otherwise the plain run color, so the path is an exact identity without an
// animated fill.
vec4 animated_fill_color(GpuTextRunDynamic run, float weight) {
    vec4 base = unpack_color(run.color);
    if ((run.flags & 0x400u) == 0u) return base;
    return mix(base, unpack_color(run.animator_fill_color), weight);
}

// C2-continuous cubic B-spline filter over the 4x4 atlas texel neighbourhood,
// clamped to the glyph's own atlas rect so it never bleeds into neighbours.
// Eliminates piecewise-constant bilinear normal facets and 8-bit UNORM8
// quantization steps on magnified curves and serifs.
float atlas_alpha_bspline(ivec2 rect_origin, int rect_w, int rect_h, vec2 texel) {
    const vec2 max_texel = vec2(float(rect_w) - 1.0, float(rect_h) - 1.0);
    texel = clamp(texel, vec2(0.0), max_texel);
    const ivec2 base = ivec2(floor(texel));
    const vec2 f = texel - vec2(base);
    const vec2 f2 = f * f;
    const vec2 f3 = f2 * f;
    const vec2 w0 = (1.0 - 3.0 * f + 3.0 * f2 - f3) * (1.0 / 6.0);
    const vec2 w1 = (4.0 - 6.0 * f2 + 3.0 * f3) * (1.0 / 6.0);
    const vec2 w2 = (1.0 + 3.0 * f + 3.0 * f2 - 3.0 * f3) * (1.0 / 6.0);
    const vec2 w3 = f3 * (1.0 / 6.0);
    const float wx[4] = float[4](w0.x, w1.x, w2.x, w3.x);
    const float wy[4] = float[4](w0.y, w1.y, w2.y, w3.y);
    const ivec2 max_idx = ivec2(rect_w - 1, rect_h - 1);
    float sum = 0.0;
    for (int dy = -1; dy <= 2; ++dy) {
        int y = clamp(base.y + dy, 0, max_idx.y);
        float row = 0.0;
        for (int dx = -1; dx <= 2; ++dx) {
            int x = clamp(base.x + dx, 0, max_idx.x);
            row += imageLoad(atlas_image, rect_origin + ivec2(x, y)).a * wx[dx + 1];
        }
        sum += row * wy[dy + 1];
    }
    return sum;
}

float atlas_alpha_smooth(ivec2 rect_origin, int rect_w, int rect_h,
                         vec2 texel, float texel_to_screen) {
    float center = atlas_alpha_bspline(rect_origin, rect_w, rect_h, texel);
    float wide_mix = clamp((texel_to_screen - 1.25) / 2.5, 0.0, 1.0);
    if (wide_mix <= 0.0) return center;
    const float r = 1.35;
    float ring = 0.25 * (
        atlas_alpha_bspline(rect_origin, rect_w, rect_h, texel + vec2(r, 0.0)) +
        atlas_alpha_bspline(rect_origin, rect_w, rect_h, texel - vec2(r, 0.0)) +
        atlas_alpha_bspline(rect_origin, rect_w, rect_h, texel + vec2(0.0, r)) +
        atlas_alpha_bspline(rect_origin, rect_w, rect_h, texel - vec2(0.0, r)));
    return mix(center, 0.45 * center + 0.55 * ring, wide_mix);
}

float smooth_union_distance(float a, float b, float smoothness) {
    if (!(smoothness > 0.0)) return max(a, b);
    float nearest = max(a, b);
    return nearest + log(exp(smoothness * (a - nearest)) +
                         exp(smoothness * (b - nearest))) / smoothness;
}

// Evaluate the composite TextRun signed distance in screen pixels at sample_pos
// across all gel glyphs binned into this tile.
float evaluate_composite_gel_distance(vec2 sample_pos, uint count,
                                      out uint owner_gid,
                                      out float owner_v_coord) {
    float d_composite = -1000.0;
    bool has_sample = false;
    float best_distance = -1000.0;
    uint best_gid = 0xFFFFFFFFu;
    float best_v_coord = 0.5;
    for (uint i = 0; i < count; ++i) {
        uint gid = s_glyph_indices[i];
        GpuGlyphStatic glyph = glyphs[gid];
        uint flags = (glyph.atlas_page_and_flags >> 16u) & 0xFFFFu;
        if ((flags & 1u) == 0u) continue;
        GpuTextRunDynamic run = runs[glyph.run_index];
        if ((run.effect_flags & 8u) == 0u) continue;
        if (run.visible_glyph_count != 0xFFFFFFFFu &&
            glyph.pad0 >= run.visible_glyph_count) continue;

        uint atlas_x = glyph.atlas_pos & 0xFFFFu;
        uint atlas_y = (glyph.atlas_pos >> 16u) & 0xFFFFu;
        uint atlas_w = glyph.atlas_size & 0xFFFFu;
        uint atlas_h = (glyph.atlas_size >> 16u) & 0xFFFFu;
        if (atlas_w == 0u || atlas_h == 0u) continue;

        float plane_w = glyph.plane_right - glyph.plane_left;
        float plane_h = glyph.plane_bottom - glyph.plane_top;
        if (plane_w <= 0.0 || plane_h <= 0.0) continue;

        float texel_to_screen = 0.5 *
            (abs(run.sx) * plane_w / float(atlas_w) +
             abs(run.sy) * plane_h / float(atlas_h));
        float reveal_weight = glyph_dynamic[gid].selector_weight;
        float tracking = glyph_dynamic[gid].tracking_prefix;
        vec2 animator_offset = vec2(
            run.animator_position_x * reveal_weight + tracking,
            run.animator_position_y * reveal_weight);
        vec2 animator_scale = vec2(
            1.0 + (run.animator_scale_x - 1.0) * reveal_weight,
            1.0 + (run.animator_scale_y - 1.0) * reveal_weight);
        vec2 scale_origin_compensation = vec2(0.0);
        if ((run.flags & 2u) != 0u) {
            scale_origin_compensation = vec2(run.sx, run.sy) *
                vec2(glyph.origin_x, glyph.origin_y) *
                (vec2(1.0) - animator_scale);
        }
        vec2 eff_scale = vec2(run.sx, run.sy) * animator_scale;
        if (abs(eff_scale.x) <= 1e-6 || abs(eff_scale.y) <= 1e-6) continue;
        vec2 local = (sample_pos - vec2(run.tx, run.ty) - animator_offset -
                      scale_origin_compensation) / eff_scale;
        if (run.animator_rotation_z != 0.0) {
            float angle = radians(run.animator_rotation_z * reveal_weight);
            float ca = cos(angle);
            float sa = sin(angle);
            vec2 d = local - vec2(glyph.origin_x, glyph.origin_y);
            local = vec2(glyph.origin_x, glyph.origin_y) +
                    vec2(d.x * ca + d.y * sa, -d.x * sa + d.y * ca);
        }
        if (run.animator_shear_x != 0.0 || run.animator_shear_y != 0.0) {
            float shx = run.animator_shear_x * reveal_weight;
            float shy = run.animator_shear_y * reveal_weight;
            float det = 1.0 - shx * shy;
            if (abs(det) > 1e-5) {
                vec2 d = local - vec2(glyph.origin_x, glyph.origin_y);
                float inv_det = 1.0 / det;
                local = vec2(glyph.origin_x, glyph.origin_y) +
                        vec2((d.x - shx * d.y) * inv_det,
                             (-shy * d.x + d.y) * inv_det);
            }
        }

        vec2 plane_min = vec2(glyph.plane_left, glyph.plane_top);
        vec2 plane_max = vec2(glyph.plane_right, glyph.plane_bottom);
        vec2 clamped_local = clamp(local, plane_min, plane_max);
        vec2 outside_px = (local - clamped_local) * abs(eff_scale);
        float outside_dist = length(outside_px);
        if (outside_dist > 4.0) continue;

        vec2 glyph_uv = (clamped_local - plane_min) / vec2(plane_w, plane_h);
        vec2 glyph_texel = glyph_uv * vec2(float(atlas_w), float(atlas_h)) - vec2(0.5);
        float distance_range = uintBitsToFloat(run.distance_range_bits);
        if (!(distance_range > 0.0)) distance_range = 8.0;

        float msd_smooth = atlas_alpha_smooth(
            ivec2(int(atlas_x), int(atlas_y)),
            int(atlas_w), int(atlas_h), glyph_texel, texel_to_screen);
        float d_glyph = (msd_smooth - 0.5) * distance_range * texel_to_screen - outside_dist;
        // Glyph-plane vertical coordinate: 0 at the bottom of the glyph quad,
        // 1 at the top (replaces the baseline-relative ramp that saturated).
        float v_coord = clamp(1.0 - glyph_uv.y, 0.0, 1.0);
        if (d_glyph > best_distance) {
            best_distance = d_glyph;
            best_gid = gid;
            best_v_coord = v_coord;
        }

        if (!has_sample) {
            d_composite = d_glyph;
            has_sample = true;
        } else {
            float u_max = max(d_composite, d_glyph);
            // Soft fusion is authorable and only blends glyphs near contact.
            // The exact union remains when disabled.
            if ((run.effect_flags & (1u << 10u)) != 0u) {
                float contact = smoothstep(
                    -1.25, 0.35, min(d_composite, d_glyph));
                float u_smooth = smooth_union_distance(
                    d_composite, d_glyph,
                    0.55 / max(texel_to_screen, 0.5));
                d_composite = mix(u_max, u_smooth, contact);
            } else {
                d_composite = u_max;
            }
        }
    }
    owner_gid = best_gid;
    owner_v_coord = best_v_coord;
    return d_composite;
}

float gel_dome_height(float u) {
    float u2 = u * u;
    float u3 = u2 * u;
    return u3 * (u * (u * 6.0 - 15.0) + 10.0);
}

float gel_dome_slope(float u) {
    return 6.0 * u * (1.0 - u);
}

float composite_gel_body_alpha(float d_surf, float radius_px,
                               uint effect_flags) {
    if ((effect_flags & 512u) == 0u) return 1.0;
    float u = clamp(max(d_surf, 0.0) / max(radius_px, 1e-4), 0.0, 1.0);
    float dome = gel_dome_height(u);
    float optical_thickness = clamp(0.35 + 1.45 * dome, 0.0, 2.0);
    // Scalar alpha is the source-over transmission contract at the composite
    // stage. The old path sampled dst_image here, but text is rasterized to a
    // transparent layer before the backdrop is connected by CompositeNode.
    return clamp(1.0 - exp(-1.2 * optical_thickness), 0.0, 1.0);
}

vec3 shade_composite_gel_surface(
    float d_surf,
    vec2 sdf_gradient,
    float curvature_variance,
    float v_grad,
    float texel_to_screen,
    vec4 base_color,
    uint effect_flags,
    uint light_params) {
    // Stroke half-width in screen pixels scales with texel_to_screen
    // (canonical MTSDF em_px = 64 -> bold stroke half-width is ~3.6 texels).
    // A razor-tight perimeter bevel radius (1.25 canonical em-texels) confines
    // the rounded volumetric slope to the outermost ~2 px lip and clamps the
    // stroke interior (u = 1) to a wide flat plateau with N = (0, 0, 1),
    // preserving the sharp typographic stem geometry and open counters instead
    // of inflating the character into a pillow/sausage.
    float radius_px = clamp(1.25 * texel_to_screen, 2.0, 32.0);
    float u = clamp(max(d_surf, 0.0) / radius_px, 0.0, 1.0);
    // Keep the GPU height and normal on the C2 smootherstep profile used by
    // text::gel::rounded_height(): h/r = 6u^5 - 15u^4 + 10u^3.
    float dome = gel_dome_height(u);
    uint diagnostic_mode = (effect_flags >> 6u) & 7u;
    if (diagnostic_mode == 1u) {
        float encoded_distance = 0.5 + 0.5 * clamp(d_surf / radius_px, -1.0, 1.0);
        return vec3(encoded_distance, 0.5, 1.0 - encoded_distance);
    }
    if (diagnostic_mode == 2u) {
        return vec3(dome);
    }
    // Diagnostic 6: hard 1-bit silhouette cut at the nominal glyph edge
    // (d_surf == 0, no antialias) to verify the font is not dilated.
    if (diagnostic_mode == 6u) {
        return vec3(d_surf >= 0.0 ? 1.0 : 0.0);
    }

    // 1. Saturated solid cyan-aqua plastic/gel face with vertical chiaroscuro
    //    gradient (bright cyan-turquoise body, non-punitive luminous lower half).
    float v_clamped = pow(clamp(v_grad, 0.0, 1.0), 0.85);
    vec3 c = clamp(base_color.rgb, vec3(0.0), vec3(1.0));
    float c_peak = max(c.r, max(c.g, max(c.b, 0.001)));
    vec3 c_norm = c / c_peak;
    // Radiant cyan-turquoise body with luminous medium-cyan base (no pitch-black navy):
    vec3 colBottom = vec3(0.00, 0.28, 0.58);
    vec3 colTop    = vec3(0.00, 0.90, 1.00);
    vec3 lower_body_tint = colBottom;
    vec3 upper_body_tint = colTop;
    vec3 plateau_tint = mix(lower_body_tint, upper_body_tint, v_clamped);
    vec3 edge_tint = plateau_tint * 0.80;
    vec3 face = mix(edge_tint, plateau_tint, smoothstep(0.0, 0.65, dome));

    // Stage 02 (GEL-01 Core + gradient mode): return the luminous face directly
    // with zero specular and zero rim.
    if ((effect_flags & 32u) != 0u) {
        return face;
    }

    // 2. Stage 03 (GEL-02 / GEL-03 Glossy surface): height & normal reconstruction.
    float dh_dd = gel_dome_slope(u);
    float dhdx = dh_dd * sdf_gradient.x;
    float dhdy = dh_dd * sdf_gradient.y;
    vec3 N = normalize(vec3(-dhdx, -dhdy, 1.0));
    if (diagnostic_mode == 3u) {
        return N * 0.5 + 0.5;
    }
    if (diagnostic_mode == 4u) {
        float normal_length = length(N);
        bool valid = !any(isnan(N)) && !any(isinf(N)) &&
                     !isnan(normal_length) && !isinf(normal_length) &&
                     abs(normal_length - 1.0) < 0.01;
        return valid ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    }
    // Diagnostic 7: white = flat plateau (N.z >= 0.999), red = curved bevel,
    // black = outside the silhouette.
    if (diagnostic_mode == 7u) {
        if (d_surf < 0.0) return vec3(0.0);
        return N.z >= 0.999 ? vec3(1.0) : vec3(1.0, 0.0, 0.0);
    }
    if (diagnostic_mode == 5u) {
        return vec3((effect_flags & 512u) != 0u ? 1.0 : 0.0,
                    composite_gel_body_alpha(d_surf, radius_px, effect_flags), 0.0);
    }

    // 4. Gel thickness / internal refraction: dark rim at the lower flank (N.y > 0 in screen space)
    float bottomRim = smoothstep(0.0, 0.6, N.y) * (1.0 - smoothstep(0.999, 0.95, N.z));
    face = mix(face, vec3(0.00, 0.12, 0.35), bottomRim * 0.70);

    // Overhead grazing directional light (in screen space y points down, so
    // azimuth = -1.5707963 points straight up).
    float azimuth = -1.5707963;
    float elevation = 0.18;
    if ((effect_flags & 16u) != 0u) {
        azimuth = float(light_params & 0xFFFFu) *
                      (6.28318530718 / 65535.0) - 3.14159265359;
        elevation = float((light_params >> 16u) & 0xFFFFu) / 65535.0;
    }
    float horizontal = sqrt(max(1.0 - elevation * elevation, 0.0));
    vec3 L = normalize(vec3(cos(azimuth) * horizontal,
                            sin(azimuth) * horizontal, elevation));
    vec3 V = vec3(0.0, 0.0, 1.0);
    vec3 H = normalize(L + V);

    // Directional diffuse + chiaroscuro between upper lit lip and lower shadowed bevel.
    float ndotl = dot(N, L);
    float half_lambert = clamp((ndotl + 0.42) / 1.42, 0.0, 1.0);
    half_lambert = half_lambert * half_lambert;
    float diffuse_term = mix(0.74, 1.22, half_lambert);

    // Rich cyan-blue bevel shade on the lower/shadowed bevel flank.
    float bevel_band = 1.0 - dome * dome;
    float flank_shade = (1.0 - half_lambert) * bevel_band;
    vec3 deep_bevel = clamp(c * vec3(0.06, 0.56, 0.96) + vec3(0.02, 0.14, 0.24) * c_peak, 0.0, 1.0);
    vec3 shaded_face = mix(face * diffuse_term, deep_bevel, 0.36 * flank_shade);

    // Selective Beer-Lambert absorption through the dome: minimal green loss
    // so the plateau preserves its vivid aqua-turquoise hue.
    const vec3 kGelAbsorption = vec3(0.36, 0.12, 0.01);
    shaded_face *= exp(-kGelAbsorption * dome);
    // Crisp cyan-aqua plateau boost so the flat interior reads as bright turquoise (~G=195..215, B=245..255).
    shaded_face += upper_body_tint * (0.38 * smoothstep(0.45, 0.95, dome) * (0.50 + 0.50 * v_clamped));

    // Toksvig geometric roughness from both SDF gradient length loss at medial
    // axes and screen-space Hessian curvature variance.
    float grad_len = length(sdf_gradient);
    float medial_roughness = clamp(1.0 - grad_len, 0.0, 0.85);
    float curv_roughness = clamp(sqrt(curvature_variance) * 1.2, 0.0, 0.85);
    float geom_roughness = clamp(max(medial_roughness, curv_roughness), 0.0, 0.85);

    // Razor-sharp Blinn-Phong specular blade restricted to the upper bevel lip
    // with blinding HDR intensity and icy green-white hue
    float isBevel = 1.0 - smoothstep(0.96, 0.999, N.z);
    float isUpper = smoothstep(0.10, 0.65, -N.y);
    float specMask = isBevel * isUpper;
    float ndoth = max(dot(N, H), 0.0);

    vec3 specularWhite = vec3(0.88, 1.00, 0.94) * (pow(ndoth, 40.0) * specMask * 4.5);

    // Dispersive bevel caustics: vibrant lime/emerald-cyan fringe on the upper lip,
    // deep indigo/violet-blue shift on the lower flank.
    vec3 caustic_tint = vec3(0.35, 1.00, 0.45);
    vec3 caustic_specular = caustic_tint * (1.60 * pow(ndoth, 24.0) * isUpper * isBevel);

    vec3 spectral_tint = vec3(0.05, 0.12, 0.75);
    vec3 spectral_specular = spectral_tint * (0.60 * bottomRim);

    // Grazing Fresnel rim along the outer contour.
    float fresnel = pow(1.0 - max(dot(N, V), 0.0), 3.0);
    float edge_coat = (1.0 - smoothstep(0.0, 1.2 * texel_to_screen, max(d_surf, 0.0))) *
                      smoothstep(-0.5, 0.2, d_surf);
    float rim_response = max(fresnel * isBevel, 0.38 * edge_coat);
    float rim_dir = 0.28 + 0.72 * max(dot(N.xy, L.xy), 0.0);
    vec3 rim_tint = mix(vec3(0.08, 0.76, 1.00),
                        vec3(0.34, 1.00, 0.38), isUpper);
    vec3 rim_light = rim_tint * (0.72 * rim_response * rim_dir);

    return shaded_face + caustic_specular +
           spectral_specular + specularWhite + rim_light;
}

void main() {
    const uint kOverflowBit = 0x80000000u;
    uint tx = gl_WorkGroupID.x;
    uint ty = gl_WorkGroupID.y;
    uint tile_idx = ty * params.tiles_x + tx;
    uint tid = gl_LocalInvocationIndex;

    if (tid == 0) {
        const uint raw_count = tile_glyph_counts[tile_idx];
        // Fail closed: a tile with more contributors than its bounded index
        // list is not partially rasterized.  Partial output would be a
        // correctness bug because the missing glyph depends on invocation
        // order.  The high bit is written by text_tile_bin atomically.
        s_count = (raw_count & kOverflowBit) != 0u
            ? 0u
            : min(min(raw_count, params.max_glyphs_per_tile), 256u);
        s_has_gel = 0u;
    }
    barrier();

    uint count = s_count;
    if (tid < count) {
        uint gid = tile_glyph_indices[tile_idx * params.max_glyphs_per_tile + tid];
        s_glyph_indices[tid] = gid;
        GpuGlyphStatic g = glyphs[gid];
        s_draw_orders[tid] = g.draw_order;
        uint g_flags = (g.atlas_page_and_flags >> 16u) & 0xFFFFu;
        if ((g_flags & 1u) != 0u && (runs[g.run_index].effect_flags & 8u) != 0u) {
            atomicOr(s_has_gel, 1u);
        }
    }
    barrier();

    // Keep painter order deterministic inside a tile. draw_order defaults to
    // source order on the C++ side, so this preserves text_batch semantics
    // while allowing explicit ordering when the planner supplies it.
    if (tid == 0 && count > 1) {
        for (uint i = 1; i < count; ++i) {
            uint key_g = s_glyph_indices[i];
            uint key_order = s_draw_orders[i];
            int j = int(i) - 1;
            while (j >= 0 && s_draw_orders[j] > key_order) {
                s_glyph_indices[j + 1] = s_glyph_indices[j];
                s_draw_orders[j + 1] = s_draw_orders[j];
                --j;
            }
            s_glyph_indices[j + 1] = key_g;
            s_draw_orders[j + 1] = key_order;
        }
    }
    barrier();

    // Build the 18x18 screen-space composite TextRun distance field for gel
    // tiles BEFORE the out-of-bounds early exit so all workgroup barriers
    // execute in uniform control flow.
    if (s_has_gel != 0u) {
        ivec2 tile_origin = ivec2(int(tx) * kGelTileSize, int(ty) * kGelTileSize);
        const uint field_samples = uint(kGelFieldSize * kGelFieldSize);
        for (uint sample_idx = tid; sample_idx < field_samples; sample_idx += 256u) {
            int sy = int(sample_idx / uint(kGelFieldSize));
            int sx = int(sample_idx - uint(sy) * uint(kGelFieldSize));
            vec2 sample_pos = vec2(tile_origin + ivec2(sx - kGelHalo, sy - kGelHalo)) + vec2(0.5);
            uint owner = 0xFFFFFFFFu;
            float v_coord = 0.5;
            s_gel_dist[sy][sx] = evaluate_composite_gel_distance(
                sample_pos, count, owner, v_coord);
            s_gel_owner[sy][sx] = owner;
            s_gel_v_coord[sy][sx] = v_coord;
        }
        barrier();
    }

    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(params.dst_width) || pixel_coord.y >= int(params.dst_height)) {
        return;
    }

    // Keep the destination, the union shadow mask, the complete-string stroke
    // pass, and the complete-string fill pass in separate layers.  The
    // canonical contract is exactly: shadow -> stroke -> fill.  In
    // particular, never let a later glyph's stroke blend over an earlier
    // glyph's fill merely because the tile loop visits glyphs one by one.
    vec4 destination_color = imageLoad(dst_image, pixel_coord);
    vec4 shadow_layer = vec4(0.0);
    vec4 stroke_layer = vec4(0.0);
    vec4 fill_layer = vec4(0.0);


    for (uint i = 0; i < count; ++i) {
        uint gid = s_glyph_indices[i];
        GpuGlyphStatic glyph = glyphs[gid];
        GpuTextRunDynamic run = runs[glyph.run_index];
        float reveal_weight = glyph_dynamic[gid].selector_weight;
        if (run.visible_glyph_count != 0xFFFFFFFFu &&
            glyph.pad0 >= run.visible_glyph_count) continue;

        uint atlas_x = glyph.atlas_pos & 0xFFFFu;
        uint atlas_y = (glyph.atlas_pos >> 16u) & 0xFFFFu;
        uint atlas_w = glyph.atlas_size & 0xFFFFu;
        uint atlas_h = (glyph.atlas_size >> 16u) & 0xFFFFu;
        if (atlas_w == 0u || atlas_h == 0u) continue;

        uint flags = (glyph.atlas_page_and_flags >> 16u) & 0xFFFFu;
        bool mtsdf = (flags & 1u) != 0u;
        // Plane placement is the prepared-run path (MTSDF payload, or a
        // coverage payload driven through the prepared plane).  It is the only
        // path that carries the full glyph rect, and therefore the only path
        // that can be sampled fractionally under a half-texel clamp.
        bool plane_placement = mtsdf || (run.flags & 1u) != 0u;
        bool inside = false;
        ivec2 sample_offset = ivec2(0);
        vec2 glyph_uv = vec2(0.0);
        // Fractional texel-centre coordinate inside the glyph's atlas rect.
        vec2 glyph_texel = vec2(0.0);
        // Screen-space coverage factors, both derived from the SAME plane
        // geometry so they cannot drift apart:
        //   texel_to_screen — destination pixels covered by one em-texel.  The
        //     plane spans `plane_w` layout units for `atlas_w` texels (their
        //     ratio IS the layout scale, font size / em_px), which the run's
        //     model matrix maps to destination pixels by |sx|.  This is the
        //     factor the distance field must be scaled by: it makes the
        //     analytic anti-aliasing ramp exactly one destination pixel wide
        //     at any font size (magnified or minified) instead of only at the
        //     canonical 64 px em.
        //   local_to_screen — destination pixels covered by one layout unit.
        //     Authored paint-space quantities (blur, stroke width) live here,
        //     not in texels.
        float texel_to_screen = 1.0;
        float local_to_screen = 1.0;

        if (plane_placement) {
            float plane_w = glyph.plane_right - glyph.plane_left;
            float plane_h = glyph.plane_bottom - glyph.plane_top;
            if (plane_w <= 0.0 || plane_h <= 0.0) continue;
            local_to_screen = 0.5 * (abs(run.sx) + abs(run.sy));
            texel_to_screen = 0.5 *
                (abs(run.sx) * plane_w / float(atlas_w) +
                 abs(run.sy) * plane_h / float(atlas_h));

            vec2 pixel_pos = vec2(pixel_coord) + vec2(0.5);
            float tracking = glyph_dynamic[gid].tracking_prefix;
            vec2 animator_offset = vec2(
                run.animator_position_x * reveal_weight + tracking,
                run.animator_position_y * reveal_weight);
            vec2 animator_scale = vec2(
                1.0 + (run.animator_scale_x - 1.0) * reveal_weight,
                1.0 + (run.animator_scale_y - 1.0) * reveal_weight);
            vec2 scale_origin_compensation = vec2(0.0);
            if ((run.flags & 2u) != 0u) {
                // Per-glyph scale must preserve the glyph's layout origin.
                // Without this term, a glyph at x=500 acquires an unintended
                // 500*(scale-1) translation and the phrase visibly trembles.
                scale_origin_compensation = vec2(run.sx, run.sy) *
                    vec2(glyph.origin_x, glyph.origin_y) *
                    (vec2(1.0) - animator_scale);
            }
            vec2 local = (pixel_pos - vec2(run.tx, run.ty) - animator_offset -
                          scale_origin_compensation) /
                         (vec2(run.sx, run.sy) * animator_scale);
            // Per-glyph in-plane rotation around the glyph layout origin (the
            // same pivot the scale compensation above preserves). Forward is
            // a +degrees rotation in layout space; this is its inverse. For a
            // uniform animator scale the composition order against scale is
            // immaterial, which is the canonical per-glyph contract.
            if (run.animator_rotation_z != 0.0) {
                float angle = radians(run.animator_rotation_z * reveal_weight);
                float ca = cos(angle);
                float sa = sin(angle);
                vec2 d = local - vec2(glyph.origin_x, glyph.origin_y);
                local = vec2(glyph.origin_x, glyph.origin_y) +
                        vec2(d.x * ca + d.y * sa, -d.x * sa + d.y * ca);
            }
            if (run.animator_shear_x != 0.0 || run.animator_shear_y != 0.0) {
                float shx = run.animator_shear_x * reveal_weight;
                float shy = run.animator_shear_y * reveal_weight;
                float det = 1.0 - shx * shy;
                if (abs(det) > 1e-5) {
                    vec2 d = local - vec2(glyph.origin_x, glyph.origin_y);
                    float inv_det = 1.0 / det;
                    local = vec2(glyph.origin_x, glyph.origin_y) +
                            vec2((d.x - shx * d.y) * inv_det,
                                 (-shy * d.x + d.y) * inv_det);
                }
            }
            inside = local.x >= glyph.plane_left && local.x < glyph.plane_right &&
                     local.y >= glyph.plane_top  && local.y < glyph.plane_bottom;
            if (inside) {
                glyph_uv = (local - vec2(glyph.plane_left, glyph.plane_top)) /
                           vec2(plane_w, plane_h);
                // Texel-centre space: texel i owns uv in [i, i+1)/size and is
                // centred at (i+0.5)/size, so the continuous index is
                // uv*size - 0.5.
                glyph_texel = glyph_uv * vec2(float(atlas_w), float(atlas_h)) -
                              vec2(0.5);
                sample_offset = ivec2(floor(glyph_uv *
                                             vec2(float(atlas_w), float(atlas_h))));
            }
        } else {
            // Legacy bitmap-origin placement retained for compatibility
            // callers; prepared runs opt into plane placement above.
            if (run.sx <= 0.0 || run.sy <= 0.0) continue;
            vec2 local = vec2(pixel_coord) - vec2(round(run.tx), round(run.ty));
            vec2 scaled_size = ceil(vec2(atlas_w, atlas_h) * vec2(run.sx, run.sy));
            inside = local.x >= 0.0 && local.y >= 0.0 &&
                     local.x < scaled_size.x && local.y < scaled_size.y;
            if (inside) {
                sample_offset = ivec2(floor(local / vec2(run.sx, run.sy)));
            }
        }

        if (!inside) continue;
        const ivec2 atlas_origin = ivec2(int(atlas_x), int(atlas_y));
        // The prepared path reads FRACTIONALLY; the compatibility
        // bitmap-origin path keeps its nearest read and its own clamp.
        vec4 sample_value = plane_placement
            ? atlas_tap_bilinear(atlas_origin, int(atlas_w), int(atlas_h), glyph_texel)
            : imageLoad(atlas_image, atlas_origin +
                        clamp(sample_offset, ivec2(0),
                              ivec2(int(atlas_w) - 1, int(atlas_h) - 1)));

        vec4 src;
        if (mtsdf) {
            // The custom MTSDF generator assigns RGB edge channels with a
            // simple i % 3 scheme; those channels are not reliably
            // median-combinable. Alpha stores the true signed distance and is
            // also the channel used by DirectYUV, so every Vulkan text effect
            // reconstructs coverage from the same field.
            float msd = sample_value.a;
            float distance_range = uintBitsToFloat(run.distance_range_bits);
            if (!(distance_range > 0.0)) distance_range = 8.0;
            float glyph_blur = max(run.animator_blur * reveal_weight, 0.0);
            float fill_alpha = clamp((msd - 0.5) * distance_range * texel_to_screen +
                                     0.5, 0.0, 1.0);
            if (glyph_blur > 0.0) {
                float softness = max(glyph_blur * local_to_screen, 1.0);
                fill_alpha = clamp(0.5 + ((msd - 0.5) * distance_range * texel_to_screen) /
                                   softness, 0.0, 1.0);
            }
            src = vec4(0.0);
            if ((run.effect_flags & 2u) != 0u ||
                (run.effect_flags & 4u) != 0u) {
                vec2 shadow_uv = glyph_uv -
                    vec2(run.shadow_dx / (glyph.plane_right - glyph.plane_left),
                         run.shadow_dy / (glyph.plane_bottom - glyph.plane_top));
                if (all(greaterThanEqual(shadow_uv, vec2(0.0))) &&
                    all(lessThan(shadow_uv, vec2(1.0)))) {
                    vec2 shadow_texel =
                        shadow_uv * vec2(float(atlas_w), float(atlas_h)) - vec2(0.5);
                    vec4 shadow_sample = atlas_tap_bilinear(
                        atlas_origin, int(atlas_w), int(atlas_h), shadow_texel);
                    // Use the alpha lane's true signed distance, matching the
                    // fill and the DirectYUV text path.
                    // Keep the soft edge below the baked distance range: the
                    // atlas intentionally clamps distances outside its
                    // padding, so asking for a wider transition would make
                    // the clamped rectangular plane contribute again.
                    float shadow_msd = shadow_sample.a;
                    float shadow_distance_px =
                        (shadow_msd - 0.5) * distance_range * texel_to_screen;
                    // The authored blur is a paint-space width, while the cap
                    // is the field's own representable softness: at most 0.48
                    // of the encoded distance range, expressed in screen pixels.
                    // Capping below 0.5 ensures that the smoothstep lower bound
                    // (-shadow_softness_px) is reached before the distance field
                    // clamp endpoint (shadow_msd = 0.0), eliminating rectangular
                    // / circular cutoff step discontinuities around glyphs.
                    float shadow_softness_px = clamp(
                        run.shadow_blur * local_to_screen,
                        0.0, max(distance_range * 0.48 * texel_to_screen, 0.0));
                    float edge_fade = smoothstep(0.01, 0.08, shadow_msd);
                    float shadow_alpha = (shadow_msd <= (1.0 / 255.0))
                        ? 0.0
                        : (shadow_softness_px > 0.0
                            ? smoothstep(-shadow_softness_px, 0.0,
                                         shadow_distance_px) * edge_fade
                            : step(0.0, shadow_distance_px));
                    vec4 glyph_shadow = unpack_color(run.shadow_color) * shadow_alpha;
                    if (glyph_shadow.a > shadow_layer.a) {
                        shadow_layer = glyph_shadow;
                    }
                }
            }
            if ((run.effect_flags & 1u) != 0u) {
                // Field distance and authored stroke width are converted from
                // their own spaces into destination pixels before they are
                // compared, instead of scaling both by one factor that can
                // only be right for one of them.
                // `stroke_width` is the authored OUTLINE width, therefore the
                // signed field is expanded by its radius, not by the full
                // diameter.  Expanding by the full width makes every padded
                // texel of the glyph plane pass the stroke test and produces
                // the opaque rectangular boxes seen around projected text.
                // Stroke and fill use the same alpha distance field. The RGB
                // median is not valid for this generator's naive edge coloring
                // and can create broken or one-sided contours.
                float stroke_alpha = clamp(
                    (msd - 0.5) * distance_range * texel_to_screen +
                    0.5 * run.stroke_width * local_to_screen + 0.5, 0.0, 1.0);
                vec4 stroke = unpack_color(run.stroke_color) * stroke_alpha;
                stroke *= run.opacity * (1.0 + (run.animator_opacity - 1.0) * reveal_weight);
                stroke_layer = stroke + stroke_layer * (1.0 - stroke.a);
            }
            vec4 fill = animated_fill_color(run, reveal_weight);
            float run_op = run.opacity * (1.0 + (run.animator_opacity - 1.0) * reveal_weight);
            if ((run.effect_flags & 8u) != 0u) {
                // GEL-01: the composite TextRun silhouette is shaded once,
                // after the glyph loop, from the shared distance field. Per-
                // glyph alpha here would keep overlapping glyphs as separate
                // surfaces with hard intersections.
            } else {
                fill *= fill_alpha;
                fill *= run_op;
                fill_layer = fill + fill_layer * (1.0 - fill.a);
            }
        } else {
            src = sample_value;
            if ((run.flags & 0x400u) != 0u ||
                (run.color != 0xFFFFFFFFu && run.color != 0u)) {
                src *= animated_fill_color(run, reveal_weight);
            }
            src *= run.opacity * (1.0 + (run.animator_opacity - 1.0) * reveal_weight);
            fill_layer = src + fill_layer * (1.0 - src.a);
        }

    }

    if (s_has_gel != 0u) {
        int lx = int(gl_LocalInvocationID.x);
        int ly = int(gl_LocalInvocationID.y);
        const int cx = lx + kGelHalo;
        const int cy = ly + kGelHalo;
        float d_surf = s_gel_dist[cy][cx];
        // One screen-pixel antialias ramp from the composite TextRun field.
        // This is the silhouette union: coverage is no longer the max of the
        // per-glyph atlas alphas, so touching/overlapping glyphs share one
        // surface and one highlight.
        float gel_coverage = clamp(d_surf + 0.5, 0.0, 1.0);
        uint owner_gid = s_gel_owner[cy][cx];
        if (owner_gid != 0xFFFFFFFFu) {
            GpuGlyphStatic owner = glyphs[owner_gid];
            GpuTextRunDynamic owner_run = runs[owner.run_index];
            uint diagnostic_mode = (owner_run.effect_flags >> 6u) & 7u;
            if (gel_coverage > 0.0 || diagnostic_mode == 1u) {
            float d_l2 = s_gel_dist[cy][cx - kGelHalo];
            float d_r2 = s_gel_dist[cy][cx + kGelHalo];
            float d_t2 = s_gel_dist[cy - kGelHalo][cx];
            float d_b2 = s_gel_dist[cy + kGelHalo][cx];
            // Four-pixel central difference: a wider stencil suppresses the
            // per-texel discontinuities that produced faceted highlights on
            // magnified glyphs, while the exact 3x3 Hessian stays local.
            vec2 sdf_gradient = vec2(d_r2 - d_l2, d_b2 - d_t2) * 0.25;

            float d_l = s_gel_dist[cy][cx - 1];
            float d_r = s_gel_dist[cy][cx + 1];
            float d_t = s_gel_dist[cy - 1][cx];
            float d_b = s_gel_dist[cy + 1][cx];
            float d_tl = s_gel_dist[cy - 1][cx - 1];
            float d_tr = s_gel_dist[cy - 1][cx + 1];
            float d_bl = s_gel_dist[cy + 1][cx - 1];
            float d_br = s_gel_dist[cy + 1][cx + 1];
            float d2x = d_r - 2.0 * d_surf + d_l;
            float d2y = d_b - 2.0 * d_surf + d_t;
            float d2xy = 0.25 * (d_br - d_bl - d_tr + d_tl);
            float curvature_variance = d2x * d2x + d2y * d2y +
                                       2.0 * d2xy * d2xy;

            float owner_reveal = glyph_dynamic[owner_gid].selector_weight;
            float owner_texel_to_screen = 1.0;
            uint owner_atlas_w = owner.atlas_size & 0xFFFFu;
            uint owner_atlas_h = (owner.atlas_size >> 16u) & 0xFFFFu;
            float owner_plane_w = owner.plane_right - owner.plane_left;
            float owner_plane_h = owner.plane_bottom - owner.plane_top;
            if (owner_atlas_w != 0u && owner_atlas_h != 0u &&
                owner_plane_w > 0.0 && owner_plane_h > 0.0) {
                owner_texel_to_screen = 0.5 *
                    (abs(owner_run.sx) * owner_plane_w / float(owner_atlas_w) +
                     abs(owner_run.sy) * owner_plane_h / float(owner_atlas_h));
            }
            vec4 owner_fill = animated_fill_color(owner_run, owner_reveal);
            float owner_opacity = owner_run.opacity *
                (1.0 + (owner_run.animator_opacity - 1.0) * owner_reveal);
            float owner_v_grad = s_gel_v_coord[cy][cx];

            vec3 lit = shade_composite_gel_surface(
                d_surf, sdf_gradient, curvature_variance, owner_v_grad,
                owner_texel_to_screen, owner_fill, owner_run.effect_flags,
                owner_run.animator_reserved5);
            float body_alpha = composite_gel_body_alpha(
                d_surf, clamp(0.85 * owner_texel_to_screen, 1.0, 32.0),
                owner_run.effect_flags);
            vec4 gel_fill = vec4(lit, 1.0) *
                (owner_fill.a * gel_coverage * owner_opacity * body_alpha);
            if (diagnostic_mode != 0u) {
                gel_fill = vec4(lit, 1.0) * owner_opacity;
            }
            // The distance visualization shows a controlled four-pixel
            // exterior band. Pixels farther outside the composite mask stay
            // transparent so the per-glyph atlas planes cannot appear as
            // filled rectangles in the diagnostic image.
            if (diagnostic_mode == 1u && d_surf < -4.0) {
                gel_fill = vec4(0.0);
            }
            fill_layer = gel_fill + fill_layer * (1.0 - gel_fill.a);
            }
        }
    }

    vec4 current_color = shadow_layer + destination_color * (1.0 - shadow_layer.a);
    current_color = stroke_layer + current_color * (1.0 - stroke_layer.a);
    current_color = fill_layer + current_color * (1.0 - fill_layer.a);
    imageStore(dst_image, pixel_coord, current_color);
}
