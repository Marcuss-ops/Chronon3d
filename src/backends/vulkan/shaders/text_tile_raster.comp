#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Destination surfaces are canonical RGBA32F Linear Premultiplied storage
// images (see scene.cpp SurfaceDesc::make with PixelFormat::Rgba32Float);
// the glyph atlas is Rgba8Unorm (B8G8R8A8_UNORM / R8G8B8A8_UNORM), whose
// storage-image compatibility class is rgba8.
layout(set = 0, binding = 0, rgba32f) uniform image2D dst_image;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D atlas_image;

struct GpuGlyphStatic {
    uint run_index;
    uint atlas_page_and_flags;
    uint atlas_pos;
    uint atlas_size;
    float plane_left;
    float plane_top;
    float plane_right;
    float plane_bottom;
    uint draw_order;
    uint pad0;
    float origin_x;
    float origin_y;
};

struct GpuGlyphDynamic {
    float tracking_prefix;
    float selector_weight;
};

struct GpuTextRunDynamic {
    float tx;
    float ty;
    float sx;
    float sy;
    float opacity;
    uint color;
    uint visible_glyph_count;
    uint flags;
    uint stroke_color;
    uint shadow_color;
    uint effect_flags;
    uint distance_range_bits;
    float stroke_width;
    float shadow_dx;
    float shadow_dy;
    float shadow_blur;
    float selector_start;
    float selector_end;
    float selector_amount;
    float animator_tracking;
    float animator_position_x;
    float animator_position_y;
    float animator_blur;
    uint selector_unit_count;
    float animator_opacity;
    float animator_scale_x;
    float animator_scale_y;
    float animator_reserved2;
};

layout(std430, set = 0, binding = 2) readonly buffer GlyphBuffer {
    GpuGlyphStatic glyphs[];
};

layout(std430, set = 0, binding = 3) readonly buffer RunBuffer {
    GpuTextRunDynamic runs[];
};

layout(std430, set = 0, binding = 4) readonly buffer TileCounters {
    uint tile_glyph_counts[];
};

layout(std430, set = 0, binding = 5) readonly buffer TileGlyphIndices {
    uint tile_glyph_indices[];
};

layout(std430, set = 0, binding = 6) readonly buffer GlyphDynamicBuffer {
    GpuGlyphDynamic glyph_dynamic[];
};

layout(push_constant) uniform PushConstants {
    uint tiles_x;
    uint tiles_y;
    uint max_glyphs_per_tile;
    uint dst_width;
    uint dst_height;
    float atlas_inv_w;
    float atlas_inv_h;
} params;

shared uint s_glyph_indices[256];
shared uint s_draw_orders[256];
shared uint s_count;

float median3(float r, float g, float b) {
    return max(min(r, g), min(max(r, g), b));
}

// Fractional (bilinear) atlas tap for the prepared-glyph path.
//
// The sample coordinate `texel` is in texel-centre space (integer == the
// centre of that texel), derived from the glyph-local uv.  The tap is clamped
// to the glyph's OWN atlas rect with half-texel discipline: the second tap is
// pinned to the last in-rect texel and the coordinate itself is clamped to
// [0, size-1], so a filter kernel can never read the neighbouring glyph that
// shares the page, and never samples outside the rect's first/last centre.
// The atlas holds an MTSDF (or premultiplied RGBA) payload whose padding
// already covers the rect interior; the clamp is what makes the fractional
// read safe, not an assumption about the neighbour.
vec4 atlas_tap_bilinear(ivec2 rect_origin, int rect_w, int rect_h, vec2 texel) {
    const vec2 max_texel = vec2(float(rect_w) - 1.0, float(rect_h) - 1.0);
    texel = clamp(texel, vec2(0.0), max_texel);
    const ivec2 i0 = ivec2(floor(texel));
    const ivec2 i1 = min(i0 + ivec2(1), ivec2(rect_w - 1, rect_h - 1));
    const vec2 f = texel - vec2(i0);
    const vec4 c00 = imageLoad(atlas_image, rect_origin + ivec2(i0.x, i0.y));
    const vec4 c10 = imageLoad(atlas_image, rect_origin + ivec2(i1.x, i0.y));
    const vec4 c01 = imageLoad(atlas_image, rect_origin + ivec2(i0.x, i1.y));
    const vec4 c11 = imageLoad(atlas_image, rect_origin + ivec2(i1.x, i1.y));
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

vec4 unpack_color(uint c) {
    float a = float((c >> 24) & 0xFFu) / 255.0;
    float b = float((c >> 16) & 0xFFu) / 255.0;
    float g = float((c >> 8)  & 0xFFu) / 255.0;
    float r = float( c        & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

void main() {
    const uint kOverflowBit = 0x80000000u;
    uint tx = gl_WorkGroupID.x;
    uint ty = gl_WorkGroupID.y;
    uint tile_idx = ty * params.tiles_x + tx;
    uint tid = gl_LocalInvocationIndex;

    if (tid == 0) {
        const uint raw_count = tile_glyph_counts[tile_idx];
        // Fail closed: a tile with more contributors than its bounded index
        // list is not partially rasterized.  Partial output would be a
        // correctness bug because the missing glyph depends on invocation
        // order.  The high bit is written by text_tile_bin atomically.
        s_count = (raw_count & kOverflowBit) != 0u
            ? 0u
            : min(min(raw_count, params.max_glyphs_per_tile), 256u);
    }
    barrier();

    uint count = s_count;
    if (tid < count) {
        uint gid = tile_glyph_indices[tile_idx * params.max_glyphs_per_tile + tid];
        s_glyph_indices[tid] = gid;
        s_draw_orders[tid] = glyphs[gid].draw_order;
    }
    barrier();

    // Keep painter order deterministic inside a tile. draw_order defaults to
    // source order on the C++ side, so this preserves text_batch semantics
    // while allowing explicit ordering when the planner supplies it.
    if (tid == 0 && count > 1) {
        for (uint i = 1; i < count; ++i) {
            uint key_g = s_glyph_indices[i];
            uint key_order = s_draw_orders[i];
            int j = int(i) - 1;
            while (j >= 0 && s_draw_orders[j] > key_order) {
                s_glyph_indices[j + 1] = s_glyph_indices[j];
                s_draw_orders[j + 1] = s_draw_orders[j];
                --j;
            }
            s_glyph_indices[j + 1] = key_g;
            s_draw_orders[j + 1] = key_order;
        }
    }
    barrier();

    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(params.dst_width) || pixel_coord.y >= int(params.dst_height)) {
        return;
    }

    // Keep the destination, the union shadow mask, the complete-string stroke
    // pass, and the complete-string fill pass in separate layers.  The
    // canonical contract is exactly: shadow -> stroke -> fill.  In
    // particular, never let a later glyph's stroke blend over an earlier
    // glyph's fill merely because the tile loop visits glyphs one by one.
    vec4 destination_color = imageLoad(dst_image, pixel_coord);
    vec4 shadow_layer = vec4(0.0);
    vec4 stroke_layer = vec4(0.0);
    vec4 fill_layer = vec4(0.0);

    for (uint i = 0; i < count; ++i) {
        uint gid = s_glyph_indices[i];
        GpuGlyphStatic glyph = glyphs[gid];
        GpuTextRunDynamic run = runs[glyph.run_index];
        float reveal_weight = glyph_dynamic[gid].selector_weight;
        if (run.visible_glyph_count != 0xFFFFFFFFu &&
            glyph.pad0 >= run.visible_glyph_count) continue;

        uint atlas_x = glyph.atlas_pos & 0xFFFFu;
        uint atlas_y = (glyph.atlas_pos >> 16u) & 0xFFFFu;
        uint atlas_w = glyph.atlas_size & 0xFFFFu;
        uint atlas_h = (glyph.atlas_size >> 16u) & 0xFFFFu;
        if (atlas_w == 0u || atlas_h == 0u) continue;

        uint flags = (glyph.atlas_page_and_flags >> 16u) & 0xFFFFu;
        bool mtsdf = (flags & 1u) != 0u;
        // Plane placement is the prepared-run path (MTSDF payload, or a
        // coverage payload driven through the prepared plane).  It is the only
        // path that carries the full glyph rect, and therefore the only path
        // that can be sampled fractionally under a half-texel clamp.
        bool plane_placement = mtsdf || (run.flags & 1u) != 0u;
        bool inside = false;
        ivec2 sample_offset = ivec2(0);
        vec2 glyph_uv = vec2(0.0);
        // Fractional texel-centre coordinate inside the glyph's atlas rect.
        vec2 glyph_texel = vec2(0.0);
        // Screen-space coverage factors, both derived from the SAME plane
        // geometry so they cannot drift apart:
        //   texel_to_screen — destination pixels covered by one em-texel.  The
        //     plane spans `plane_w` layout units for `atlas_w` texels (their
        //     ratio IS the layout scale, font size / em_px), which the run's
        //     model matrix maps to destination pixels by |sx|.  This is the
        //     factor the distance field must be scaled by: it makes the
        //     analytic anti-aliasing ramp exactly one destination pixel wide
        //     at any font size (magnified or minified) instead of only at the
        //     canonical 64 px em.
        //   local_to_screen — destination pixels covered by one layout unit.
        //     Authored paint-space quantities (blur, stroke width) live here,
        //     not in texels.
        float texel_to_screen = 1.0;
        float local_to_screen = 1.0;

        if (plane_placement) {
            float plane_w = glyph.plane_right - glyph.plane_left;
            float plane_h = glyph.plane_bottom - glyph.plane_top;
            if (plane_w <= 0.0 || plane_h <= 0.0) continue;
            local_to_screen = 0.5 * (abs(run.sx) + abs(run.sy));
            texel_to_screen = 0.5 *
                (abs(run.sx) * plane_w / float(atlas_w) +
                 abs(run.sy) * plane_h / float(atlas_h));

            vec2 pixel_pos = vec2(pixel_coord) + vec2(0.5);
            float tracking = glyph_dynamic[gid].tracking_prefix;
            vec2 animator_offset = vec2(
                run.animator_position_x * reveal_weight + tracking,
                run.animator_position_y * reveal_weight);
            vec2 animator_scale = vec2(
                1.0 + (run.animator_scale_x - 1.0) * reveal_weight,
                1.0 + (run.animator_scale_y - 1.0) * reveal_weight);
            vec2 scale_origin_compensation = vec2(0.0);
            if ((run.flags & 2u) != 0u) {
                // Per-glyph scale must preserve the glyph's layout origin.
                // Without this term, a glyph at x=500 acquires an unintended
                // 500*(scale-1) translation and the phrase visibly trembles.
                scale_origin_compensation = vec2(run.sx, run.sy) *
                    vec2(glyph.origin_x, glyph.origin_y) *
                    (vec2(1.0) - animator_scale);
            }
            vec2 local = (pixel_pos - vec2(run.tx, run.ty) - animator_offset -
                          scale_origin_compensation) /
                         (vec2(run.sx, run.sy) * animator_scale);
            inside = local.x >= glyph.plane_left && local.x < glyph.plane_right &&
                     local.y >= glyph.plane_top  && local.y < glyph.plane_bottom;
            if (inside) {
                glyph_uv = (local - vec2(glyph.plane_left, glyph.plane_top)) /
                           vec2(plane_w, plane_h);
                // Texel-centre space: texel i owns uv in [i, i+1)/size and is
                // centred at (i+0.5)/size, so the continuous index is
                // uv*size - 0.5.
                glyph_texel = glyph_uv * vec2(float(atlas_w), float(atlas_h)) -
                              vec2(0.5);
                sample_offset = ivec2(floor(glyph_uv *
                                             vec2(float(atlas_w), float(atlas_h))));
            }
        } else {
            // Legacy bitmap-origin placement retained for compatibility
            // callers; prepared runs opt into plane placement above.
            if (run.sx <= 0.0 || run.sy <= 0.0) continue;
            vec2 local = vec2(pixel_coord) - vec2(round(run.tx), round(run.ty));
            vec2 scaled_size = ceil(vec2(atlas_w, atlas_h) * vec2(run.sx, run.sy));
            inside = local.x >= 0.0 && local.y >= 0.0 &&
                     local.x < scaled_size.x && local.y < scaled_size.y;
            if (inside) {
                sample_offset = ivec2(floor(local / vec2(run.sx, run.sy)));
            }
        }

        if (!inside) continue;
        const ivec2 atlas_origin = ivec2(int(atlas_x), int(atlas_y));
        // The prepared path reads FRACTIONALLY; the compatibility
        // bitmap-origin path keeps its nearest read and its own clamp.
        vec4 sample_value = plane_placement
            ? atlas_tap_bilinear(atlas_origin, int(atlas_w), int(atlas_h), glyph_texel)
            : imageLoad(atlas_image, atlas_origin +
                        clamp(sample_offset, ivec2(0),
                              ivec2(int(atlas_w) - 1, int(atlas_h) - 1)));

        vec4 src;
        if (mtsdf) {
            // The prepared atlas is an MTSDF payload.  The RGB median is the
            // canonical screen-space signed-distance reconstruction used by
            // the text profile; the alpha lane is retained for diagnostics and
            // must not turn the padded glyph plane into fill.
            float msd = median3(sample_value.r, sample_value.g, sample_value.b);
            float distance_range = uintBitsToFloat(run.distance_range_bits);
            if (!(distance_range > 0.0)) distance_range = 8.0;
            float glyph_blur = max(run.animator_blur * reveal_weight, 0.0);
            float fill_alpha = clamp((msd - 0.5) * distance_range * texel_to_screen +
                                     0.5, 0.0, 1.0);
            if (glyph_blur > 0.0) {
                float softness = max(glyph_blur * local_to_screen, 1.0);
                fill_alpha = clamp(0.5 + ((msd - 0.5) * distance_range * texel_to_screen) /
                                   softness, 0.0, 1.0);
            }
            src = vec4(0.0);
            if ((run.effect_flags & 2u) != 0u ||
                (run.effect_flags & 4u) != 0u) {
                vec2 shadow_uv = glyph_uv -
                    vec2(run.shadow_dx / (glyph.plane_right - glyph.plane_left),
                         run.shadow_dy / (glyph.plane_bottom - glyph.plane_top));
                if (all(greaterThanEqual(shadow_uv, vec2(0.0))) &&
                    all(lessThan(shadow_uv, vec2(1.0)))) {
                    vec2 shadow_texel =
                        shadow_uv * vec2(float(atlas_w), float(atlas_h)) - vec2(0.5);
                    vec4 shadow_sample = atlas_tap_bilinear(
                        atlas_origin, int(atlas_w), int(atlas_h), shadow_texel);
                    // Use the same median signed-distance coverage as the
                    // fill.  The alpha lane is a useful true-distance
                    // diagnostic, but using it for the effect path makes the
                    // result depend on channel quantization/edge padding and
                    // can turn the whole glyph plane into a low-alpha shadow
                    // mask during a typewriter reveal.
                    //
                    // Build coverage from the signed glyph distance itself.
                    // Keep the soft edge below the baked distance range: the
                    // atlas intentionally clamps distances outside its
                    // padding, so asking for a wider transition would make
                    // the clamped rectangular plane contribute again.
                    float shadow_msd = median3(
                        shadow_sample.r, shadow_sample.g, shadow_sample.b);
                    float shadow_distance_px =
                        (shadow_msd - 0.5) * distance_range * texel_to_screen;
                    // The authored blur is a paint-space width, while the cap
                    // is the field's own representable softness: at most 0.48
                    // of the encoded distance range, expressed in screen pixels.
                    // Capping below 0.5 ensures that the smoothstep lower bound
                    // (-shadow_softness_px) is reached before the distance field
                    // clamp endpoint (shadow_msd = 0.0), eliminating rectangular
                    // / circular cutoff step discontinuities around glyphs.
                    float shadow_softness_px = clamp(
                        run.shadow_blur * local_to_screen,
                        0.0, max(distance_range * 0.48 * texel_to_screen, 0.0));
                    float edge_fade = smoothstep(0.01, 0.08, shadow_msd);
                    float shadow_alpha = (shadow_msd <= (1.0 / 255.0))
                        ? 0.0
                        : (shadow_softness_px > 0.0
                            ? smoothstep(-shadow_softness_px, 0.0,
                                         shadow_distance_px) * edge_fade
                            : step(0.0, shadow_distance_px));
                    vec4 glyph_shadow = unpack_color(run.shadow_color) * shadow_alpha;
                    if (glyph_shadow.a > shadow_layer.a) {
                        shadow_layer = glyph_shadow;
                    }
                }
            }
            if ((run.effect_flags & 1u) != 0u) {
                // Field distance and authored stroke width are converted from
                // their own spaces into destination pixels before they are
                // compared, instead of scaling both by one factor that can
                // only be right for one of them.
                // `stroke_width` is the authored OUTLINE width, therefore the
                // signed field is expanded by its radius, not by the full
                // diameter.  Expanding by the full width makes every padded
                // texel of the glyph plane pass the stroke test and produces
                // the opaque rectangular boxes seen around projected text.
                float stroke_alpha = clamp(
                    (msd - 0.5) * distance_range * texel_to_screen +
                    0.5 * run.stroke_width * local_to_screen + 0.5, 0.0, 1.0);
                vec4 stroke = unpack_color(run.stroke_color) * stroke_alpha;
                stroke *= run.opacity * (1.0 + (run.animator_opacity - 1.0) * reveal_weight);
                stroke_layer = stroke + stroke_layer * (1.0 - stroke.a);
            }
            vec4 fill = unpack_color(run.color) * fill_alpha;
            fill *= run.opacity * (1.0 + (run.animator_opacity - 1.0) * reveal_weight);
            fill_layer = fill + fill_layer * (1.0 - fill.a);
        } else {
            src = sample_value;
            if (run.color != 0xFFFFFFFFu && run.color != 0u) {
                src *= unpack_color(run.color);
            }
            src *= run.opacity * (1.0 + (run.animator_opacity - 1.0) * reveal_weight);
            fill_layer = src + fill_layer * (1.0 - src.a);
        }

    }

    vec4 current_color = shadow_layer + destination_color * (1.0 - shadow_layer.a);
    current_color = stroke_layer + current_color * (1.0 - stroke_layer.a);
    current_color = fill_layer + current_color * (1.0 - fill_layer.a);
    imageStore(dst_image, pixel_coord, current_color);
}
