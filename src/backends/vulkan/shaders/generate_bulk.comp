#version 450

// generate_bulk.comp — one dispatch for generator and pointwise stylize effects.
// Modes replicate the software processors tap-for-tap:
//   0 FractalNoise (procedural fBm value noise, no field),
//   1 FourColorGradient (inverse-distance weighting),
//   2 LightRays (radial integration toward origin, Transparent edges),
//   3 Halftone (rotated cellular ink dots),
//   4 LuminanceResponse without blur (radius <= 0.5 certified; larger radii
//     fail closed at lowering time),
//   5 CreaseShading (fold-crease darken/lighten multiply-add),
//   6 NoiseSampler (unified Simplex/Worley/Ridged/Value/Blue fBm sampler),
//   7 BandedGrain (multi-scale hash grain with tonal luminance response).
// All color math is premultiplied linear RGBA like the CPU reference.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;

layout(push_constant) uniform GenerateBulkParams {
    int mode;
    int flags;        // color_mode / blend / extra selector
    vec4 a0;
    vec4 a1;
    vec4 a2;
    vec4 a3;
    vec4 b0;
    vec4 b1;
    vec4 b2;
} params;

float hash_noise(int n, uint seed) {
    uint x = uint(n) + seed;
    x ^= (x << 13u);
    x ^= (x >> 17u);
    x ^= (x << 5u);
    return float(x % 10000u) / 5000.0 - 1.0;
}

float lattice_noise(int x, int y, uint seed) {
    uint index = uint(x) + uint(y) * 0x9E3779B9u;
    return hash_noise(int(index), seed);
}

float smooth_value_noise(float x, float y, uint seed) {
    int ix = int(floor(x));
    int iy = int(floor(y));
    float fx = x - float(ix);
    float fy = y - float(iy);
    float sx = fx * fx * (3.0 - 2.0 * fx);
    float sy = fy * fy * (3.0 - 2.0 * fy);
    float a = mix(lattice_noise(ix, iy, seed), lattice_noise(ix + 1, iy, seed), sx);
    float b = mix(lattice_noise(ix, iy + 1, seed), lattice_noise(ix + 1, iy + 1, seed), sx);
    return mix(a, b, sy);
}

float fractal_channel(float px, float py, uint seed, uint octaves,
                      float frequency, float contrast, float brightness, float amplitude) {
    uint oct = clamp(octaves, 1u, 16u);
    float freq = max(frequency, 0.0);
    float amp = 1.0;
    float sum = 0.0;
    float weight = 0.0;
    for (uint o = 0u; o < oct; ++o) {
        sum += smooth_value_noise(px * freq, py * freq,
                                  seed + uint(o) * 0x9E3779B9u) * amp;
        weight += amp;
        freq *= 2.0;
        amp *= 0.5;
    }
    float value = weight > 0.0 ? sum / weight : 0.0;
    value = (value * contrast + brightness) * amplitude;
    return clamp(value * 0.5 + 0.5, 0.0, 1.0);
}

// ── Unified NoiseSampler primitives (mirror noise_sampler.cpp tap-for-tap) ──
uint sq3(int position, uint seed) {
    uint mangled = uint(position);
    mangled *= 0xB5297A4Du;
    mangled += seed;
    mangled ^= (mangled >> 8u);
    mangled += 0x68E31DA4u;
    mangled ^= (mangled << 8u);
    mangled *= 0x1B56C4E9u;
    mangled ^= (mangled >> 8u);
    return mangled;
}

float ns_hash2d(int x, int y, uint seed) {
    uint n = uint(x) + uint(y) * 0x9E3779B9u;
    return float(sq3(int(n), seed) & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

float ns_value_noise(float x, float y, uint seed) {
    int ix = int(floor(x));
    int iy = int(floor(y));
    float fx = x - float(ix);
    float fy = y - float(iy);
    float sx = fx * fx * fx * (fx * (fx * 6.0 - 15.0) + 10.0);
    float sy = fy * fy * fy * (fy * (fy * 6.0 - 15.0) + 10.0);
    float a = mix(ns_hash2d(ix, iy, seed), ns_hash2d(ix + 1, iy, seed), sx);
    float b = mix(ns_hash2d(ix, iy + 1, seed), ns_hash2d(ix + 1, iy + 1, seed), sx);
    return mix(a, b, sy);
}

float ns_simplex_grad(int cx, int cy, uint seed, float px, float py) {
    uint h = sq3(int(uint(cx) + uint(cy) * 0x9E3779B9u), seed) & 7u;
    float gx = 1.0, gy = 0.0;
    if (h == 0u) { gx = 1.0; gy = 1.0; }
    else if (h == 1u) { gx = -1.0; gy = 1.0; }
    else if (h == 2u) { gx = 1.0; gy = -1.0; }
    else if (h == 3u) { gx = -1.0; gy = -1.0; }
    else if (h == 4u) { gx = 1.0; gy = 0.0; }
    else if (h == 5u) { gx = -1.0; gy = 0.0; }
    else if (h == 6u) { gx = 0.0; gy = 1.0; }
    else { gx = 0.0; gy = -1.0; }
    return gx * px + gy * py;
}

float ns_simplex_noise(float x, float y, uint seed) {
    const float F2 = 0.366025403784439;
    const float G2 = 0.211324865405187;
    float s = (x + y) * F2;
    int i = int(floor(x + s));
    int j = int(floor(y + s));
    float t = float(i + j) * G2;
    float x0 = x - (float(i) - t);
    float y0 = y - (float(j) - t);
    int i1 = 0, j1 = 0;
    if (x0 > y0) { i1 = 1; j1 = 0; } else { i1 = 0; j1 = 1; }
    float x1 = x0 - float(i1) + G2;
    float y1 = y0 - float(j1) + G2;
    float x2 = x0 - 1.0 + 2.0 * G2;
    float y2 = y0 - 1.0 + 2.0 * G2;
    float n0 = 0.0, n1 = 0.0, n2 = 0.0;
    float t0 = 0.5 - x0 * x0 - y0 * y0;
    if (t0 > 0.0) { t0 *= t0; n0 = t0 * t0 * ns_simplex_grad(i, j, seed, x0, y0); }
    float t1 = 0.5 - x1 * x1 - y1 * y1;
    if (t1 > 0.0) { t1 *= t1; n1 = t1 * t1 * ns_simplex_grad(i + i1, j + j1, seed, x1, y1); }
    float t2 = 0.5 - x2 * x2 - y2 * y2;
    if (t2 > 0.0) { t2 *= t2; n2 = t2 * t2 * ns_simplex_grad(i + 1, j + 1, seed, x2, y2); }
    return clamp((n0 + n1 + n2) * 35.0 * 0.5 + 0.5, 0.0, 1.0);
}

float ns_worley_noise(float x, float y, uint seed) {
    int ix = int(floor(x));
    int iy = int(floor(y));
    float min_dist = 2.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            int cx = ix + dx;
            int cy = iy + dy;
            float ox = ns_hash2d(cx, cy, seed);
            float oy = ns_hash2d(cx, cy, seed ^ 0x68BC21EBu);
            float px = float(cx) + ox;
            float py = float(cy) + oy;
            float ddx = x - px, ddy = y - py;
            min_dist = min(min_dist, sqrt(ddx * ddx + ddy * ddy));
        }
    }
    return clamp(min_dist, 0.0, 1.0);
}

float ns_blue_noise(float x, float y, uint seed) {
    int ix = int(floor(x));
    int iy = int(floor(y));
    float h = ns_hash2d(ix, iy, seed);
    float val = h + float(ix) * 0.7548776662466927 + float(iy) * 0.5698402909980532;
    return clamp(val - floor(val), 0.0, 1.0);
}

// std::round semantics (half away from zero); the sampler quantizes
// non-negative values, but negatives can precede the final clamp.
float ns_round_half_away(float x) {
    return sign(x) * floor(abs(x) + 0.5);
}

float ns_sample(float x, float y, int type, uint seed, uint octaves,
                float frequency, float lacunarity, float gain,
                float contrast, float brightness,
                float remap_min, float remap_max, float quantize_steps,
                float domain_warp, float drift) {
    uint combined = seed;
    float px = x + drift;
    float py = y + drift * 0.6180339887;
    if (domain_warp > 0.0) {
        float warp_scale = domain_warp * 30.0;
        float wx = ns_simplex_noise(px * 0.005 + 13.7, py * 0.005 + 4.9,
                                    combined ^ 0x51E2D3Bu) * 2.0 - 1.0;
        float wy = ns_simplex_noise(px * 0.005 + 8.1, py * 0.005 + 19.3,
                                    combined ^ 0x9A48C21u) * 2.0 - 1.0;
        px += wx * warp_scale;
        py += wy * warp_scale;
    }
    uint oct = clamp(octaves, 1u, 16u);
    float lac = (lacunarity > 0.1) ? lacunarity : 2.0;
    float gn = (gain > 0.0 && gain <= 1.0) ? gain : 0.5;
    float freq = max(frequency, 0.0001);
    float amp = 1.0;
    float sum = 0.0;
    float total_weight = 0.0;
    for (uint o = 0u; o < oct; ++o) {
        uint octave_seed = combined + o * 0x9E3779B9u;
        float samp = 0.0;
        if (type == 0) {
            samp = ns_simplex_noise(px * freq, py * freq, octave_seed);
        } else if (type == 1) {
            samp = ns_worley_noise(px * freq, py * freq, octave_seed);
        } else if (type == 2) {
            float s = ns_simplex_noise(px * freq, py * freq, octave_seed) * 2.0 - 1.0;
            float ridge = 1.0 - abs(s);
            samp = ridge * ridge;
        } else if (type == 3) {
            samp = ns_value_noise(px * freq, py * freq, octave_seed);
        } else {
            samp = ns_blue_noise(px * freq, py * freq, octave_seed);
        }
        sum += samp * amp;
        total_weight += amp;
        freq *= lac;
        amp *= gn;
    }
    float value = (total_weight > 0.0) ? (sum / total_weight) : 0.0;
    value = (value - 0.5) * contrast + 0.5 + brightness;
    if (remap_max > remap_min) {
        value = (value - remap_min) / (remap_max - remap_min);
    }
    if (quantize_steps > 0.5) {
        value = ns_round_half_away(value * quantize_steps) / quantize_steps;
    }
    return clamp(value, 0.0, 1.0);
}

// ── BandedGrain band fetch: bands pack as consecutive (scale, amplitude,
//     octave) triples across a2..b2 (see bulk case packing) ──
vec3 grain_band(int i) {
    if (i == 0) return vec3(params.a2.x, params.a2.y, params.a2.z);
    if (i == 1) return vec3(params.a2.w, params.a3.x, params.a3.y);
    if (i == 2) return vec3(params.a3.z, params.a3.w, params.b0.x);
    if (i == 3) return vec3(params.b0.y, params.b0.z, params.b0.w);
    if (i == 4) return vec3(params.b1.x, params.b1.y, params.b1.z);
    return vec3(params.b1.w, params.b2.x, params.b2.y);
}

float grain_sample(int bx, int by, uint seed) {
    uint n = uint(bx) + uint(by) * 0x9E3779B9u;
    return float(sq3(int(n), seed) & 0x00FFFFFFu) * (1.0 / 16777216.0) - 0.5;
}

vec4 fetch_transparent(ivec2 p, ivec2 size) {
    if (p.x < 0 || p.y < 0 || p.x >= size.x || p.y >= size.y) return vec4(0.0);
    return imageLoad(source_image, p);
}

vec4 sample_transparent(vec2 s, ivec2 size) {
    vec2 u = s - vec2(0.5);
    ivec2 p0 = ivec2(floor(u));
    vec2 t = u - vec2(p0);
    vec4 c00 = fetch_transparent(p0, size);
    vec4 c10 = fetch_transparent(p0 + ivec2(1, 0), size);
    vec4 c01 = fetch_transparent(p0 + ivec2(0, 1), size);
    vec4 c11 = fetch_transparent(p0 + ivec2(1, 1), size);
    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
}

void main() {
    ivec2 size = imageSize(destination_image);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    float w = float(size.x);
    float h = float(size.y);
    int mode = params.mode;

    // ── 0 FractalNoise: a0=(seed,octaves,frequency,amplitude),
    //     a1=(evolution_combined,contrast,brightness,_), flags=color_mode ──
    if (mode == 0) {
        uint seed = uint(params.a0.x + 0.5);
        uint octaves = uint(params.a0.y + 0.5);
        float frequency = params.a0.z, amplitude = params.a0.w;
        float drift = params.a1.x;
        float contrast = params.a1.y, brightness = params.a1.z;
        float px = float(pixel.x) + drift;
        float py = float(pixel.y) + drift * 0.6180339;
        if (params.flags == 1) {
            imageStore(destination_image, pixel, vec4(
                fractal_channel(px, py, seed, octaves, frequency, contrast, brightness, amplitude),
                fractal_channel(px, py, seed + 0x68BC21EBu, octaves, frequency, contrast, brightness, amplitude),
                fractal_channel(px, py, seed + 0x02E5BE93u, octaves, frequency, contrast, brightness, amplitude),
                1.0));
        } else {
            float v = fractal_channel(px, py, seed, octaves, frequency, contrast, brightness, amplitude);
            imageStore(destination_image, pixel, vec4(v, v, v, 1.0));
        }
        return;
    }

    // ── 1 FourColorGradient: a0..a3 = straight colors RGBA,
    //     b0..b1 = points (xy pairs), b2.x = blend_smoothness ────────────
    if (mode == 1) {
        float nx = (float(pixel.x) + 0.5) / w;
        float ny = (float(pixel.y) + 0.5) / h;
        float smth = params.b2.x;
        float regularizer = max(smth * smth, 1.0e-8);
        vec2 pts[4];
        pts[0] = params.b0.xy; pts[1] = params.b0.zw;
        pts[2] = params.b1.xy; pts[3] = params.b1.zw;
        vec4 cols[4];
        cols[0] = params.a0; cols[1] = params.a1;
        cols[2] = params.a2; cols[3] = params.a3;
        float weights[4];
        weights[0] = 0.0; weights[1] = 0.0; weights[2] = 0.0; weights[3] = 0.0;
        float total = 0.0;
        bool exact = false;
        int exact_i = 0;
        for (int i = 0; i < 4; ++i) {
            float dx = nx - pts[i].x;
            float dy = ny - pts[i].y;
            float d2 = dx * dx + dy * dy;
            if (d2 <= 1.0e-12) { exact = true; exact_i = i; total = 1.0; break; }
            weights[i] = 1.0 / (d2 + regularizer);
            total += weights[i];
        }
        // Host-linear blend of straight colors, then premultiply by the
        // blended alpha exactly like color::premultiply_rgb.
        if (exact) {
            vec4 c = cols[exact_i];
            imageStore(destination_image, pixel, vec4(c.rgb * c.a, c.a));
        } else {
            vec3 rgb = vec3(0.0);
            float a = 0.0;
            rgb += cols[0].rgb * (weights[0] / total);
            rgb += cols[1].rgb * (weights[1] / total);
            rgb += cols[2].rgb * (weights[2] / total);
            rgb += cols[3].rgb * (weights[3] / total);
            a += cols[0].a * (weights[0] / total);
            a += cols[1].a * (weights[1] / total);
            a += cols[2].a * (weights[2] / total);
            a += cols[3].a * (weights[3] / total);
            imageStore(destination_image, pixel, vec4(rgb * a, a));
        }
        return;
    }

    // ── 2 LightRays: a0=(origin_px), a1=(length,density,decay,_),
    //     a2=(color.rgb,ray_alpha_scale=color.a) ──────────────────────────
    if (mode == 2) {
        float origin_x = params.a0.x, origin_y = params.a0.y;
        float max_length = params.a1.x, density = params.a1.y, decay = params.a1.z;
        vec3 ray_color = params.a2.xyz;
        float color_a = params.a2.w;
        float px = float(pixel.x) + 0.5;
        float py = float(pixel.y) + 0.5;
        float dx = px - origin_x, dy = py - origin_y;
        float distance = sqrt(dx * dx + dy * dy);
        vec4 original = imageLoad(source_image, pixel);
        if (distance <= 1.0e-6 || distance > max_length) {
            imageStore(destination_image, pixel, original);
            return;
        }
        int steps = clamp(int(ceil(distance * (1.0 / 12.0))) + 1, 2, 64);
        float accumulated = 0.0;
        for (int i = 0; i < steps; ++i) {
            float t = float(i) / float(steps - 1);
            vec4 s = sample_transparent(vec2(origin_x + dx * t, origin_y + dy * t), size);
            float inv_a = s.a > 1.0e-8 ? 1.0 / s.a : 0.0;
            vec3 straight = s.rgb * inv_a;
            float luminance = max(0.0, (0.2126 * straight.r + 0.7152 * straight.g
                                        + 0.0722 * straight.b) * s.a);
            accumulated += luminance * pow(decay, (distance * t) / 8.0);
        }
        float energy = clamp(accumulated * density * 4.0 / float(steps), 0.0, 1.0);
        if (energy <= 0.0) { imageStore(destination_image, pixel, original); return; }
        float ray_alpha = energy * clamp(color_a, 0.0, 1.0);
        imageStore(destination_image, pixel, vec4(
            original.r + ray_color.r * ray_alpha,
            original.g + ray_color.g * ray_alpha,
            original.b + ray_color.b * ray_alpha,
            original.a + ray_alpha * (1.0 - original.a)));
        return;
    }

    // ── 3 Halftone: a0=(cell,cos,sin,_), a1=(amount,_,_,_) ───────────────
    if (mode == 3) {
        float cell = params.a0.x, cs = params.a0.y, sn = params.a0.z;
        float amount = params.a1.x;
        float rx = cs * float(pixel.x) + sn * float(pixel.y);
        float ry = -sn * float(pixel.x) + cs * float(pixel.y);
        float cx = (floor(rx / cell) + 0.5) * cell;
        float cy = (floor(ry / cell) + 0.5) * cell;
        ivec2 sq = ivec2(int(round(cs * cx - sn * cy)), int(round(sn * cx + cs * cy)));
        sq = clamp(sq, ivec2(0), size - ivec2(1));
        vec4 sc = imageLoad(source_image, sq);
        float luma = 1.0;
        if (sc.a > 1.0e-8) {
            luma = clamp((0.2126 * sc.r + 0.7152 * sc.g + 0.0722 * sc.b) / sc.a, 0.0, 1.0);
        }
        float radius = sqrt(max(0.0, 1.0 - luma)) * cell * 0.5 * amount;
        float dx = rx - cx, dy = ry - cy;
        float ink = (dx * dx + dy * dy < radius * radius) ? 0.0 : 1.0;
        vec4 original = imageLoad(source_image, pixel);
        imageStore(destination_image, pixel,
                   vec4(original.a * ink, original.a * ink, original.a * ink, original.a));
        return;
    }

    // ── 4 LuminanceResponse no-blur: a0=(threshold,softness,intensity,blend),
    //     a1=(tint.rgb,_) ────────────────────────────────────────────────
    if (mode == 4) {
        float thresh = params.a0.x, soft = max(params.a0.y, 1.0e-4);
        float intensity = params.a0.z;
        int blend = int(params.a0.w + 0.5);
        vec3 tint = params.a1.xyz;
        vec4 c = imageLoad(source_image, pixel);
        if (c.a <= 1.0e-5) { imageStore(destination_image, pixel, c); return; }
        float inv_a = 1.0 / c.a;
        float luma = 0.2126 * c.r * inv_a + 0.7152 * c.g * inv_a + 0.0722 * c.b * inv_a;
        vec4 d = c;
        if (luma > (thresh - soft)) {
            float t = clamp((luma - (thresh - soft)) / (soft * 2.0), 0.0, 1.0);
            float ramp = t * t * (3.0 - 2.0 * t);
            float gain = ramp * intensity;
            vec3 bcol = vec3(tint.r * gain * c.a, tint.g * gain * c.a, tint.b * gain * c.a);
            float ba = c.a * ramp;
            if (blend == 0) {
                d = vec4(clamp(c.rgb + bcol, vec3(0.0), vec3(1.0)), c.a);
            } else if (blend == 1) {
                d = vec4(clamp(c.rgb + bcol - c.rgb * bcol, vec3(0.0), vec3(1.0)), c.a);
            } else {
                float inv_ba = 1.0 - ba;
                d = vec4(bcol + c.rgb * inv_ba, ba + c.a * inv_ba);
            }
        }
        imageStore(destination_image, pixel, d);
        return;
    }

    // ── 5 CreaseShading: a0=(axis,crease_px,width_px,_),
    //     a1=(dark,light,softness,_) ─────────────────────────────────────
    if (mode == 5) {
        int axis = int(params.a0.x + 0.5);
        float crease_px = params.a0.y, width_px = params.a0.z;
        float dark_side = params.a1.x, light_side = params.a1.y, softness = params.a1.z;
        float coord = (axis == 1) ? (float(pixel.y) + 0.5) : (float(pixel.x) + 0.5);
        float dist = coord - crease_px;
        float abs_dist = abs(dist);
        vec4 c = imageLoad(source_image, pixel);
        if (abs_dist < width_px) {
            float t = abs_dist / width_px;
            float s = clamp(softness, 0.01, 1.0);
            float falloff = clamp((1.0 - t) / s, 0.0, 1.0);
            float smooth_factor = falloff * falloff * (3.0 - 2.0 * falloff);
            if (dist < 0.0) {
                float factor = 1.0 - dark_side * smooth_factor;
                c = vec4(c.rgb * factor, c.a);
            } else {
                float factor = light_side * smooth_factor * c.a;
                c = vec4(clamp(c.rgb + vec3(factor), vec3(0.0), vec3(1.0)), c.a);
            }
        }
        imageStore(destination_image, pixel, c);
        return;
    }

    // ── 6 NoiseSampler: a0=(seed,octaves,frequency,type),
    //     a1=(drift,contrast,brightness,domain_warp),
    //     a2=(remap_min,remap_max,quantize_steps,lacunarity),
    //     a3=(gain,_,_,_), flags=color_mode ─────────────────────────────
    if (mode == 6) {
        uint seed = uint(params.a0.x + 0.5);
        uint octaves = uint(params.a0.y + 0.5);
        float frequency = params.a0.z;
        int type = int(params.a0.w + 0.5);
        float drift = params.a1.x;
        float contrast = params.a1.y, brightness = params.a1.z;
        float domain_warp = params.a1.w;
        float remap_min = params.a2.x, remap_max = params.a2.y;
        float quantize_steps = params.a2.z, lacunarity = params.a2.w;
        float gain = params.a3.x;
        float px = float(pixel.x), py = float(pixel.y);
        if (params.flags == 1) {
            imageStore(destination_image, pixel, vec4(
                ns_sample(px, py, type, seed ^ 0u, octaves, frequency,
                          lacunarity, gain, contrast, brightness,
                          remap_min, remap_max, quantize_steps, domain_warp, drift),
                ns_sample(px, py, type, seed ^ 0x68BC21EBu, octaves, frequency,
                          lacunarity, gain, contrast, brightness,
                          remap_min, remap_max, quantize_steps, domain_warp, drift),
                ns_sample(px, py, type, seed ^ 0x02E5BE93u, octaves, frequency,
                          lacunarity, gain, contrast, brightness,
                          remap_min, remap_max, quantize_steps, domain_warp, drift),
                1.0));
        } else {
            float v = ns_sample(px, py, type, seed, octaves, frequency,
                                lacunarity, gain, contrast, brightness,
                                remap_min, remap_max, quantize_steps, domain_warp, drift);
            imageStore(destination_image, pixel, vec4(v, v, v, 1.0));
        }
        return;
    }

    // ── 7 BandedGrain: a0=(seed,intensity,drift,shadow_response),
    //     a1=(midtone_response,highlight_response,band_count,_),
    //     a2..b2 = band (scale,amplitude,octave) triples, flags=color_mode ──
    if (mode == 7) {
        uint seed = uint(params.a0.x + 0.5);
        float intensity = params.a0.y;
        float drift = params.a0.z;
        float shadow_resp = params.a0.w;
        float mid_resp = params.a1.x, high_resp = params.a1.y;
        int band_count = int(params.a1.z + 0.5);
        vec4 c = imageLoad(source_image, pixel);
        float luma = 0.299 * c.r + 0.587 * c.g + 0.114 * c.b;
        float shadow_w = (1.0 - luma) * shadow_resp;
        float midtone_w = (1.0 - 2.0 * abs(luma - 0.5)) * mid_resp;
        float highlight_w = luma * high_resp;
        float response = clamp((shadow_w + midtone_w + highlight_w) * 0.5, 0.0, 2.0);
        if (params.flags == 1) {
            float sum_r = 0.0, sum_g = 0.0, sum_b = 0.0;
            for (int i = 0; i < 6; ++i) {
                if (i >= band_count) break;
                vec3 bp = grain_band(i);
                float s = max(0.5, bp.x);
                int bx = int(floor((float(pixel.x) + drift) / s));
                int by = int(floor((float(pixel.y) + drift * 0.618) / s));
                uint bseed = seed + uint(bp.z + 0.5) * 0x9E3779B9u;
                sum_r += grain_sample(bx, by, bseed) * bp.y;
                sum_g += grain_sample(bx, by, bseed ^ 0x68BC21EBu) * bp.y;
                sum_b += grain_sample(bx, by, bseed ^ 0x02E5BE93u) * bp.y;
            }
            imageStore(destination_image, pixel, vec4(
                clamp(c.r + sum_r * intensity * response, 0.0, 1.0),
                clamp(c.g + sum_g * intensity * response, 0.0, 1.0),
                clamp(c.b + sum_b * intensity * response, 0.0, 1.0),
                c.a));
        } else {
            float sum = 0.0;
            for (int i = 0; i < 6; ++i) {
                if (i >= band_count) break;
                vec3 bp = grain_band(i);
                float s = max(0.5, bp.x);
                int bx = int(floor((float(pixel.x) + drift) / s));
                int by = int(floor((float(pixel.y) + drift * 0.618) / s));
                uint bseed = seed + uint(bp.z + 0.5) * 0x9E3779B9u;
                sum += grain_sample(bx, by, bseed) * bp.y;
            }
            float d = sum * intensity * response;
            imageStore(destination_image, pixel, vec4(
                clamp(c.r + d, 0.0, 1.0),
                clamp(c.g + d, 0.0, 1.0),
                clamp(c.b + d, 0.0, 1.0),
                c.a));
        }
        return;
    }

    imageStore(destination_image, pixel, imageLoad(source_image, pixel));
}
