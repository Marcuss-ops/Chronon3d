#version 450

// fill_rect.comp — GPU primitive rasterizer (fill, shapes, analytic grid).
//
// Writes RGBA into a half-open pixel rectangle of the destination storage
// image; pixels outside the rect are left untouched.  Dispatch covers the
// full destination and each invocation early-outs, matching the
// transform/composite pattern.
//
// Primitive kinds (params.shape.x):
//   0 rectangle, 1 rounded rectangle, 2 ellipse, 3 line segment,
//   4 even-odd polygon (params.vertices), 5 analytic grid background
//   (GridBackgroundShape semantics, mirrors the software
//   render_grid_background_kernel).
//
// For kind 5 the push-constant fields carry:
//   color    = grid line straight linear RGB; alpha = grid.a * opacity
//   shape    = {5, minor_step, major_every, 0}
//   line     = {offset.x, offset.y, minor_thickness, major_thickness}
//   vertices = {bg straight linear RGB, bg alpha, grid size.xy,
//               centered, ...} (flat floats)
// The kernel reproduces the software feather (0.85 px) and the
// premultiplied-over-background blend semantics exactly, so CPU and GPU
// grid backdrops stay visually identical.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D dst_image;
layout(binding = 4, std430) readonly buffer DashedPathGeometry {
    uint words[];
} dashed_path;

layout(push_constant) uniform FillRectParams {
    ivec4 rect;   // x0, y0, x1, y1 (half-open, destination pixel space)
    vec4 color;   // premultiplied RGBA to store
    // x = primitive kind: 0 rectangle, 1 rounded rectangle, 2 ellipse,
    //     3 line segment, 4 even-odd polygon, 5 analytic grid.
    // y/z = corner/ellipse radii, or line thickness, in destination pixels.
    vec4 shape;
    vec4 line;   // x0, y0, x1, y1 for primitive kind 3
    vec2 vertices[8];
} params;

// Feather width of the software grid kernel (grid_background_kernel.cpp).
const float kGridFeather = 0.85;

float grid_line_weight(float distance, float thickness) {
    float half_width = max(thickness * 0.5, 0.0);
    float edge0 = half_width + kGridFeather;
    float edge1 = half_width - kGridFeather;
    if (distance <= edge1) return 1.0;
    if (distance >= edge0) return 0.0;
    return 1.0 - (distance - edge1) / max(edge0 - edge1, 1e-6);
}

float grid_cell_distance(float value, float step) {
    if (step <= 1e-6) return 0.0;
    float cell = round(value / step) * step;
    return abs(value - cell);
}

float sd_rounded_rect(vec2 p, vec2 center, vec2 half_size, float radius) {
    vec2 q = abs(p - center) - (half_size - vec2(radius));
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
}

bool hit_rect_like(vec2 p, vec2 origin, vec2 rect_size,
                   float corner_radius, float spread) {
    if (corner_radius > 0.0) {
        if (p.x < origin.x - spread || p.x > origin.x + rect_size.x + spread ||
            p.y < origin.y - spread || p.y > origin.y + rect_size.y + spread)
            return false;
        float r = max(0.0, min(corner_radius,
                               min(rect_size.x * 0.5, rect_size.y * 0.5)));
        float expanded = r + spread;
        vec2 cornerCenter;
        bool inCorner = false;
        if (p.x < origin.x + r && p.y < origin.y + r) {
            cornerCenter = origin + vec2(r);
            inCorner = true;
        } else if (p.x > origin.x + rect_size.x - r && p.y < origin.y + r) {
            cornerCenter = origin + vec2(rect_size.x - r, r);
            inCorner = true;
        } else if (p.x < origin.x + r && p.y > origin.y + rect_size.y - r) {
            cornerCenter = origin + vec2(r, rect_size.y - r);
            inCorner = true;
        } else if (p.x > origin.x + rect_size.x - r &&
                   p.y > origin.y + rect_size.y - r) {
            cornerCenter = origin + rect_size - vec2(r);
            inCorner = true;
        }
        return !inCorner || dot(p - cornerCenter, p - cornerCenter) <= expanded * expanded;
    }
    return p.x >= origin.x - spread && p.x < origin.x + rect_size.x + spread &&
           p.y >= origin.y - spread && p.y < origin.y + rect_size.y + spread;
}

bool hit_per_corner_rect_like(vec2 p, vec2 origin, vec2 rect_size,
                              vec4 corner_radii, float spread) {
    vec2 q = p - origin;
    if (q.x < -spread || q.x > rect_size.x + spread ||
        q.y < -spread || q.y > rect_size.y + spread)
        return false;
    int corner = q.y < rect_size.y * 0.5
        ? (q.x < rect_size.x * 0.5 ? 0 : 1)
        : (q.x >= rect_size.x * 0.5 ? 2 : 3);
    float radius = max(0.0, min(corner_radii[corner],
                                min(rect_size.x, rect_size.y) * 0.5));
    if (radius <= 0.0) return true;
    bool in_corner = corner == 0 ? q.x < radius && q.y < radius :
        corner == 1 ? q.x > rect_size.x - radius && q.y < radius :
        corner == 2 ? q.x > rect_size.x - radius && q.y > rect_size.y - radius :
                      q.x < radius && q.y > rect_size.y - radius;
    if (!in_corner) return true;
    float cx = corner == 0 || corner == 3 ? radius : rect_size.x - radius;
    float cy = corner < 2 ? radius : rect_size.y - radius;
    float expanded = radius + spread;
    vec2 delta = q - vec2(cx, cy);
    return dot(delta, delta) <= expanded * expanded;
}

void main() {
    // Dispatch is restricted to the rectangle's clipped bounds.  Re-add the
    // absolute origin because gl_GlobalInvocationID is local to that region.
    ivec2 pixel = params.rect.xy + ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x < params.rect.x || pixel.x >= params.rect.z ||
        pixel.y < params.rect.y || pixel.y >= params.rect.w) return;

    vec2 p = vec2(pixel) + vec2(0.5);
    vec2 min_corner = vec2(params.rect.xy);
    vec2 max_corner = vec2(params.rect.zw);
    vec2 size = max_corner - min_corner;
    vec2 center = (min_corner + max_corner) * 0.5;

    // Pixel-center path for solid strokes on rect / rounded-rect / circle.
    // The host dispatcher limits requests to the validated transform and
    // geometry contract; unsupported cases fail closed before dispatch.
    // params.vertices[7].y == 1.0 signals a stroked primitive. Original geometry
    // local size is in vertices[0].xy, inverse transform columns in vertices
    // [1..3], authored stroke width and alignment in vertices[4].xy, stroke
    // color in params.line.
    // rect still carries the clipped dispatch rectangle. Geometry is separate
    // so a clip never deforms the corner radius.
    if (params.shape.x <= 2.5 && params.vertices[7].y > 0.5) {
        vec2 screen = vec2(pixel) + vec2(0.5);
        vec2 p = params.vertices[1] * screen.x +
                 params.vertices[2] * screen.y + params.vertices[3];
        vec2 geomMin = vec2(0.0);
        vec2 geomMax = params.vertices[0];
        vec4 strokePm = params.line; // premultiplied RGBA
        // Layer mask (params.shape.w > 0.5): binding 4 stores header
        // {origin_x, origin_y, width, height}, then one 0/1 uint per pixel.
        // Coverage is precomputed with the CPU mask cache contract (> 0.5).
        if (params.shape.w > 0.5) {
            int mask_x = int(dashed_path.words[0]);
            int mask_y = int(dashed_path.words[1]);
            int mask_width = int(dashed_path.words[2]);
            int mask_height = int(dashed_path.words[3]);
            ivec2 local_pixel = pixel - ivec2(mask_x, mask_y);
            if (local_pixel.x < 0 || local_pixel.y < 0 ||
                local_pixel.x >= mask_width || local_pixel.y >= mask_height) return;
            uint mask_index = 4u + uint(local_pixel.y) * uint(mask_width) + uint(local_pixel.x);
            if (dashed_path.words[mask_index] == 0u) return;
        }
        float w = params.vertices[4].x;
        int align = int(params.vertices[4].y + 0.5); // 0 Inside, 1 Center, 2 Outside
        w = max(w, 0.0);

        vec2 gSize = geomMax - geomMin;
        vec2 gCenter = (geomMin + geomMax) * 0.5;
        float halfWidth = 0.5 * w;
        bool isCircle = params.shape.x > 1.5;
        bool isPerCorner = params.vertices[7].x > 0.5;
        vec4 authoredRadii = vec4(params.vertices[5], params.vertices[6]);
        float radius = isCircle ? params.shape.y :
            (params.shape.x > 0.5 ? params.shape.y : 0.0);
        float outerSpread = align == 2 ? halfWidth : 0.0;
        bool fillHit = false;
        bool strokeHit = false;
        if (isCircle) {
            float dist2 = dot(p - gCenter, p - gCenter);
            fillHit = params.color.a > 0.0 && dist2 <= radius * radius;
            float outerRadius = align == 0 ? radius : radius + halfWidth;
            float innerRadius = align == 2 ? radius :
                max(0.0, radius - (align == 0 ? w : halfWidth));
            float outerR = outerRadius + outerSpread;
            strokeHit = strokePm.a > 0.0 && dist2 <= outerR * outerR &&
                        dist2 >= innerRadius * innerRadius;
        } else {
            fillHit = params.color.a > 0.0 && (isPerCorner
                ? hit_per_corner_rect_like(p, geomMin, gSize, authoredRadii, 0.0)
                : hit_rect_like(p, geomMin, gSize, radius, 0.0));
            vec2 outerOrigin = align == 0 ? geomMin : geomMin - vec2(halfWidth);
            vec2 outerSize = align == 0 ? gSize : gSize + vec2(w);
            float outerRadius = align == 0 ? radius : radius + halfWidth;
            float innerInset = align == 0 ? w : (align == 1 ? halfWidth : 0.0);
            vec2 innerOrigin = geomMin + vec2(innerInset);
            vec2 innerSize = align == 2 ? gSize : max(vec2(0.0), gSize - vec2(w));
            float innerRadius = align == 2 ? radius : max(0.0, radius - halfWidth);
            vec4 outerRadii = authoredRadii + vec4(align == 0 ? 0.0 : halfWidth);
            vec4 innerRadii = align == 2
                ? authoredRadii
                : max(vec4(0.0), authoredRadii - vec4(halfWidth));
            bool outerHit = isPerCorner
                ? hit_per_corner_rect_like(p, outerOrigin, outerSize,
                                           outerRadii, outerSpread)
                : hit_rect_like(p, outerOrigin, outerSize,
                                outerRadius, outerSpread);
            bool innerHit = isPerCorner
                ? hit_per_corner_rect_like(p, innerOrigin, innerSize,
                                           innerRadii, 0.0)
                : hit_rect_like(p, innerOrigin, innerSize,
                                innerRadius, 0.0);
            strokeHit = strokePm.a > 0.0 && outerHit && !innerHit;
        }
        vec4 source = vec4(0.0);
        if (strokeHit) {
            source = strokePm;
            if (fillHit && strokePm.a < 1.0 && params.color.a > 0.0) {
                // Software first blends the straight stroke color over the
                // straight fill color, then composites that result over the
                // premultiplied destination. Preserve that two-step contract.
                vec3 fillStraight = params.color.rgb / params.color.a;
                float pixelAlpha = strokePm.a + params.color.a * (1.0 - strokePm.a);
                vec3 pixelRgb = strokePm.rgb + fillStraight * (1.0 - strokePm.a);
                source = vec4(pixelRgb * pixelAlpha, pixelAlpha);
            }
        } else if (fillHit) {
            source = params.color;
        }
        if (source.a > 0.0) {
            vec4 destination = imageLoad(dst_image, pixel);
            imageStore(dst_image, pixel,
                       source + destination * (1.0 - source.a));
        }
        return;
    }
    if (params.shape.x > 7.5 && params.shape.x < 8.5) {
        // Dashed path rasterization. CPU computes dash intervals and uploads
        // every run to one storage buffer. A pixel uses the first covered run
        // and first covered segment, matching software's path order exactly.
        bool has_fill = params.shape.w > 0.5;
        if (has_fill) {
            bool inside = false;
            int fill_count = clamp(int(params.shape.z + 0.5), 3, 8);
            for (int i = 0, j = fill_count - 1; i < fill_count; j = i++) {
                vec2 a = params.vertices[i];
                vec2 b = params.vertices[j];
                bool crosses = ((a.y > p.y) != (b.y > p.y)) &&
                    (p.x < (b.x - a.x) * (p.y - a.y) /
                        (b.y - a.y) + a.x);
                if (crosses) inside = !inside;
            }
            if (inside) return;
        }

        float half_width = params.shape.y * 0.5;
        uint run_count = dashed_path.words[0];
        uint point_cursor = 1u + run_count;
        for (uint run = 0u; run < run_count; ++run) {
            uint point_count = dashed_path.words[1u + run];
            float coverage = 0.0;
            for (uint i = 0u; i + 1u < point_count; ++i) {
                vec2 a = vec2(uintBitsToFloat(dashed_path.words[point_cursor + i * 2u]),
                              uintBitsToFloat(dashed_path.words[point_cursor + i * 2u + 1u]));
                vec2 b = vec2(uintBitsToFloat(dashed_path.words[point_cursor + (i + 1u) * 2u]),
                              uintBitsToFloat(dashed_path.words[point_cursor + (i + 1u) * 2u + 1u]));
                vec2 delta = b - a;
                float length_squared = dot(delta, delta);
                float raw_t = length_squared > 0.000001
                    ? dot(p - a, delta) / length_squared : -1.0;
                if (raw_t < 0.0 || raw_t > 1.0) continue;
                float distance_to_axis = distance(p, a + delta * raw_t);
                coverage = clamp((half_width + 1.0 - distance_to_axis) * 0.5,
                                 0.0, 1.0);
                if (coverage > 0.0) break;
            }
            if (coverage <= 0.0) {
                for (uint i = 1u; i + 1u < point_count; ++i) {
                    uint point_word = point_cursor + i * 2u;
                    vec2 join = vec2(uintBitsToFloat(dashed_path.words[point_word]),
                                     uintBitsToFloat(dashed_path.words[point_word + 1u]));
                    float distance_to_join = distance(p, join);
                    coverage = clamp((half_width + 1.0 - distance_to_join) * 0.5,
                                     0.0, 1.0);
                    if (coverage > 0.0) break;
                }
            }
            if (coverage > 0.0) {
                vec4 source = params.color * coverage;
                vec4 destination = imageLoad(dst_image, pixel);
                imageStore(dst_image, pixel, source + destination * (1.0 - source.a));
                return;
            }
            point_cursor += point_count * 2u;
        }
        return;
    }

    if (params.shape.x > 4.5) {
        // ── Analytic grid background (software-kernel replica) ────────
        // Evaluates the same per-pixel feather weights as the CPU
        // render_grid_background_kernel and blends the selected line over
        // the background with the identical premultiplied 'over' math.
        vec3 bg_rgb = vec3(params.vertices[0].x, params.vertices[0].y,
                           params.vertices[1].x);
        float bg_alpha = params.vertices[1].y;
        float grid_size_x = params.vertices[2].x;
        float grid_size_y = params.vertices[2].y;
        bool centered = params.vertices[3].x > 0.5;
        float edge_fade = max(params.vertices[3].y, 0.0);
        float major_glow = max(params.vertices[4].x, 0.0);

        float minor_step = max(params.shape.y, 1.0);
        bool use_major = params.shape.z > 1.0 && params.line.w > 0.0;
        float major_step = minor_step * params.shape.z;

        if (grid_size_x > 0.0 && grid_size_y > 0.0) {
            float origin_x = centered ? grid_size_x * 0.5 : 0.0;
            float origin_y = centered ? grid_size_y * 0.5 : 0.0;
            // CPU kernel measures from the pixel's integer coordinate,
            // so the +0.5 pixel-center offset used by the shape kinds is
            // intentionally NOT applied here.
            float gx = float(pixel.x) - origin_x - params.line.x;
            float gy = float(pixel.y) - origin_y - params.line.y;
            if (params.shape.w > 0.5) {
                vec2 iso = vec2(0.8660254037844386 * gx + 0.5 * gy,
                                -0.5 * gx + 0.8660254037844386 * gy);
                gx = iso.x;
                gy = iso.y;
            }

            float minor_w = max(
                grid_line_weight(grid_cell_distance(gx, minor_step), params.line.z),
                grid_line_weight(grid_cell_distance(gy, minor_step), params.line.z));
            float major_w = use_major
                ? max(grid_line_weight(grid_cell_distance(gx, major_step), params.line.w),
                      grid_line_weight(grid_cell_distance(gy, major_step), params.line.w))
                : 0.0;

            float edge_weight = 1.0;
            if (edge_fade > 0.0) {
                float edge_x = smoothstep(0.0, edge_fade,
                    max(min(float(pixel.x), grid_size_x - 1.0 - float(pixel.x)), 0.0));
                float edge_y = smoothstep(0.0, edge_fade,
                    max(min(float(pixel.y), grid_size_y - 1.0 - float(pixel.y)), 0.0));
                edge_weight = edge_x * edge_y;
            }

            // params.color.a carries grid.a * opacity (minor base alpha).
            float minor_alpha = minor_w * params.color.a * edge_weight;
            float major_alpha = major_w * min(1.0, params.color.a * 4.0) * edge_weight;
            float line_alpha = max(minor_alpha, major_alpha);

            vec3 bg_premul = bg_rgb * bg_alpha;
            float glow_alpha = 0.0;
            if (major_glow > 0.0 && use_major) {
                float major_distance = min(grid_cell_distance(gx, major_step),
                                           grid_cell_distance(gy, major_step));
                float glow_ratio = major_distance / major_glow;
                glow_alpha = min(1.0, params.color.a * 4.0) * 0.35 *
                    exp(-0.5 * glow_ratio * glow_ratio) * edge_weight;
            }
            vec3 under_rgb = params.color.rgb * glow_alpha + bg_premul * (1.0 - glow_alpha);
            float under_alpha = glow_alpha + bg_alpha * (1.0 - glow_alpha);
            vec4 out_pixel;
            if (line_alpha <= 0.0) {
                out_pixel = vec4(under_rgb, under_alpha);
            } else {
                out_pixel.rgb = params.color.rgb * line_alpha +
                                under_rgb * (1.0 - line_alpha);
                out_pixel.a = line_alpha + under_alpha * (1.0 - line_alpha);
            }
            imageStore(dst_image, pixel, out_pixel);
        }
        return;
    } else if (params.shape.x > 3.5) {
        int count = clamp(int(params.shape.w), 3, 8);
        bool inside = false;
        for (int i = 0, j = count - 1; i < count; j = i++) {
            vec2 a = params.vertices[i];
            vec2 b = params.vertices[j];
            bool crosses = ((a.y > p.y) != (b.y > p.y)) &&
                (p.x < (b.x - a.x) * (p.y - a.y) /
                    (b.y - a.y) + a.x);
            if (crosses) inside = !inside;
        }
        if (!inside) return;
    } else if (params.shape.x > 2.5) {
        vec2 a = params.line.xy;
        vec2 b = params.line.zw;
        vec2 delta = b - a;
        float length_squared = dot(delta, delta);
        if (params.shape.z > 0.5) {
            float raw_t = length_squared > 0.000001
                ? dot(p - a, delta) / length_squared
                : -1.0;
            // Path strokes use butt caps. The one-pixel linear edge ramp
            // matches software segment_coverage() and blends coverage over
            // the destination instead of replacing it.
            if (raw_t < 0.0 || raw_t > 1.0) return;
            float distance_to_axis = distance(p, a + delta * raw_t);
            float half_width = params.shape.y * 0.5;
            float coverage = clamp((half_width + 1.0 - distance_to_axis) * 0.5,
                                   0.0, 1.0);
            if (coverage <= 0.0) return;
            vec4 source = params.color * coverage;
            vec4 destination = imageLoad(dst_image, pixel);
            imageStore(dst_image, pixel,
                       source + destination * (1.0 - source.a));
            return;
        }
        float t = length_squared > 0.000001
            ? clamp(dot(p - a, delta) / length_squared, 0.0, 1.0)
            : 0.0;
        if (distance(p, mix(a, b, t)) > params.shape.y * 0.5) return;
    } else if (params.shape.x > 1.5) {
        vec2 radius = max(params.shape.yz, vec2(0.001));
        vec2 normalized = (p - center) / radius;
        if (dot(normalized, normalized) > 1.0) return;
    } else if (params.shape.x > 0.5) {
        vec2 local = p - min_corner;
        float radius = local.y < size.y * 0.5
            ? (local.x < size.x * 0.5 ? params.shape.y : params.shape.z)
            : (local.x >= size.x * 0.5 ? params.shape.w : params.line.x);
        radius = min(max(radius, 0.0), min(size.x, size.y) * 0.5);
        bool in_corner = local.x < radius || local.x > size.x - radius;
        in_corner = in_corner && (local.y < radius || local.y > size.y - radius);
        if (in_corner && radius > 0.0) {
            vec2 corner_center = vec2(local.x < size.x * 0.5 ? radius : size.x - radius,
                                      local.y < size.y * 0.5 ? radius : size.y - radius);
            if (distance(local, corner_center) > radius) return;
        }
    }
    imageStore(dst_image, pixel, params.color);
}
