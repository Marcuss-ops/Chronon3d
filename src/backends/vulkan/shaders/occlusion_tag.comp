#version 450

// Native per-pixel cross-layer occlusion tag.
//
// Mirrors build_depth_aware_top() in src/render_graph/nodes/composite_node.cpp
// for device-local surfaces, where no CPU depth map exists: a layer pixel is
// rejected when a nearer surface was already composited at that pixel.
//
//   layer_depth : r = positive camera depth of this layer's covered pixels,
//                 g >= 0 marks coverage (the shared depth-stamp encoding:
//                 g is the blur radius for DOF stamps and the marker for
//                 mesh stamps; a reset writes -1). Pixels without coverage
//                 have r <= 0 and never draw.
//   frame_depth : the running accumulator, same encoding. r <= 0 (or g < 0)
//                 means "nothing composited here yet".
//   mask        : a = 1 visible / 0 occluded.
//
// When params.merge != 0 the accumulator also receives the nearest positive
// depth at each pixel. The merge is per-pixel and independent of the mask
// write, so one dispatch both masks this layer and publishes its depth for
// the layers composited after it — the same contract the CPU loop applies
// while it walks the layers.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D mask_image;
layout(binding = 1, rgba32f) uniform readonly image2D layer_depth_image;
layout(binding = 2, rgba32f) uniform image2D frame_depth_image;

layout(push_constant) uniform OcclusionTagParams {
    int merge;  // 1 = publish this layer's depth into the frame accumulator
} params;

void main() {
    ivec2 size = imageSize(mask_image);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 layer = imageLoad(layer_depth_image, pixel).rg;
    vec2 frame = imageLoad(frame_depth_image, pixel).rg;

    bool layer_present = layer.g >= 0.0 && layer.r > 0.0;
    bool frame_present = frame.g >= 0.0 && frame.r > 0.0;
    float visible = 0.0;
    if (layer_present) {
        // Match build_depth_aware_top(): a later layer within the compositor
        // epsilon remains visible (authored submission order resolves ties).
        visible = (!frame_present || layer.r <= frame.r + 1e-3) ? 1.0 : 0.0;
    }
    imageStore(mask_image, pixel, vec4(0.0, 0.0, 0.0, visible));

    if (params.merge != 0 && visible > 0.0) {
        float nearest_depth = frame_present ? min(layer.r, frame.r) : layer.r;
        imageStore(frame_depth_image, pixel, vec4(nearest_depth, 1.0, 0.0, 1.0));
    }
}
