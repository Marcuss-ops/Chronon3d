#version 450

// Native per-pixel DOF blur. The circular route mirrors
// renderer::apply_per_pixel_dof_disk() in
// include/chronon3d/backends/software/effects/per_pixel_dof.hpp:
//   - the destination pixel's radius selects a dense Gaussian kernel:
//     weight(dist, r) = exp(-4.5 * t^2), t = min(dist * (1/r), 1)
//   - r < 0 : destination has no depth -> copied unchanged
//   - r < 0.5 : destination is in focus -> copied unchanged
//   - normalize_opaque: weight is multiplied by the sampled alpha
//   - total weight <= 1e-6 keeps the centre pixel
// Neighbours are restricted to the ROI rectangle, exactly like the CPU kernel.
// vertical == 0/1 retain the legacy separable path; vertical == 2 uses the
// exact per-pixel circular gather used by native camera DoF.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform writeonly image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;
layout(binding = 2, rgba32f) uniform readonly image2D depth_image;

layout(push_constant) uniform DofBlurParams {
    int vertical;
    int roi_x0;
    int roi_y0;
    int roi_x1;
    int roi_y1;
    float max_radius;
    int normalize_opaque;
    float highlight_gain;
    int iris_blades;
} params;

float dof_weight(float dist, float radius) {
    float t = min(dist * (1.0 / radius), 1.0);
    return exp(-4.5 * t * t);
}

float dof_pair_weight(
    float dist,
    float centre_radius,
    float centre_depth,
    float neighbour_radius,
    float neighbour_depth)
{
    if (neighbour_radius < 0.0) {
        return 0.0;
    }
    if (centre_radius >= 0.0 && centre_radius < 0.5) {
        if (dist == 0.0) return 1.0;
        if (neighbour_radius >= 0.5 &&
            neighbour_depth > 0.0 &&
            centre_depth > 0.0 &&
            neighbour_depth + 1e-3 < centre_depth) {
            return dof_weight(dist, neighbour_radius);
        }
        return 0.0;
    }
    if (neighbour_radius < 0.5) {
        return dist == 0.0 ? 1.0 : 0.0;
    }
    return dof_weight(dist, neighbour_radius);
}

float disk_edge_weight(float dist, float radius) {
    if (radius < 0.5 || dist > radius + 0.5) return 0.0;
    return 1.0 - smoothstep(max(0.0, radius - 0.5), radius + 0.5, dist);
}

// Regular n-gon aperture metric in units of the authored CoC radius.
// The polygon is inscribed in the circle (vertex on +x, flat sides at the
// apothem), so `metric <= radius` is inside.
// `blades < 3` keeps the historical circular kernel. Mirrors
// renderer::dof_aperture_metric() in per_pixel_dof.hpp.
float aperture_metric(vec2 delta, int blades) {
    float euclidean = length(delta);
    if (blades < 3) return euclidean;
    const float PI = 3.14159265358979323846;
    float segment = 2.0 * PI / float(blades);
    float angle = atan(delta.y, delta.x);
    float offset = mod(angle + 0.5 * segment, segment) - 0.5 * segment;
    return euclidean * cos(offset);
}

float dof_disk_pair_weight(
    float dist, float centre_radius, float centre_depth,
    float neighbour_radius, float neighbour_depth) {
    if (neighbour_radius < 0.0) return 0.0;
    if (centre_radius >= 0.0 && centre_radius < 0.5) {
        if (dist == 0.0) return 1.0;
        if (neighbour_radius >= 0.5 && neighbour_depth > 0.0 &&
            centre_depth > 0.0 && neighbour_depth + 1e-3 < centre_depth)
            return disk_edge_weight(dist, neighbour_radius);
        return 0.0;
    }
    if (neighbour_radius < 0.5) return dist == 0.0 ? 1.0 : 0.0;
    return disk_edge_weight(dist, neighbour_radius);
}

float highlight_weight(vec4 sample_color) {
    float luminance = dot(sample_color.rgb, vec3(0.2126, 0.7152, 0.0722));
    return 1.0 + params.highlight_gain * max(luminance - 1.0, 0.0);
}

void disk_blur(ivec2 pixel) {
    vec4 centre = imageLoad(source_image, pixel);
    vec2 centre_dr = imageLoad(depth_image, pixel).rg;
    if (centre_dr.y < 0.0) {
        imageStore(destination_image, pixel, centre);
        return;
    }
    // Gather every integer pixel in the circular support. Sparse point taps
    // leave visible holes and spokes on isolated highlights, especially at
    // small CoC radii; the exact gather keeps the GPU footprint aligned with
    // the CPU oracle and produces a filled disk.
    int radius_px = int(ceil(params.max_radius));
    vec4 sum = vec4(0.0);
    float total_weight = 0.0;
    ivec2 lo = max(ivec2(params.roi_x0, params.roi_y0),
                   pixel - ivec2(radius_px));
    ivec2 hi = min(ivec2(params.roi_x1 - 1, params.roi_y1 - 1),
                   pixel + ivec2(radius_px));
    for (int y = lo.y; y <= hi.y; ++y) {
        for (int x = lo.x; x <= hi.x; ++x) {
            ivec2 sample_pixel = ivec2(x, y);
            vec2 sample_dr = imageLoad(depth_image, sample_pixel).rg;
            if (sample_dr.y < 0.0) continue;
            float distance_px = aperture_metric(vec2(sample_pixel - pixel),
                                                params.iris_blades);
            float weight = dof_disk_pair_weight(
                distance_px, centre_dr.y, centre_dr.x,
                sample_dr.y, sample_dr.x);
            if (weight <= 0.0) continue;
            vec4 sample_color = imageLoad(source_image, sample_pixel);
            if (params.normalize_opaque != 0) weight *= sample_color.a;
            weight *= highlight_weight(sample_color);
            sum += sample_color * weight;
            total_weight += weight;
        }
    }
    imageStore(destination_image, pixel,
               total_weight > 1e-6 ? sum / total_weight : centre);
}

void main() {
    ivec2 size = imageSize(destination_image);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    if (pixel.x < params.roi_x0 || pixel.x >= params.roi_x1 ||
        pixel.y < params.roi_y0 || pixel.y >= params.roi_y1) return;

    if (params.vertical == 2) {
        disk_blur(pixel);
        return;
    }

    bool is_vertical = params.vertical != 0;
    int axis_pos = is_vertical ? pixel.y : pixel.x;
    int axis_lo = is_vertical ? params.roi_y0 : params.roi_x0;
    int axis_hi = is_vertical ? params.roi_y1 : params.roi_x1;
    ivec2 step = is_vertical ? ivec2(0, 1) : ivec2(1, 0);

    vec4 centre = imageLoad(source_image, pixel);
    vec2 centre_dr = imageLoad(depth_image, pixel).rg;
    float centre_depth = centre_dr.x;
    float centre_radius = centre_dr.y;

    if (params.normalize_opaque == 0 && centre.a > 0.0 &&
        centre_radius >= 0.0 && centre_radius < 0.5) {
        imageStore(destination_image, pixel, centre);
        return;
    }

    int r = int(ceil(params.max_radius));
    int k0 = max(axis_lo, axis_pos - r);
    int k1 = min(axis_hi - 1, axis_pos + r);

    vec4 sum = vec4(0.0);
    float total_weight = 0.0;
    for (int k = k0; k <= k1; ++k) {
        ivec2 np = pixel + step * (k - axis_pos);
        vec2 neighbour_dr = imageLoad(depth_image, np).rg;
        if (neighbour_dr.y < 0.0) continue;
        vec4 s = imageLoad(source_image, np);
        float dist = abs(float(k - axis_pos));
        float kernel_w = dof_pair_weight(
            dist, centre_radius, centre_depth, neighbour_dr.y, neighbour_dr.x);
        float w = params.normalize_opaque != 0 ? kernel_w * s.a : kernel_w;
        if (w > 0.0) w *= highlight_weight(s);
        sum += s * w;
        total_weight += w;
    }

    vec4 result = centre;
    if (total_weight > 1e-6) {
        result = sum * (1.0 / total_weight);
    }
    imageStore(destination_image, pixel, result);
}
