#version 450

// ── Bloom pyramid upsample ─────────────────────────────────────────────────
// 9-tap tent filter.  With `additive != 0` the lower-resolution contribution
// is added to the existing level (the downsample chain wrote it first);
// with `additive == 0` the result replaces the destination, which is used for
// the final full-resolution bloom texture consumed by the composite pass.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba16f) uniform image2D destination_image;
layout(binding = 1, rgba16f) uniform readonly image2D source_image;

layout(push_constant) uniform BloomUpsampleParams {
    float filter_radius;
    float intensity;
    int additive;
    int padding;
} params;

vec4 sample_bilinear(vec2 uv) {
    ivec2 size = imageSize(source_image);
    vec2 coordinate = uv * vec2(size) - vec2(0.5);
    ivec2 p0 = ivec2(floor(coordinate));
    ivec2 p1 = p0 + ivec2(1);
    vec2 fraction = fract(coordinate);
    p0 = clamp(p0, ivec2(0), size - ivec2(1));
    p1 = clamp(p1, ivec2(0), size - ivec2(1));
    vec4 top = mix(imageLoad(source_image, ivec2(p0.x, p0.y)),
                   imageLoad(source_image, ivec2(p1.x, p0.y)), fraction.x);
    vec4 bottom = mix(imageLoad(source_image, ivec2(p0.x, p1.y)),
                      imageLoad(source_image, ivec2(p1.x, p1.y)), fraction.x);
    return mix(top, bottom, fraction.y);
}

void main() {
    ivec2 size = imageSize(destination_image);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 texel = 1.0 / vec2(imageSize(source_image));
    float x = params.filter_radius * texel.x;
    float y = params.filter_radius * texel.y;

    vec4 a = sample_bilinear(uv + vec2(-x,  y));
    vec4 b = sample_bilinear(uv + vec2(0.0,  y)) * 2.0;
    vec4 c = sample_bilinear(uv + vec2( x,  y));
    vec4 d = sample_bilinear(uv + vec2(-x, 0.0)) * 2.0;
    vec4 e = sample_bilinear(uv) * 4.0;
    vec4 f = sample_bilinear(uv + vec2( x, 0.0)) * 2.0;
    vec4 g = sample_bilinear(uv + vec2(-x, -y));
    vec4 h = sample_bilinear(uv + vec2(0.0, -y)) * 2.0;
    vec4 i = sample_bilinear(uv + vec2( x, -y));

    vec4 upsampled = (a + b + c + d + e + f + g + h + i) * (1.0 / 16.0);
    vec4 base = params.additive != 0
        ? imageLoad(destination_image, pixel)
        : vec4(0.0);
    vec4 result = base + upsampled * params.intensity;
    imageStore(destination_image, pixel,
               vec4(max(result.rgb, vec3(0.0)), clamp(result.a, 0.0, 1.0)));
}
