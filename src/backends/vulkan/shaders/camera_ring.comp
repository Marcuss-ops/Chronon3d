#version 450

// ---------------------------------------------------------------------------
// camera_ring.comp — Petzval field-curvature defocus.
//
// This is the GPU twin of
// src/backends/software/processors/effects/blur/camera_ring.cpp. Both consume
// the same normalized-space contract from include/chronon3d/effects/
// camera_ring.hpp:
//   delta = (uv - center) / axis_scale
//   CoC   = smoothstep(inner_radius, outer_radius, length(delta))
//   blur  = CoC * max_blur_radius (UV-width units)
//   chroma = normalize(uv - center) * CoC² * chroma_dispersion
//
// The taps are uniform (sum = 1), so the kernel preserves luminous energy.
// The sample pattern is a golden-angle spiral rotated independently for every
// pixel. A fixed Poisson disc turns a large CoC into a handful of visible
// translated copies; per-pixel rotation breaks that periodicity into smooth
// optical grain. Y offsets are multiplied by the frame aspect ratio so the
// bokeh disc is circular in pixel space. Each reconstruction sample is
// prefiltered with a 2x2 pixel sensor-integration box. Pixels inside the
// elliptical safe zone are forwarded exactly, preserving text sharpness.
// ---------------------------------------------------------------------------

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;

layout(push_constant) uniform CameraRingPush {
    vec2 center;
    vec2 axis_scale;
    float inner_radius;
    float outer_radius;
    float max_blur_radius;
    float chroma_dispersion;
    float anamorphic_stretch;
    int sample_count;
    int pad0;
    int pad1;
} params;

float interleaved_gradient_noise(vec2 pixel) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(pixel, magic.xy)));
}

vec4 sample_bilinear_clamped(vec2 uv, ivec2 size) {
    vec2 pixel = uv * vec2(size) - vec2(0.5);
    pixel = clamp(pixel, vec2(0.0), vec2(size - ivec2(1)));
    ivec2 p0 = ivec2(floor(pixel));
    vec2 t = pixel - vec2(p0);
    ivec2 p1 = min(p0 + ivec2(1), size - ivec2(1));
    vec4 c00 = imageLoad(source_image, p0);
    vec4 c10 = imageLoad(source_image, ivec2(p1.x, p0.y));
    vec4 c01 = imageLoad(source_image, ivec2(p0.x, p1.y));
    vec4 c11 = imageLoad(source_image, p1);
    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
}

vec4 sample_prefiltered_clamped(vec2 uv, ivec2 size) {
    vec2 half_texel = vec2(0.5) / vec2(size);
    return 0.25 * (sample_bilinear_clamped(uv - half_texel, size) +
                   sample_bilinear_clamped(uv + vec2(half_texel.x, -half_texel.y), size) +
                   sample_bilinear_clamped(uv + vec2(-half_texel.x, half_texel.y), size) +
                   sample_bilinear_clamped(uv + half_texel, size));
}

float ring_coc(vec2 uv) {
    vec2 delta = (uv - params.center) / max(params.axis_scale, vec2(1.0e-4));
    float radius_norm = length(delta);
    float span = max(params.outer_radius - params.inner_radius, 1.0e-6);
    float t = clamp((radius_norm - params.inner_radius) / span, 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

vec4 gather_camera_ring(vec2 uv, ivec2 pixel, ivec2 size, float coc,
                        bool prefilter, int tap_limit) {
    float aspect = float(size.x) / float(size.y);
    float radius = coc * params.max_blur_radius;
    vec2 radial = uv - params.center;
    float radial_len = length(radial);
    vec2 chroma_dir = radial_len > 1.0e-6 ? radial / radial_len : vec2(0.0);
    float chroma_amount = coc * coc * params.chroma_dispersion;
    vec2 chroma = chroma_dir * chroma_amount * vec2(1.0, aspect);

    int taps = clamp(min(params.sample_count, tap_limit), 1, 64);
    float rotation = interleaved_gradient_noise(vec2(pixel)) * 6.28318530718;
    float last_tap = max(float(taps - 1), 1.0);
    vec4 accumulated = vec4(0.0);
    for (int i = 0; i < taps; ++i) {
        float fi = float(i);
        float tap_radius = taps > 1 ? sqrt(fi / last_tap) : 0.0;
        float theta = fi * 2.399963229728653 + rotation;
        vec2 disc = vec2(cos(theta), sin(theta)) * tap_radius;
        vec2 offset = disc * vec2(radius * params.anamorphic_stretch,
                                  radius * aspect);
        vec2 base_uv = uv + offset;
        vec4 green = prefilter ? sample_prefiltered_clamped(base_uv, size)
                               : sample_bilinear_clamped(base_uv, size);
        vec4 red = prefilter ? sample_prefiltered_clamped(base_uv + chroma, size)
                             : sample_bilinear_clamped(base_uv + chroma, size);
        vec4 blue = prefilter ? sample_prefiltered_clamped(base_uv - chroma, size)
                              : sample_bilinear_clamped(base_uv - chroma, size);
        accumulated += vec4(red.r, green.g, blue.b, green.a);
    }
    return accumulated / float(taps);
}

// A 16x16 workgroup shares one gather per 4x4 (or 2x2) pixel block when the
// CoC is large. The blur is low-frequency there, so replicating the block
// centre is visually equivalent and cuts the gather count 16x. Small radii
// keep the per-pixel golden-angle gather and the 2x2 sensor prefilter; the
// safe-zone copy is always exact. All threads reach every barrier because the
// mode is uniform per workgroup.
shared vec4 tile[16][16];
shared int tile_mode;

void main() {
    ivec2 size = imageSize(destination_image);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 local = ivec2(gl_LocalInvocationID.xy);
    bool in_bounds = pixel.x < size.x && pixel.y < size.y;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    float coc = ring_coc(uv);

    if (local.x == 0 && local.y == 0) {
        vec2 group_uv =
            (vec2(gl_WorkGroupID.xy * uvec2(16u)) + vec2(8.0)) / vec2(size);
        float group_radius_px =
            ring_coc(group_uv) * params.max_blur_radius * float(size.x);
        tile_mode = group_radius_px >= 24.0 ? 16
                  : (group_radius_px >= 8.0 ? 8
                  : (group_radius_px >= 3.0 ? 4
                  : (group_radius_px >= 1.0 ? 2 : 1)));
    }
    barrier();
    int mode = tile_mode;

    if (mode == 1) {
        if (!in_bounds) return;
        if (coc <= 0.001) {
            imageStore(destination_image, pixel, imageLoad(source_image, pixel));
        } else {
            imageStore(destination_image, pixel,
                       gather_camera_ring(uv, pixel, size, coc, true, 64));
        }
        return;
    }

    int tap_limit = mode >= 16 ? 8 : (mode >= 8 ? 16 : 64);
    if (in_bounds && (local.x % mode == 0) && (local.y % mode == 0)) {
        tile[local.y][local.x] =
            gather_camera_ring(uv, pixel, size, coc, false, tap_limit);
    }
    barrier();
    if (!in_bounds) return;

    if (coc <= 0.001) {
        imageStore(destination_image, pixel, imageLoad(source_image, pixel));
        return;
    }

    ivec2 origin = ivec2(local.x - local.x % mode, local.y - local.y % mode);
    ivec2 origin_pixel = pixel - (local - origin);
    vec2 origin_uv = (vec2(origin_pixel) + vec2(0.5)) / vec2(size);
    vec4 result = ring_coc(origin_uv) > 0.001
        ? tile[origin.y][origin.x]
        : gather_camera_ring(uv, pixel, size, coc, false, tap_limit);
    imageStore(destination_image, pixel, result);
}
