#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;

layout(push_constant) uniform BloomThresholdParams {
    float threshold;
    float padding;
    vec2 dispatch_origin;
} params;

void main() {
    ivec2 pixel = ivec2(params.dispatch_origin) + ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination_image);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 source = imageLoad(source_image, pixel);
    if (source.a <= 0.0) {
        imageStore(destination_image, pixel, vec4(0.0));
        return;
    }
    float luminance = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));
    float contribution = clamp((luminance - params.threshold) /
                               max(1.0 - params.threshold, 0.001), 0.0, 1.0);
    imageStore(destination_image, pixel,
               vec4(source.rgb * contribution, source.a));
}
