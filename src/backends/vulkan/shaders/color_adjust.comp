#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;

layout(push_constant) uniform ColorAdjustParams {
    float brightness;
    float contrast;
    float tint_amount;
    float padding;
    vec4 tint;
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination_image);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec4 source = imageLoad(source_image, coord);
    if (source.a <= 0.0) {
        imageStore(destination_image, coord, source);
        return;
    }

    vec3 rgb = clamp((source.rgb + params.brightness - 0.5) * params.contrast + 0.5,
                     vec3(0.0), vec3(1.0));
    rgb = mix(rgb, params.tint.rgb, clamp(params.tint_amount, 0.0, 1.0));
    imageStore(destination_image, coord, vec4(rgb, source.a));
}
