#version 450

// lut_bulk.comp — native Curves and Lut3D via host-baked tables.
//   0 Curves: aux image 256x4 holds baked CompiledCurve tables
//     (row 0 = master, 1 = red, 2 = green, 3 = blue; absent channels baked
//     as identity y=x). The shader replicates CompiledCurve::evaluate
//     exactly, including the HDR extrapolation branches, in straight-RGB
//     domain with the alpha<=0 skip of ColorPipeline::apply.
//   1 Lut3D: aux image dim x (dim*dim) holds the red-fastest table
//     texel (ix, iz*n+iy).rgb = values[iz*n*n+iy*n+ix]; the shader
//     replicates sample_lut trilinear + domain clamp + amount lerp in
//     straight-RGB domain (matches color_pipeline.cpp).
// Certified windows: Curves any finite control set (baked on host; empty =
// identity forward without dispatch); Lut3D dim in [2,16] with complete
// values, finite domain, amount in (0,1] (amount<=0 forwards without
// dispatch). Larger Lut3D dims fail closed (upload/size bound).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;
layout(binding = 2, rgba32f) uniform readonly image2D aux_image;

layout(push_constant) uniform LutBulkParams {
    int mode;
    float amount;
    float pad0;
    float pad1;
    vec4 domain_min;      // xyz = per-channel min, w unused
    vec4 domain_max;      // xyz = per-channel max, w unused
    ivec4 meta;           // x = lut dim, y = curve flags bitmask, z/w unused
} params;

float eval_baked_curve(float x, int row, float lut0, float lut1,
                       float lut254, float lut255, bool is_identity) {
    if (x <= 0.0) {
        if (lut0 == 0.0) return x;
        float slope = (lut1 - lut0) * 255.0;
        return lut0 + x * slope;
    }
    if (x >= 1.0) {
        if (lut255 == 1.0 && is_identity) return x;
        float slope = (lut255 - lut254) * 255.0;
        return lut255 + (x - 1.0) * slope;
    }
    float fi = x * 255.0;
    int i0 = int(fi);
    int i1 = min(i0 + 1, 255);
    float t = fi - float(i0);
    float v0 = imageLoad(aux_image, ivec2(i0, row)).r;
    float v1 = imageLoad(aux_image, ivec2(i1, row)).r;
    return v0 * (1.0 - t) + v1 * t;
}

void main() {
    ivec2 size = imageSize(destination_image);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec4 c = imageLoad(source_image, pixel);
    if (c.a <= 0.0) {
        imageStore(destination_image, pixel, c);
        return;
    }
    float inv_a = 1.0 / c.a;
    vec3 srgb = c.rgb * inv_a;

    // ── 0 Curves ─────────────────────────────────────────────────────────
    if (params.mode == 0) {
        int flags = params.meta.y;
        float m0 = imageLoad(aux_image, ivec2(0, 0)).r;
        float m1 = imageLoad(aux_image, ivec2(1, 0)).r;
        float m254 = imageLoad(aux_image, ivec2(254, 0)).r;
        float m255 = imageLoad(aux_image, ivec2(255, 0)).r;
        float r0 = imageLoad(aux_image, ivec2(0, 1)).r;
        float r1 = imageLoad(aux_image, ivec2(1, 1)).r;
        float r254 = imageLoad(aux_image, ivec2(254, 1)).r;
        float r255 = imageLoad(aux_image, ivec2(255, 1)).r;
        float g0 = imageLoad(aux_image, ivec2(0, 2)).r;
        float g1 = imageLoad(aux_image, ivec2(1, 2)).r;
        float g254 = imageLoad(aux_image, ivec2(254, 2)).r;
        float g255 = imageLoad(aux_image, ivec2(255, 2)).r;
        float b0 = imageLoad(aux_image, ivec2(0, 3)).r;
        float b1 = imageLoad(aux_image, ivec2(1, 3)).r;
        float b254 = imageLoad(aux_image, ivec2(254, 3)).r;
        float b255 = imageLoad(aux_image, ivec2(255, 3)).r;
        bool has_master = (flags & 1) != 0;
        bool has_r = (flags & 2) != 0;
        bool has_g = (flags & 4) != 0;
        bool has_b = (flags & 8) != 0;
        bool id_master = (flags & 16) != 0;
        bool id_r = (flags & 32) != 0;
        bool id_g = (flags & 64) != 0;
        bool id_b = (flags & 128) != 0;
        if (has_master) {
            srgb.r = eval_baked_curve(srgb.r, 0, m0, m1, m254, m255, id_master);
            srgb.g = eval_baked_curve(srgb.g, 0, m0, m1, m254, m255, id_master);
            srgb.b = eval_baked_curve(srgb.b, 0, m0, m1, m254, m255, id_master);
        }
        if (has_r) srgb.r = eval_baked_curve(srgb.r, 1, r0, r1, r254, r255, id_r);
        if (has_g) srgb.g = eval_baked_curve(srgb.g, 2, g0, g1, g254, g255, id_g);
        if (has_b) srgb.b = eval_baked_curve(srgb.b, 3, b0, b1, b254, b255, id_b);
        imageStore(destination_image, pixel, vec4(srgb * c.a, c.a));
        return;
    }

    // ── 1 Lut3D ──────────────────────────────────────────────────────────
    int n = params.meta.x;
    vec3 dmin = params.domain_min.xyz;
    vec3 dmax = params.domain_max.xyz;
    vec3 coord = clamp((srgb - dmin) / (dmax - dmin), vec3(0.0), vec3(1.0)) * float(n - 1);
    int x0 = int(coord.x), y0 = int(coord.y), z0 = int(coord.z);
    int x1 = min(x0 + 1, n - 1), y1 = min(y0 + 1, n - 1), z1 = min(z0 + 1, n - 1);
    float tx = coord.x - float(x0), ty = coord.y - float(y0), tz = coord.z - float(z0);
    vec3 c000 = imageLoad(aux_image, ivec2(x0, z0 * n + y0)).rgb;
    vec3 c100 = imageLoad(aux_image, ivec2(x1, z0 * n + y0)).rgb;
    vec3 c010 = imageLoad(aux_image, ivec2(x0, z0 * n + y1)).rgb;
    vec3 c110 = imageLoad(aux_image, ivec2(x1, z0 * n + y1)).rgb;
    vec3 c001 = imageLoad(aux_image, ivec2(x0, z1 * n + y0)).rgb;
    vec3 c101 = imageLoad(aux_image, ivec2(x1, z1 * n + y0)).rgb;
    vec3 c011 = imageLoad(aux_image, ivec2(x0, z1 * n + y1)).rgb;
    vec3 c111 = imageLoad(aux_image, ivec2(x1, z1 * n + y1)).rgb;
    vec3 c00 = mix(c000, c100, tx);
    vec3 c10 = mix(c010, c110, tx);
    vec3 c01 = mix(c001, c101, tx);
    vec3 c11 = mix(c011, c111, tx);
    vec3 mapped = mix(mix(c00, c10, ty), mix(c01, c11, ty), tz);
    srgb = mix(srgb, mapped, params.amount);
    imageStore(destination_image, pixel, vec4(srgb * c.a, c.a));
}
