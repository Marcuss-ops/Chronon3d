#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform writeonly image2D dst_image;
layout(binding = 1, rgba32f) uniform readonly image2D src_image;

layout(push_constant) uniform AffineParams {
    vec4 source_x;
    vec4 source_y;
    float max_x;
    float max_y;
    float opacity;
    uint bilinear;
    ivec2 destination_origin;
    ivec2 dispatch_origin;
    ivec4 clip_rect;
    uint clip_enabled;
    uint padding0;
    uint padding1;
    uint padding2;
} params;

vec4 sample_nearest(vec2 source, ivec2 size) {
    ivec2 p = ivec2(floor(source));
    if (p.x < 0 || p.y < 0 || p.x >= size.x || p.y >= size.y) return vec4(0.0);
    return imageLoad(src_image, p);
}

vec4 load_transparent(ivec2 p, ivec2 size) {
    if (p.x < 0 || p.y < 0 || p.x >= size.x || p.y >= size.y) {
        return vec4(0.0);
    }
    return imageLoad(src_image, p);
}

vec4 sample_bilinear(vec2 source, ivec2 size) {
    vec2 u = source - vec2(0.5);
    ivec2 p = ivec2(floor(u));
    vec2 f = fract(u);
    return mix(mix(load_transparent(p, size),
                   load_transparent(p + ivec2(1, 0), size), f.x),
               mix(load_transparent(p + ivec2(0, 1), size),
                   load_transparent(p + ivec2(1), size), f.x), f.y);
}

void main() {
    ivec2 destination = params.dispatch_origin + ivec2(gl_GlobalInvocationID.xy);
    ivec2 destination_size = imageSize(dst_image);
    if (destination.x >= destination_size.x || destination.y >= destination_size.y) return;

    vec2 canvas = vec2(destination + params.destination_origin) + vec2(0.5);
    if (params.clip_enabled != 0u &&
        (destination.x < params.clip_rect.x || destination.y < params.clip_rect.y ||
         destination.x >= params.clip_rect.z || destination.y >= params.clip_rect.w)) return;
    vec2 source = vec2(dot(params.source_x.xyz, vec3(canvas, 1.0)),
                       dot(params.source_y.xyz, vec3(canvas, 1.0)));
    // The same kernel handles the 2.5D projective case.  Non-zero padding
    // carries the inverse-homography denominator as float bits; zero padding
    // preserves the original affine contract.
    if (params.padding2 != 0u) {
        float denominator = dot(
            vec3(uintBitsToFloat(params.padding0),
                 uintBitsToFloat(params.padding1),
                 uintBitsToFloat(params.padding2)),
            vec3(canvas, 1.0));
        if (abs(denominator) < 1e-7) return;
        source /= denominator;
    }
    vec4 value = vec4(0.0);
    if (source.x >= params.source_x.w && source.x < params.max_x &&
        source.y >= params.source_y.w && source.y < params.max_y) {
        value = params.bilinear != 0u
            ? sample_bilinear(source, imageSize(src_image))
            : sample_nearest(source, imageSize(src_image));
        value *= params.opacity;
    }
    imageStore(dst_image, destination, value);
}
