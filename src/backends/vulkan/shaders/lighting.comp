#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform writeonly image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;
// Pre-filtered light-wrap plate, cached by content and resident on the GPU.
// Binding 2 is a storage image in the shared general layout; no per-frame
// readback or re-upload of this plate is needed.
layout(binding = 2, rgba32f) uniform readonly image2D light_wrap_image;
struct PointLight {
    vec4 position_kind;
    vec4 direction_angle;
    vec4 color_radius;
    vec4 range_decay_penumbra;
};
layout(binding = 3, std430) readonly buffer PointLights {
    PointLight values[];
} point_lights;

layout(push_constant) uniform LightingParams {
    vec4 multiplier;
    vec4 normal_layer_z;
    vec4 origin_diffuse_count;
    vec4 relight_params;
    vec4 relight_specular;
    // x=strength, y=wrap width, z=wrap height, w=canvas width
    vec4 light_wrap_params;
    // x=canvas height, y=filter radius, zw reserved
    vec4 light_wrap_raster;
} params;

float sample_luminance(ivec2 coord, ivec2 size) {
    ivec2 c = clamp(coord, ivec2(0), size - ivec2(1));
    vec4 px = imageLoad(source_image, c);
    vec3 unpremul = px.a > 1e-4 ? px.rgb / px.a : vec3(0.0);
    return dot(unpremul, vec3(0.2126, 0.7152, 0.0722));
}

float sample_smooth_luminance(ivec2 coord, ivec2 size) {
    // 5-tap Gaussian pre-filter suppresses high-frequency stone grain noise.
    float c = sample_luminance(coord, size) * 4.0;
    float n = sample_luminance(coord + ivec2( 0, -1), size);
    float s = sample_luminance(coord + ivec2( 0,  1), size);
    float w = sample_luminance(coord + ivec2(-1,  0), size);
    float e = sample_luminance(coord + ivec2( 1,  0), size);
    return (c + n + s + w + e) * 0.125;
}

float sample_alpha(ivec2 coord, ivec2 size) {
    if (coord.x < 0 || coord.y < 0 || coord.x >= size.x || coord.y >= size.y) {
        return 0.0;
    }
    return imageLoad(source_image, coord).a;
}

vec3 compute_bump_normal(ivec2 coord, ivec2 size, float bump_strength) {
    // Multi-scale Scharr on pre-smoothed luminance: 1px for curls + 3px for toga folds.
    float g_fine_x = 0.0;
    float g_fine_y = 0.0;
    {
        float tl = sample_smooth_luminance(coord + ivec2(-1, -1), size);
        float tc = sample_smooth_luminance(coord + ivec2( 0, -1), size);
        float tr = sample_smooth_luminance(coord + ivec2( 1, -1), size);
        float ml = sample_smooth_luminance(coord + ivec2(-1,  0), size);
        float mr = sample_smooth_luminance(coord + ivec2( 1,  0), size);
        float bl = sample_smooth_luminance(coord + ivec2(-1,  1), size);
        float bc = sample_smooth_luminance(coord + ivec2( 0,  1), size);
        float br = sample_smooth_luminance(coord + ivec2( 1,  1), size);
        g_fine_x = (3.0 * (tr - tl) + 10.0 * (mr - ml) + 3.0 * (br - bl)) / 32.0;
        g_fine_y = (3.0 * (bl - tl) + 10.0 * (bc - tc) + 3.0 * (br - tr)) / 32.0;
    }
    float g_broad_x = 0.0;
    float g_broad_y = 0.0;
    {
        float tl = sample_smooth_luminance(coord + ivec2(-3, -3), size);
        float tc = sample_smooth_luminance(coord + ivec2( 0, -3), size);
        float tr = sample_smooth_luminance(coord + ivec2( 3, -3), size);
        float ml = sample_smooth_luminance(coord + ivec2(-3,  0), size);
        float mr = sample_smooth_luminance(coord + ivec2( 3,  0), size);
        float bl = sample_smooth_luminance(coord + ivec2(-3,  3), size);
        float bc = sample_smooth_luminance(coord + ivec2( 0,  3), size);
        float br = sample_smooth_luminance(coord + ivec2( 3,  3), size);
        g_broad_x = (3.0 * (tr - tl) + 10.0 * (mr - ml) + 3.0 * (br - bl)) / 32.0;
        g_broad_y = (3.0 * (bl - tl) + 10.0 * (bc - tc) + 3.0 * (br - tr)) / 32.0;
    }
    float gx = g_fine_x * 0.45 + g_broad_x * 0.55;
    float gy = g_fine_y * 0.45 + g_broad_y * 0.55;
    return normalize(vec3(-gx * bump_strength, gy * bump_strength, 1.0));
}

void compute_alpha_rim(ivec2 coord, ivec2 size, float a_center, float width_px,
                       out float edge_factor, out vec2 outward_dir) {
    vec2 dirs[8] = vec2[8](
        vec2( 1.0,  0.0), vec2(-1.0,  0.0), vec2( 0.0,  1.0), vec2( 0.0, -1.0),
        vec2( 0.7071,  0.7071), vec2(-0.7071,  0.7071),
        vec2( 0.7071, -0.7071), vec2(-0.7071, -0.7071)
    );
    float fracs[5] = float[5](0.12, 0.25, 0.45, 0.70, 1.00);
    float weights[5] = float[5](0.30, 0.25, 0.20, 0.15, 0.10);
    float avg_a = 0.0;
    vec2 grad = vec2(0.0);
    for (int ring = 0; ring < 5; ++ring) {
        float r = max(1.0, width_px * fracs[ring]);
        float w = weights[ring];
        for (int i = 0; i < 8; ++i) {
            ivec2 o = ivec2(round(dirs[i] * r));
            float a = sample_alpha(coord + o, size);
            avg_a += a * w;
            grad += dirs[i] * (a * w);
        }
    }
    avg_a /= 8.0;
    edge_factor = clamp((a_center - avg_a) / max(a_center, 1e-4) * 1.4, 0.0, 1.0);
    edge_factor = edge_factor * edge_factor * (3.0 - 2.0 * edge_factor);
    float glen = length(grad);
    outward_dir = glen > 1e-4 ? (-grad / glen) : vec2(0.0);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination_image);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec4 source = imageLoad(source_image, coord);
    if (source.a <= 0.0) {
        imageStore(destination_image, coord, source);
        return;
    }

    bool relight_enabled = params.relight_specular.z > 0.5;
    bool wrap_enabled = params.light_wrap_params.x > 0.0;
    float wrap_edge = 0.0;
    vec2 wrap_outward = vec2(0.0);
    if (wrap_enabled) {
        compute_alpha_rim(coord, size, source.a,
                          max(params.light_wrap_raster.y, 1.0),
                          wrap_edge, wrap_outward);
    }
    float bump_strength = params.relight_params.x;
    float rim_strength = params.relight_params.y;
    float rim_width_px = params.relight_params.z;
    float roughness = clamp(params.relight_params.w, 0.04, 1.0);
    float specular_intensity = params.relight_specular.x;
    float rim_power = max(params.relight_specular.y, 0.5);

    vec3 factor = params.multiplier.rgb;
    vec3 specular_total = vec3(0.0);
    vec3 rim_total = vec3(0.0);
    uint light_count = uint(max(params.origin_diffuse_count.w, 0.0));
    if (light_count > 0u) {
        vec3 normal = params.normal_layer_z.xyz;
        float normal_length = length(normal);
        normal = normal_length > 1e-8 ? normal / normal_length : vec3(0.0, 0.0, 1.0);
        if (relight_enabled && bump_strength > 0.0) {
            vec3 local_n = compute_bump_normal(coord, size, bump_strength);
            vec3 tangent = vec3(1.0, 0.0, 0.0);
            vec3 bitangent = vec3(0.0, 1.0, 0.0);
            if (abs(normal.z) < 0.999) {
                vec3 up = vec3(0.0, 0.0, 1.0);
                tangent = normalize(cross(up, normal));
                bitangent = cross(normal, tangent);
            }
            normal = normalize(tangent * local_n.x + bitangent * local_n.y + normal * local_n.z);
        }

        float edge_factor = 0.0;
        vec2 outward_dir = vec2(0.0);
        if (relight_enabled && rim_strength > 0.0 && rim_width_px > 0.0) {
            compute_alpha_rim(coord, size, source.a, rim_width_px, edge_factor, outward_dir);
        }

        float shininess = max(2.0 / (roughness * roughness) - 2.0, 1.0);
        vec3 position = vec3(
            params.origin_diffuse_count.x + float(coord.x) + 0.5,
            params.origin_diffuse_count.y + float(coord.y) + 0.5,
            params.normal_layer_z.w);
        vec3 total = vec3(0.0);
        for (uint index = 0u; index < light_count; ++index) {
            PointLight light = point_lights.values[index];
            int kind = int(light.position_kind.w + 0.5);
            vec3 to_light;
            float attenuation = 1.0;
            if (kind == 2) {
                vec3 axis = light.direction_angle.xyz;
                float axis_length = length(axis);
                axis = axis_length > 1e-8 ? axis / axis_length : vec3(0.0, 0.0, -1.0);
                to_light = -axis;
            } else {
                vec3 delta = light.position_kind.xyz - position;
                float distance_to_light = length(delta);
                if (light.range_decay_penumbra.x > 0.0 &&
                    distance_to_light > light.range_decay_penumbra.x) continue;
                to_light = distance_to_light > 1e-6
                    ? delta / distance_to_light : vec3(0.0, 0.0, 1.0);
                float radius = max(light.color_radius.w, 1e-6);
                int falloff_mode = int(light.range_decay_penumbra.w + 0.5);
                if (falloff_mode == 1) {
                    // AE Inverse Square Clamped: full strength inside the
                    // radius, then (radius/d)^2. `range` remains the hard
                    // cutoff checked above.
                    attenuation = distance_to_light <= radius ? 1.0 :
                        pow(radius / max(distance_to_light, 1e-6), 2.0);
                } else {
                    attenuation = 1.0 / (1.0 + pow(distance_to_light / radius,
                        max(light.range_decay_penumbra.y, 0.0)));
                }
                if (kind == 1) {
                    vec3 axis = light.direction_angle.xyz;
                    float axis_length = length(axis);
                    axis = axis_length > 1e-8 ? axis / axis_length : vec3(0.0, 0.0, -1.0);
                    float cosine_to_pixel = dot(-to_light, axis);
                    float outer = cos(light.direction_angle.w);
                    float inner = cos(light.direction_angle.w *
                        (1.0 - light.range_decay_penumbra.z));
                    float cone = 1.0;
                    if (cosine_to_pixel <= outer) cone = 0.0;
                    else if (cosine_to_pixel < inner && inner > outer) {
                        float t = (cosine_to_pixel - outer) / (inner - outer);
                        cone = t * t * (3.0 - 2.0 * t);
                    }
                    attenuation *= cone;
                }
            }
            float ndotl = max(dot(normal, to_light), 0.0);
            float k = attenuation * ndotl * params.origin_diffuse_count.z;
            total += light.color_radius.rgb * k;

            if (relight_enabled && specular_intensity > 0.0 && ndotl > 0.0) {
                vec3 half_vec = normalize(to_light + vec3(0.0, 0.0, 1.0));
                float ndoth = max(dot(normal, half_vec), 0.0);
                float unpremul_luma = dot(source.rgb / max(source.a, 1e-4),
                                          vec3(0.2126, 0.7152, 0.0722));
                float ridge_mask = 0.25 + 0.75 * pow(clamp(unpremul_luma, 0.0, 1.0), 2.8);
                float spec_power = max(shininess * 1.6, 24.0);
                float spec = pow(ndoth, spec_power) * specular_intensity *
                    attenuation * ridge_mask;
                specular_total += light.color_radius.rgb * spec;
            }
            if (relight_enabled && edge_factor > 0.0) {
                float align = (length(outward_dir) > 1e-4 && dot(to_light.xy, to_light.xy) > 1e-8)
                    ? pow(max(dot(normalize(to_light.xy), outward_dir), 0.0), 1.4)
                    : 0.0;
                float grazing = clamp(1.0 - 0.65 * max(to_light.z, 0.0), 0.15, 1.0);
                float pedestal_fade = smoothstep(0.98, 0.76,
                    float(coord.y) / float(max(size.y, 1)));
                float rim_k = attenuation * rim_strength * pow(edge_factor, rim_power) *
                    align * grazing * pedestal_fade;
                rim_total += light.color_radius.rgb * rim_k;
            }
        }
        if (relight_enabled) {
            factor = max(factor + total, vec3(0.0));
        } else {
            factor = clamp(factor + total, vec3(0.0), vec3(1.0));
        }
    }
    vec3 rgb;
    if (relight_enabled) {
        vec3 diffuse_lit = source.rgb * factor;
        // Soft-shoulder compression keeps diffuse marble/skin below bloom threshold (< 0.90)
        // so facial features stay sculpted while specular ridges and rim drive HDR bloom.
        diffuse_lit = diffuse_lit / (vec3(1.0) + diffuse_lit * 0.45);
        diffuse_lit = min(diffuse_lit, vec3(0.90) * source.a);
        rgb = max(diffuse_lit + (specular_total + rim_total) * source.a, vec3(0.0));
    } else {
        rgb = clamp(source.rgb * factor, vec3(0.0), vec3(1.0));
    }
    if (wrap_enabled && wrap_edge > 0.0) {
        ivec2 wrap_size = imageSize(light_wrap_image);
        if (wrap_size.x > 0 && wrap_size.y > 0) {
            float canvas_w = max(params.light_wrap_params.w, 1.0);
            float canvas_h = max(params.light_wrap_raster.x, 1.0);
            float canvas_x = params.origin_diffuse_count.x + float(coord.x) + 0.5;
            float canvas_y = params.origin_diffuse_count.y + float(coord.y) + 0.5;
            ivec2 wrap_coord = ivec2(
                clamp(int(canvas_x * float(wrap_size.x) / canvas_w), 0, wrap_size.x - 1),
                clamp(int(canvas_y * float(wrap_size.y) / canvas_h), 0, wrap_size.y - 1));
            vec3 background = imageLoad(light_wrap_image, wrap_coord).rgb;
            float k = wrap_edge * params.light_wrap_params.x * source.a;
            vec3 gain = max(vec3(1.0) - rgb * 0.5, vec3(0.25));
            rgb += background * k * gain;
        }
    }
    imageStore(destination_image, coord, vec4(rgb, source.a));
}
