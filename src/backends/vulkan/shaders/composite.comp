#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D dst_image;
layout(binding = 1, rgba32f) uniform readonly image2D src_image;

layout(push_constant) uniform CompositeParams {
    int blend_mode;
    float source_scale;
    vec4 tint;
    // Keep this as float data to match the explicit std140-compatible
    // offsets used by VulkanBackend::record_composite.
    vec4 clip_rect;
    ivec2 dispatch_origin;
    int premultiplied_source_over;
    int push_padding;
} params;

vec4 blend_separable(vec4 src, vec4 dst, int mode) {
    float sa = clamp(src.a, 0.0, 1.0);
    float da = clamp(dst.a, 0.0, 1.0);
    if (sa <= 0.0) return dst;
    vec3 blended;
    if (mode == 3) blended = src.rgb * dst.rgb; // software premul contract
    else if (mode == 4) blended = src.rgb + dst.rgb - src.rgb * dst.rgb;
    else blended = mix(2.0 * src.rgb * dst.rgb,
        1.0 - 2.0 * (1.0 - src.rgb) * (1.0 - dst.rgb), step(vec3(0.5), dst.rgb));
    return vec4(blended, sa + da * (1.0 - sa));
}

void main() {
    ivec2 pixel = params.dispatch_origin + ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst_image);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    if (float(pixel.x) < params.clip_rect.x || float(pixel.y) < params.clip_rect.y ||
        float(pixel.x) >= params.clip_rect.z || float(pixel.y) >= params.clip_rect.w) return;
    vec4 src;
    if (params.blend_mode == 8 && any(notEqual(imageSize(src_image), size))) {
        vec2 source_coordinate = (vec2(pixel) + vec2(0.5)) *
            vec2(imageSize(src_image)) / vec2(size);
        vec2 sample_pos = source_coordinate - vec2(0.5);
        ivec2 p0 = ivec2(floor(sample_pos));
        ivec2 p1 = p0 + ivec2(1);
        vec2 fraction = fract(sample_pos);
        ivec2 source_size = imageSize(src_image);
        p0 = clamp(p0, ivec2(0), source_size - ivec2(1));
        p1 = clamp(p1, ivec2(0), source_size - ivec2(1));
        vec4 top = mix(imageLoad(src_image, ivec2(p0.x, p0.y)),
                       imageLoad(src_image, ivec2(p1.x, p0.y)), fraction.x);
        vec4 bottom = mix(imageLoad(src_image, ivec2(p0.x, p1.y)),
                          imageLoad(src_image, ivec2(p1.x, p1.y)), fraction.x);
        src = mix(top, bottom, fraction.y);
    } else {
        src = imageLoad(src_image, pixel);
    }
    vec4 dst = imageLoad(dst_image, pixel);
    vec4 result;
    if (params.blend_mode == 2) result = src;
    else if (params.blend_mode == 9) {
        // GEL coverage encodes red-channel absorption as alpha. Recover the
        // normalized optical thickness and apply Beer-Lambert transmission
        // independently to each backdrop channel. Source RGB remains the
        // premultiplied reflected/emitted surface contribution.
        float alpha = clamp(src.a, 0.0, 1.0);
        float dst_alpha = max(clamp(dst.a, 0.0, 1.0), 1e-6);
        float backdrop_luma = dot(dst.rgb / dst_alpha,
                                  vec3(0.2126, 0.7152, 0.0722));
        // Only a genuinely bright slit (not a mid-luma floor) may wash the
        // gel toward white; below this band the documented channel-dependent
        // Beer-Lambert absorption must remain exact.
        float backlit = smoothstep(0.75, 0.95,
                                   clamp(backdrop_luma, 0.0, 1.0));
        // A bright slit behind the gel must read through the body ("or"),
        // not as an opaque cyan decal. On a backlit backdrop the gel becomes
        // more transmissive and its surface washes toward white; both terms
        // are gated by coverage, so alpha=0 leaves the backdrop untouched.
        float effective_alpha = alpha * mix(1.0, 0.55, backlit);
        float red_transmission = max(1.0 - effective_alpha, 1e-6);
        vec3 transmission = pow(vec3(red_transmission),
                               vec3(1.0, 0.4 / 1.2, 0.05 / 1.2));
        vec3 surface = mix(src.rgb, vec3(effective_alpha), 0.85 * backlit);
        float body_lift = 0.12 * backlit * effective_alpha;
        result.rgb = surface + dst.rgb * transmission + vec3(body_lift);
        result.a = effective_alpha + clamp(dst.a, 0.0, 1.0) *
            (1.0 - effective_alpha);
    }
    else if (params.blend_mode == 10) {
        // Inner glow: screen the tinted rim inside the source alpha without
        // changing that alpha. dst is the premultiplied source surface.
        float dst_alpha = clamp(dst.a, 0.0, 1.0);
        float coverage = clamp(src.a * params.source_scale, 0.0, 1.0) * dst_alpha;
        result.rgb = dst.rgb + params.tint.rgb * coverage * (dst_alpha - dst.rgb);
        result.a = dst.a;
    }
    else if (params.blend_mode == 1) result = src * params.tint * params.source_scale + dst;
    else if (params.blend_mode == 6) {
        result.rgb = dst.rgb + src.rgb * params.source_scale;
        result.a = max(dst.a, clamp(src.a * params.source_scale, 0.0, 1.0));
    }
    else if (params.blend_mode == 7) {
        vec4 weighted = src * clamp(params.source_scale, 0.0, 1.0);
        result = weighted + dst * (1.0 - clamp(weighted.a, 0.0, 1.0));
    }
    else if (params.premultiplied_source_over != 0) {
        float source_alpha = clamp(src.a, 0.0, 1.0);
        float destination_alpha = clamp(dst.a, 0.0, 1.0);
        result.rgb = src.rgb + dst.rgb * (1.0 - source_alpha);
        result.a = source_alpha + destination_alpha * (1.0 - source_alpha);
    }
    else if (params.blend_mode == 8) {
        // Glow behind the original image: original OVER blurred glow.
        float source_alpha = clamp(src.a, 0.0, 1.0);
        float destination_alpha = clamp(dst.a, 0.0, 1.0);
        result.rgb = dst.rgb + src.rgb * (1.0 - destination_alpha);
        result.a = destination_alpha + source_alpha * (1.0 - destination_alpha);
    }
    else if (params.blend_mode >= 3 && params.blend_mode <= 5)
        result = blend_separable(src, dst, params.blend_mode);
    else result = src + dst * (1.0 - src.a);
    imageStore(dst_image, pixel, result);
}
