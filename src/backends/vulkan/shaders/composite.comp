#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D dst_image;
layout(binding = 1, rgba32f) uniform readonly image2D src_image;

layout(push_constant) uniform CompositeParams {
    int blend_mode;
    float source_scale;
    vec4 tint;
    // Keep this as float data to match the explicit std140-compatible
    // offsets used by VulkanBackend::record_composite.
    vec4 clip_rect;
    ivec2 dispatch_origin;
} params;

vec4 blend_separable(vec4 src, vec4 dst, int mode) {
    float sa = clamp(src.a, 0.0, 1.0);
    float da = clamp(dst.a, 0.0, 1.0);
    if (sa <= 0.0) return dst;
    vec3 blended;
    if (mode == 3) blended = src.rgb * dst.rgb; // software premul contract
    else if (mode == 4) blended = src.rgb + dst.rgb - src.rgb * dst.rgb;
    else blended = mix(2.0 * src.rgb * dst.rgb,
        1.0 - 2.0 * (1.0 - src.rgb) * (1.0 - dst.rgb), step(vec3(0.5), dst.rgb));
    return vec4(blended, sa + da * (1.0 - sa));
}

void main() {
    ivec2 pixel = params.dispatch_origin + ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst_image);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    if (float(pixel.x) < params.clip_rect.x || float(pixel.y) < params.clip_rect.y ||
        float(pixel.x) >= params.clip_rect.z || float(pixel.y) >= params.clip_rect.w) return;
    vec4 src = imageLoad(src_image, pixel);
    vec4 dst = imageLoad(dst_image, pixel);
    vec4 result;
    if (params.blend_mode == 2) result = src;
    else if (params.blend_mode == 1) result = src * params.tint * params.source_scale + dst;
    else if (params.blend_mode == 6) {
        result.rgb = dst.rgb + src.rgb * params.source_scale;
        result.a = max(dst.a, clamp(src.a * params.source_scale, 0.0, 1.0));
    }
    else if (params.blend_mode == 7) {
        vec4 weighted = src * clamp(params.source_scale, 0.0, 1.0);
        result = weighted + dst * (1.0 - clamp(weighted.a, 0.0, 1.0));
    }
    else if (params.blend_mode == 8) {
        // Glow behind the original image: original OVER blurred glow.
        float source_alpha = clamp(src.a, 0.0, 1.0);
        float destination_alpha = clamp(dst.a, 0.0, 1.0);
        result.rgb = dst.rgb + src.rgb * (1.0 - destination_alpha);
        result.a = destination_alpha + source_alpha * (1.0 - destination_alpha);
    }
    else if (params.blend_mode >= 3 && params.blend_mode <= 5)
        result = blend_separable(src, dst, params.blend_mode);
    else result = src + dst * (1.0 - src.a);
    imageStore(dst_image, pixel, result);
}
