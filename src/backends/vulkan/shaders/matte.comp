#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D target_image;
layout(binding = 2, rgba32f) uniform readonly image2D matte_image;

layout(push_constant) uniform MatteParams {
    int use_luma;
    int inverted;
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination_image);
    if (coord.x >= size.x || coord.y >= size.y) return;
    vec4 target = imageLoad(target_image, coord);
    vec4 matte = imageLoad(matte_image, coord);
    float coverage = params.use_luma != 0
        ? dot(matte.rgb, vec3(0.2126, 0.7152, 0.0722))
        : matte.a;
    coverage = clamp(params.inverted != 0 ? 1.0 - coverage : coverage, 0.0, 1.0);
    imageStore(destination_image, coord, target * coverage);
}
