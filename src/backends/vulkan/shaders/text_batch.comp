#version 450

// Fused GPU text batch compute kernel: composites a batch of glyph quads
// directly into the destination surface in a single kernel dispatch.
// Consumes GlyphStatic[] (immutable atlas coordinates) and
// TextRunDynamic[] (per-run dynamic transform/color).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba32f) uniform image2D dst_image;
layout(binding = 1, rgba32f) uniform readonly image2D atlas_image;

// 48 bytes per glyph static entry (matching std430 layout)
struct GpuGlyphStatic {
    uint run_index;
    uint atlas_page_and_flags; // low 16: atlas_page, high 16: flags
    uint atlas_pos;            // low 16: atlas_x, high 16: atlas_y
    uint atlas_size;           // low 16: atlas_w, high 16: atlas_h
    float plane_left;
    float plane_top;
    float plane_right;
    float plane_bottom;
    uint draw_order;
    uint pad0;
    uint pad1;
    uint pad2;
};

// 32 bytes per text run dynamic entry
struct GpuTextRunDynamic {
    float tx;
    float ty;
    float sx;
    float sy;
    float opacity;
    uint color;        // packed RGBA (0xFFFFFFFF = white/identity)
    float pad0;
    float pad1;
};

layout(binding = 3, std430) buffer GlyphStaticBuffer {
    GpuGlyphStatic glyphs[];
};

layout(binding = 4, std430) buffer TextRunDynamicBuffer {
    GpuTextRunDynamic runs[];
};

layout(push_constant) uniform TextBatchParams {
    int glyph_count;
    int run_count;
    ivec2 dispatch_origin;
} params;

float median3(float a, float b, float c) {
    return max(min(a, b), min(max(a, b), c));
}

void main() {
    ivec2 pixel = params.dispatch_origin + ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst_size = imageSize(dst_image);
    if (pixel.x >= dst_size.x || pixel.y >= dst_size.y) return;

    vec4 accum = imageLoad(dst_image, pixel);

    for (int i = 0; i < params.glyph_count; ++i) {
        GpuGlyphStatic g = glyphs[i];
        GpuTextRunDynamic run = runs[g.run_index];

        float sx = (run.sx != 0.0) ? run.sx : 1.0;
        float sy = (run.sy != 0.0) ? run.sy : 1.0;

        float origin_x = run.tx + g.plane_left * sx;
        float origin_y = run.ty + g.plane_top * sy;
        float plane_w = (g.plane_right - g.plane_left) * sx;
        float plane_h = (g.plane_bottom - g.plane_top) * sy;

        uint atlas_x = g.atlas_pos & 0xFFFFu;
        uint atlas_y = (g.atlas_pos >> 16u) & 0xFFFFu;
        uint atlas_w = g.atlas_size & 0xFFFFu;
        uint atlas_h = (g.atlas_size >> 16u) & 0xFFFFu;

        if (plane_w <= 0.0) plane_w = float(atlas_w) * sx;
        if (plane_h <= 0.0) plane_h = float(atlas_h) * sy;

        if (float(pixel.x) >= origin_x && float(pixel.x) < origin_x + plane_w &&
            float(pixel.y) >= origin_y && float(pixel.y) < origin_y + plane_h) {
            
            vec2 norm = (vec2(pixel) - vec2(origin_x, origin_y)) / vec2(plane_w, plane_h);
            norm = clamp(norm, vec2(0.0), vec2(1.0));
            vec2 sample_pos = vec2(float(atlas_x), float(atlas_y)) + norm * vec2(float(atlas_w), float(atlas_h));
            ivec2 atlas_coord = ivec2(clamp(sample_pos, vec2(float(atlas_x)), vec2(float(atlas_x + atlas_w - 1u), float(atlas_y + atlas_h - 1u))));

            vec4 sample_val = imageLoad(atlas_image, atlas_coord);
            uint flags = (g.atlas_page_and_flags >> 16u) & 0xFFFFu;

            vec4 src;
            if ((flags & 1u) != 0u) {
                // MTSDF representation
                float msd = median3(sample_val.r, sample_val.g, sample_val.b);
                float sd = msd - 0.5;
                float screen_scale = 0.5 * (abs(sx) + abs(sy));
                float screen_px_range = max(1.0, 8.0 * screen_scale);
                float alpha = clamp(sd * screen_px_range + 0.5, 0.0, 1.0);
                src = vec4(alpha);
            } else {
                // Linear coverage representation
                src = sample_val;
            }

            src *= run.opacity;
            if (run.color != 0xFFFFFFFFu && run.color != 0u) {
                vec4 tint = vec4(float(run.color & 0xFFu) / 255.0,
                                 float((run.color >> 8u) & 0xFFu) / 255.0,
                                 float((run.color >> 16u) & 0xFFu) / 255.0,
                                 float((run.color >> 24u) & 0xFFu) / 255.0);
                src *= tint;
            }
            accum = src + accum * (1.0 - src.a);
        }
    }

    imageStore(dst_image, pixel, accum);
}
