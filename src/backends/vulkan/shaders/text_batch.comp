#version 450

// Fused GPU text batch compute kernel: composites a batch of glyph quads
// directly into the destination surface in a single kernel dispatch.
// Consumes GlyphStatic[] (immutable atlas coordinates) and
// TextRunDynamic[] (per-run dynamic transform/color).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba32f) uniform image2D dst_image;
layout(binding = 1, rgba32f) uniform readonly image2D atlas_image;

// 48 bytes per glyph static entry (matching std430 layout)
struct GpuGlyphStatic {
    uint run_index;
    uint atlas_page_and_flags; // low 16: atlas_page, high 16: flags
    uint atlas_pos;            // low 16: atlas_x, high 16: atlas_y
    uint atlas_size;           // low 16: atlas_w, high 16: atlas_h
    float plane_left;
    float plane_top;
    float plane_right;
    float plane_bottom;
    uint draw_order;
    uint pad0;
    uint pad1;
    uint pad2;
};

// 64 bytes per text run dynamic entry
struct GpuTextRunDynamic {
    float tx;
    float ty;
    float sx;
    float sy;
    float opacity;
    uint color;        // packed RGBA (0xFFFFFFFF = white/identity)
    uint visible_glyph_count;
    uint flags;
    uint stroke_color;
    uint shadow_color;
    uint effect_flags; // bit 0 stroke, bit 1 shadow, bit 2 glow
    uint distance_range_bits;
    float stroke_width;
    float shadow_dx;
    float shadow_dy;
    float shadow_blur;
};

layout(binding = 3, std430) buffer GlyphStaticBuffer {
    GpuGlyphStatic glyphs[];
};

layout(binding = 4, std430) buffer TextRunDynamicBuffer {
    GpuTextRunDynamic runs[];
};

layout(push_constant) uniform TextBatchParams {
    int glyph_count;
    int run_count;
    ivec2 dispatch_origin;
} params;

float median3(float a, float b, float c) {
    return max(min(a, b), min(max(a, b), c));
}

vec4 unpack_color(uint c) {
    float a = float((c >> 24u) & 0xFFu) / 255.0;
    float b = float((c >> 16u) & 0xFFu) / 255.0;
    float g = float((c >> 8u) & 0xFFu) / 255.0;
    float r = float(c & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

void main() {
    ivec2 pixel = params.dispatch_origin + ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst_size = imageSize(dst_image);
    if (pixel.x >= dst_size.x || pixel.y >= dst_size.y) return;

    vec4 accum = imageLoad(dst_image, pixel);

    for (int i = 0; i < params.glyph_count; ++i) {
        GpuGlyphStatic g = glyphs[i];
        GpuTextRunDynamic run = runs[g.run_index];
        if (run.visible_glyph_count != 0xFFFFFFFFu &&
            g.pad0 >= run.visible_glyph_count) continue;

        float sx = (run.sx != 0.0) ? run.sx : 1.0;
        float sy = (run.sy != 0.0) ? run.sy : 1.0;

        uint atlas_x = g.atlas_pos & 0xFFFFu;
        uint atlas_y = (g.atlas_pos >> 16u) & 0xFFFFu;
        uint atlas_w = g.atlas_size & 0xFFFFu;
        uint atlas_h = (g.atlas_size >> 16u) & 0xFFFFu;

        uint flags = (g.atlas_page_and_flags >> 16u) & 0xFFFFu;
        float plane_w = g.plane_right - g.plane_left;
        float plane_h = g.plane_bottom - g.plane_top;
        // The compatibility text_run_surface path supplies bitmap origins in
        // run.tx/run.ty and has zero plane offsets.  Preserve its exact pixel
        // contract for ordinary premultiplied RGBA atlases. MTSDF glyphs use
        // the shaped plane rectangle, which is the only representation that
        // requires the semantic plane mapping.
        vec2 uv;
        bool inside = false;
        if ((flags & 1u) != 0u || (run.flags & 1u) != 0u) {
            vec2 local = (vec2(pixel) + vec2(0.5) - vec2(run.tx, run.ty)) /
                vec2(sx, sy);
            inside = local.x >= g.plane_left && local.y >= g.plane_top &&
                local.x < g.plane_right && local.y < g.plane_bottom &&
                plane_w > 0.0 && plane_h > 0.0;
            uv = (local - vec2(g.plane_left, g.plane_top)) /
                vec2(plane_w, plane_h);
        } else {
            vec2 local = vec2(pixel) - vec2(round(run.tx), round(run.ty));
            vec2 scaled_size = ceil(vec2(atlas_w, atlas_h) * vec2(sx, sy));
            inside = local.x >= 0.0 && local.y >= 0.0 &&
                local.x < scaled_size.x && local.y < scaled_size.y;
            uv = local / vec2(sx, sy) / vec2(atlas_w, atlas_h);
        }
        if (inside && atlas_w > 0u && atlas_h > 0u) {
            ivec2 sample_offset = ivec2(floor(uv * vec2(atlas_w, atlas_h)));
            sample_offset = clamp(sample_offset, ivec2(0),
                                  ivec2(atlas_w, atlas_h) - ivec2(1));
            ivec2 atlas_coord = ivec2(atlas_x, atlas_y) + sample_offset;

            vec4 sample_val = imageLoad(atlas_image, atlas_coord);
            vec4 src;
            if ((flags & 1u) != 0u) {
                // MTSDF representation
                float msd = median3(sample_val.r, sample_val.g, sample_val.b);
                float screen_scale = 0.5 * (abs(sx) + abs(sy));
                float distance_range = uintBitsToFloat(run.distance_range_bits);
                if (!(distance_range > 0.0)) distance_range = 8.0;
                float fill_alpha = clamp((msd - 0.5) * distance_range * screen_scale +
                                         0.5, 0.0, 1.0);
                src = vec4(0.0);

                if ((run.effect_flags & 2u) != 0u ||
                    (run.effect_flags & 4u) != 0u) {
                    vec2 shadow_uv = uv - vec2(run.shadow_dx / plane_w,
                                               run.shadow_dy / plane_h);
                    if (all(greaterThanEqual(shadow_uv, vec2(0.0))) &&
                        all(lessThan(shadow_uv, vec2(1.0)))) {
                        ivec2 shadow_offset = ivec2(floor(
                            shadow_uv * vec2(atlas_w, atlas_h)));
                        shadow_offset = clamp(shadow_offset, ivec2(0),
                                              ivec2(atlas_w, atlas_h) - ivec2(1));
                        vec4 shadow_sample = imageLoad(
                            atlas_image, ivec2(atlas_x, atlas_y) + shadow_offset);
                        float shadow_distance = (shadow_sample.a - 0.5) * distance_range;
                    float shadow_alpha = clamp(
                        0.5 + shadow_distance /
                            max(run.shadow_blur, 1.0), 0.0, 1.0);
                        src = unpack_color(run.shadow_color) * shadow_alpha;
                    }
                }
                if ((run.effect_flags & 1u) != 0u) {
                    float stroke_alpha = clamp(
                        ((sample_val.a - 0.5) * distance_range + run.stroke_width) *
                        screen_scale + 0.5, 0.0, 1.0);
                    vec4 stroke = unpack_color(run.stroke_color) * stroke_alpha;
                    src = stroke + src * (1.0 - stroke.a);
                }
                vec4 fill = unpack_color(run.color) * fill_alpha;
                src = fill + src * (1.0 - fill.a);
            } else {
                // Linear coverage representation
                src = sample_val;
            }

            src *= run.opacity;
            if (run.color != 0xFFFFFFFFu && run.color != 0u) {
                vec4 tint = vec4(float(run.color & 0xFFu) / 255.0,
                                 float((run.color >> 8u) & 0xFFu) / 255.0,
                                 float((run.color >> 16u) & 0xFFu) / 255.0,
                                 float((run.color >> 24u) & 0xFFu) / 255.0);
                src *= tint;
            }
            accum = src + accum * (1.0 - src.a);
        }
    }

    imageStore(dst_image, pixel, accum);
}
