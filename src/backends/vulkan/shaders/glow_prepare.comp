#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;

layout(push_constant) uniform GlowPrepareParams {
    vec4 tint;
    float intensity;
    vec3 padding;
} params;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination_image);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec4 source = imageLoad(source_image, pixel);
    float amount = clamp(source.a, 0.0, 1.0) * params.intensity;
    imageStore(destination_image, pixel, params.tint * amount);
}
