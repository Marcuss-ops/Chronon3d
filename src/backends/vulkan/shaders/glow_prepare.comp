#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(binding = 0, rgba32f) uniform image2D destination_image;
layout(binding = 1, rgba32f) uniform readonly image2D source_image;

layout(push_constant) uniform GlowPrepareParams {
    vec4 color_a;
    vec4 color_b;
    float threshold;
    float intensity;
    vec2 padding;
} params;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(destination_image);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    ivec2 source_size = imageSize(source_image);
    ivec2 begin = pixel * source_size / size;
    ivec2 end = (pixel + ivec2(1)) * source_size / size;
    vec4 source = vec4(0.0);
    float sample_count = 0.0;
    for (int y = begin.y; y < end.y; ++y) {
        for (int x = begin.x; x < end.x; ++x) {
            source += imageLoad(source_image, ivec2(x, y));
            sample_count += 1.0;
        }
    }
    source /= max(sample_count, 1.0);

    float alpha = clamp(source.a, 0.0, 1.0);
    float trigger = alpha;
    if (params.threshold > 0.0) {
        trigger = clamp((alpha - params.threshold) /
                        max(1.0 - params.threshold, 1.0e-6), 0.0, 1.0);
    }
    vec4 color = mix(params.color_a, params.color_b, trigger);
    float amount = trigger * params.intensity;
    imageStore(destination_image, pixel, color * amount);
}
