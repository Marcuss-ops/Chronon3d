#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GpuGlyphStatic {
    uint run_index;
    uint atlas_page_and_flags;
    uint atlas_pos;
    uint atlas_size;
    float plane_left;
    float plane_top;
    float plane_right;
    float plane_bottom;
    uint draw_order;
    uint pad0;
    float origin_x;
    float origin_y;
};

struct GpuTextRunDynamic {
    float tx;
    float ty;
    float sx;
    float sy;
    float opacity;
    uint color;
    uint visible_glyph_count;
    uint flags;
    uint stroke_color;
    uint shadow_color;
    uint effect_flags;
    uint distance_range_bits;
    float stroke_width;
    float shadow_dx;
    float shadow_dy;
    float shadow_blur;
    float selector_start;
    float selector_end;
    float selector_amount;
    float animator_tracking;
    float animator_position_x;
    float animator_position_y;
    float animator_blur;
    uint selector_unit_count;
    float animator_opacity;
    float animator_scale_x;
    float animator_scale_y;
    float animator_rotation_z;
    uint animator_fill_color;
    uint animator_reserved3;
    uint animator_reserved4;
    uint animator_reserved5;
};

layout(std430, binding = 0) readonly buffer GlyphBuffer {
    GpuGlyphStatic glyphs[];
};

layout(std430, binding = 1) readonly buffer RunBuffer {
    GpuTextRunDynamic runs[];
};

// Output: tile_count_grid and tile_glyph_indices (flattened
// max_glyphs_per_tile * num_tiles).
layout(std430, binding = 2) buffer TileCounters {
    uint tile_glyph_counts[];
};

layout(std430, binding = 3) buffer TileGlyphIndices {
    uint tile_glyph_indices[];
};

layout(push_constant) uniform PushConstants {
    uint glyph_count;
    uint tiles_x;
    uint tiles_y;
    uint max_glyphs_per_tile;
    uint dst_width;
    uint dst_height;
} params;

void main() {
    const uint kOverflowBit = 0x80000000u;
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= params.glyph_count) return;

    GpuGlyphStatic g = glyphs[gid];
    GpuTextRunDynamic r = runs[g.run_index];
    if (r.visible_glyph_count != 0xFFFFFFFFu &&
        g.pad0 >= r.visible_glyph_count) return;
    uint flags = (g.atlas_page_and_flags >> 16u) & 0xFFFFu;

    float x0;
    float y0;
    float x1;
    float y1;

    if ((flags & 1u) != 0u || (r.flags & 1u) != 0u) {
        // Distance-field glyphs use shaped plane geometry.
        // The dynamic animator can move a glyph and add cumulative tracking.
        // Use a conservative envelope here; raster computes the exact
        // per-glyph offset. This avoids dropping a tile contributor.
        float extent_x = abs(r.animator_tracking) * float(r.selector_unit_count) +
                         abs(r.animator_position_x);
        float extent_y = abs(r.animator_tracking) * float(r.selector_unit_count) +
                         abs(r.animator_position_y);
        // Cover both contracts: run-level scale is around the run origin,
        // while per-glyph scale is compensated around origin_x/origin_y in
        // the raster shader.  This is conservative and prevents animated ink
        // from disappearing at a tile boundary.
        float scale_dx = abs(r.animator_scale_x - 1.0);
        float scale_dy = abs(r.animator_scale_y - 1.0);
        extent_x += abs(r.sx) * scale_dx * max(
            max(abs(g.plane_left), abs(g.plane_right)),
            max(abs(g.plane_left - g.origin_x), abs(g.plane_right - g.origin_x)));
        extent_y += abs(r.sy) * scale_dy * max(
            max(abs(g.plane_top), abs(g.plane_bottom)),
            max(abs(g.plane_top - g.origin_y), abs(g.plane_bottom - g.origin_y)));
        // Per-glyph in-plane rotation: conservative envelope. Any rotation
        // angle keeps every plane point within the largest corner radius
        // around the glyph layout origin, so pad by that radius rather than
        // dropping a tile contributor (raster computes exact coverage).
        if (r.animator_rotation_z != 0.0) {
            vec2 pivot = vec2(g.origin_x, g.origin_y);
            float rad = max(
                max(length(vec2(g.plane_left,  g.plane_top)    - pivot),
                    length(vec2(g.plane_right, g.plane_top)    - pivot)),
                max(length(vec2(g.plane_left,  g.plane_bottom) - pivot),
                    length(vec2(g.plane_right, g.plane_bottom) - pivot)));
            extent_x += rad;
            extent_y += rad;
        }
        x0 = r.tx + g.plane_left * r.sx - extent_x;
        y0 = r.ty + g.plane_top * r.sy - extent_y;
        x1 = r.tx + g.plane_right * r.sx + extent_x;
        y1 = r.ty + g.plane_bottom * r.sy + extent_y;
    } else {
        if (r.sx <= 0.0 || r.sy <= 0.0) return;
        uint atlas_w = g.atlas_size & 0xFFFFu;
        uint atlas_h = (g.atlas_size >> 16u) & 0xFFFFu;
        x0 = round(r.tx);
        y0 = round(r.ty);
        x1 = x0 + ceil(float(atlas_w) * r.sx);
        y1 = y0 + ceil(float(atlas_h) * r.sy);
    }

    float min_x = min(x0, x1);
    float max_x = max(x0, x1);
    float min_y = min(y0, y1);
    float max_y = max(y0, y1);

    if (max_x < 0.0 || min_x >= float(params.dst_width) ||
        max_y < 0.0 || min_y >= float(params.dst_height)) {
        return;
    }

    int tile_min_x = clamp(int(floor(min_x / 16.0)), 0, int(params.tiles_x) - 1);
    int tile_max_x = clamp(int(floor(max_x / 16.0)), 0, int(params.tiles_x) - 1);
    int tile_min_y = clamp(int(floor(min_y / 16.0)), 0, int(params.tiles_y) - 1);
    int tile_max_y = clamp(int(floor(max_y / 16.0)), 0, int(params.tiles_y) - 1);

    for (int ty = tile_min_y; ty <= tile_max_y; ++ty) {
        for (int tx = tile_min_x; tx <= tile_max_x; ++tx) {
            uint tile_idx = uint(ty * int(params.tiles_x) + tx);
            uint slot = atomicAdd(tile_glyph_counts[tile_idx], 1);
            if (slot < params.max_glyphs_per_tile) {
                tile_glyph_indices[tile_idx * params.max_glyphs_per_tile + slot] = gid;
            } else {
                // The count buffer doubles as the certification flag. The
                // raster pass drops the complete tile when this bit is set,
                // so an overfull tile can never silently render a truncated
                // contributor list.
                atomicOr(tile_glyph_counts[tile_idx], kOverflowBit);
            }
        }
    }
}
