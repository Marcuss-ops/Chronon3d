tmp/
temp/
.tmp/
*.tmp
*.bak
*.orig
*.rej
generated/

# Local libabigail XML baseline. CI rebuilds the pinned baseline commit instead.
tools/sdk/chronon3d_c.abi

# ── vcpkg / third-party ────────────────────────────────────────────────────────
vcpkg_installed/
downloads/
tools/vcpkg/
third_party/build/
third_party/install/

# ── Bazel (if used by tooling) ─────────────────────────────────────────────────
bazel-*

# ── Local build caches / artifacts ──
.ccache/
vcpkg_bootstrap
test_renders/
reports/
# NOTE: bench/baselines/ is NOT ignored — official benchmark baselines
# (bench/baselines/main-<sha>-bench.json) are committed per docs/CHRONON_PLAN.md
# Fase 0. Raw benchmark run output stays out of the repo:
bench/results/
bench/raw/

# Python bytecode
__pycache__/
*.pyc
