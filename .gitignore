# ── Test fixtures (bootstrap-only policy) ────────────────────────────────────
# Everything under assets/ is checksum-pinned by tools/bootstrap_test_fonts.py
# (blob SHA-1, snapshot a31b1627). Fixture binaries are intentionally untracked:
# the script materializes them network-free from the local git object store,
# falling back to the pinned GitHub snapshot. Media patterns below must not
# re-expose them, hence assets/ is ignored wholesale and never negated.
assets/
# Source helpers under src/assets/ are code, not test fixtures.
!src/assets/
!src/assets/sha256.hpp

# ── IDE / Editor ───────────────────────────────────────────────────────────────
.idea/
.vscode/
.vs/
*.swp
*.swo
*~

# ── CMake / build output ───────────────────────────────────────────────────────
build/
build-*/
cmake-build-*/
out/
dist/
# `cmake --install ... --prefix sdk-dist` (CI Gate 4 / install-consumer) writes a
# multi-GB SDK prefix here; it is a build artifact, never a source tree.
sdk-dist/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
CMakeDoxyfile.in
CMakeDoxygenDefaults.cmake
Testing/

# ── Binaries / libraries ──────────────────────────────────────────────────────
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.dll.a
*.exe
*.out
*.app
*.pdb
*.idb
*.ilk

# ── C++ coverage ───────────────────────────────────────────────────────────────
*.gcda
*.gcno
*.gcov
coverage/
lcov.info

# ── clang / tooling ────────────────────────────────────────────────────────────
compile_commands.json
.clangd/
.cache/
.mlcache/

